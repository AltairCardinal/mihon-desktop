{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mihon-feedback",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mihon-feedback",
      "database_id": "775671ab-5a96-445a-9f65-44f7f5daa8cf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://mihon-feedback.mihon-altaircardinal.workers.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFYKLk0O1904msiU"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false }
}
