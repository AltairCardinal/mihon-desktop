{
  "manifest_version": 3,
  "name": "Mihon Cookie Helper",
  "description": "Copies the cf_clearance value for the current site only when you ask.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "cookies"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mihon Cookie Helper"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cookie-helper@desktop.mihon.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
