"CREATE TRIGGER author_archive_manga_links_update_revision\nAFTER UPDATE OF creator_id, role, creator_order, origin, source_text, confidence, evidence ON author_archive_manga_links\nWHEN old.creator_id != new.creator_id OR old.role != new.role OR old.creator_order != new.creator_order OR\n     old.origin != new.origin OR old.source_text IS NOT new.source_text OR old.confidence != new.confidence OR\n     old.evidence != new.evidence\nBEGIN\n    UPDATE author_archive_creators SET identity_revision = identity_revision + 1\n    WHERE _id IN (old.creator_id, new.creator_id);\nEND"
