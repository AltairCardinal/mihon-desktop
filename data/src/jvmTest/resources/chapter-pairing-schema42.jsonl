"CREATE TRIGGER author_archive_source_work_first_seen_defaults\nAFTER INSERT ON author_archive_source_works\nWHEN new.first_seen_at > 0 AND length(trim(new.first_seen_date)) = 0\nBEGIN\n    UPDATE author_archive_source_works\n    SET first_seen_date = strftime('%Y-%m-%d', new.first_seen_at / 1000, 'unixepoch'),\n        first_seen_zone = CASE\n            WHEN length(trim(new.first_seen_zone)) = 0 THEN 'UTC'\n            ELSE new.first_seen_zone\n        END\n    WHERE _id = new._id;\nEND"
