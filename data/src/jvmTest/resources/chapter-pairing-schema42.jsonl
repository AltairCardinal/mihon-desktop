"CREATE TABLE author_archive_creators(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    portable_key TEXT NOT NULL UNIQUE,\n    display_name TEXT NOT NULL,\n    normalized_name TEXT NOT NULL,\n    sort_name TEXT,\n    status TEXT NOT NULL CHECK(status IN ('ACTIVE', 'MERGED', 'DELETED')),\n    merged_into_creator_id INTEGER,\n    needs_review INTEGER NOT NULL DEFAULT 0,\n    identity_revision INTEGER NOT NULL DEFAULT 0,\n    legacy_creator_id INTEGER UNIQUE,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL,\n    FOREIGN KEY(merged_into_creator_id) REFERENCES author_archive_creators(_id) ON DELETE RESTRICT,\n    CHECK(\n        (status = 'MERGED' AND merged_into_creator_id IS NOT NULL) OR\n        (status IN ('ACTIVE', 'DELETED') AND merged_into_creator_id IS NULL)\n    )\n)"
"CREATE TABLE author_archive_representative_work_cache(\n    creator_id INTEGER NOT NULL PRIMARY KEY,\n    strategy_version INTEGER NOT NULL,\n    payload TEXT NOT NULL CHECK(length(payload) <= 8192),\n    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_presentation_exclusions(\n    creator_id INTEGER NOT NULL,\n    source_work_id INTEGER NOT NULL,\n    created_at INTEGER NOT NULL,\n    PRIMARY KEY(creator_id, source_work_id),\n    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE,\n    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_source_date_quality(\n    extension_package TEXT NOT NULL,\n    extension_version TEXT NOT NULL,\n    source_id INTEGER NOT NULL,\n    field_kind TEXT NOT NULL CHECK(field_kind IN ('WORK_PUBLISHED', 'CHAPTER_UPDATED')),\n    status TEXT NOT NULL CHECK(status IN ('UNKNOWN', 'TRUSTED', 'SUSPECT')),\n    strategy_version INTEGER NOT NULL,\n    sample_count INTEGER NOT NULL,\n    observed_work_count INTEGER NOT NULL,\n    stable_chapter_count INTEGER NOT NULL,\n    distinct_history_date_count INTEGER NOT NULL,\n    first_observed_at INTEGER,\n    last_observed_at INTEGER,\n    projected_date_at INTEGER,\n    last_reason TEXT,\n    updated_at INTEGER NOT NULL,\n    PRIMARY KEY(extension_package, extension_version, source_id, field_kind)\n)"
"CREATE TABLE author_archive_source_date_quality_current(\n    source_id INTEGER NOT NULL,\n    field_kind TEXT NOT NULL CHECK(field_kind IN ('WORK_PUBLISHED', 'CHAPTER_UPDATED')),\n    extension_package TEXT NOT NULL,\n    extension_version TEXT NOT NULL,\n    updated_at INTEGER NOT NULL,\n    PRIMARY KEY(source_id, field_kind),\n    FOREIGN KEY(extension_package, extension_version, source_id, field_kind)\n        REFERENCES author_archive_source_date_quality(\n            extension_package, extension_version, source_id, field_kind\n        ) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_source_date_quality_samples(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    extension_package TEXT NOT NULL,\n    extension_version TEXT NOT NULL,\n    source_id INTEGER NOT NULL,\n    field_kind TEXT NOT NULL CHECK(field_kind IN ('WORK_PUBLISHED', 'CHAPTER_UPDATED')),\n    work_natural_key TEXT NOT NULL,\n    chapter_natural_key TEXT,\n    raw_value TEXT,\n    value_at INTEGER,\n    precision TEXT NOT NULL CHECK(precision IN ('UNKNOWN', 'YEAR', 'MONTH', 'DAY')),\n    semantic_confirmed INTEGER NOT NULL,\n    observed_at INTEGER NOT NULL,\n    reason TEXT,\n    network_failure INTEGER NOT NULL,\n    FOREIGN KEY(extension_package, extension_version, source_id, field_kind)\n        REFERENCES author_archive_source_date_quality(\n            extension_package, extension_version, source_id, field_kind\n        ) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_identity_names(\n    name_text TEXT COLLATE BINARY NOT NULL PRIMARY KEY,\n    creator_id INTEGER NOT NULL,\n    origin TEXT NOT NULL,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL,\n    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE RESTRICT\n)"
"CREATE TABLE author_archive_identity_migrations(\n    migration_key TEXT NOT NULL PRIMARY KEY,\n    state TEXT NOT NULL CHECK(state IN ('RUNNING', 'COMPLETED', 'FAILED')),\n    last_error TEXT,\n    updated_at INTEGER NOT NULL\n)"
"CREATE TABLE author_archive_identity_migration_components(\n    migration_key TEXT NOT NULL,\n    component_key TEXT NOT NULL,\n    target_creator_id INTEGER NOT NULL,\n    source_creator_ids TEXT NOT NULL,\n    accepted_names TEXT NOT NULL,\n    recovery_graph TEXT,\n    state TEXT NOT NULL CHECK(state IN ('PREPARED', 'RUNNING', 'COMPLETED')),\n    updated_at INTEGER NOT NULL,\n    PRIMARY KEY(migration_key, component_key)\n)"
"CREATE TABLE author_archive_aliases(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    creator_id INTEGER NOT NULL,\n    raw_alias TEXT NOT NULL,\n    normalized_alias TEXT NOT NULL,\n    source TEXT NOT NULL,\n    evidence TEXT NOT NULL,\n    confidence REAL NOT NULL CHECK(confidence >= 0.0 AND confidence <= 1.0),\n    is_manual INTEGER NOT NULL,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL,\n    UNIQUE(creator_id, normalized_alias),\n    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_manga_links(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    manga_id INTEGER NOT NULL,\n    creator_id INTEGER NOT NULL,\n    role TEXT NOT NULL CHECK(role IN ('AUTHOR', 'ARTIST', 'BOTH', 'UNKNOWN')),\n    creator_order INTEGER NOT NULL,\n    origin TEXT NOT NULL CHECK(origin IN ('AUTOMATIC', 'USER', 'MIGRATION', 'RESTORE')),\n    source_text TEXT,\n    confidence REAL NOT NULL CHECK(confidence >= 0.0 AND confidence <= 1.0),\n    evidence TEXT NOT NULL,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL,\n    UNIQUE(manga_id, creator_id),\n    FOREIGN KEY(manga_id) REFERENCES mangas(_id) ON DELETE CASCADE,\n    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_source_works(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    source_id INTEGER NOT NULL,\n    stable_source_url TEXT NOT NULL CHECK(length(trim(stable_source_url)) > 0),\n    manga_id INTEGER,\n    title TEXT NOT NULL,\n    normalized_title TEXT NOT NULL,\n    author_text TEXT,\n    artist_text TEXT,\n    thumbnail_url TEXT,\n    first_seen_at INTEGER NOT NULL,\n    first_seen_date TEXT NOT NULL DEFAULT '',\n    first_seen_zone TEXT NOT NULL DEFAULT 'UTC',\n    last_seen_at INTEGER NOT NULL,\n    details_fetched_at INTEGER,\n    chapter_count_state TEXT NOT NULL DEFAULT 'UNKNOWN' CHECK(\n        chapter_count_state IN ('UNKNOWN', 'PARTIAL', 'COMPLETE')\n    ),\n    catalog_chapter_count INTEGER NOT NULL DEFAULT 0 CHECK(catalog_chapter_count >= 0),\n    latest_chapter_at INTEGER,\n    published_date_snapshot_at INTEGER CHECK(published_date_snapshot_at IS NULL OR published_date_snapshot_at > 0),\n    published_date_snapshot_basis TEXT,\n    published_date_snapshot_reason TEXT,\n    legacy_candidate_id INTEGER UNIQUE,\n    legacy_review_snapshot TEXT CHECK(\n        legacy_review_snapshot IS NULL OR\n        legacy_review_snapshot IN ('PENDING', 'ACCEPTED', 'IGNORED', 'MERGED')\n    ),\n    UNIQUE(source_id, stable_source_url),\n    FOREIGN KEY(manga_id) REFERENCES mangas(_id) ON DELETE SET NULL\n)"
"CREATE TABLE author_archive_source_work_creators(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    source_work_id INTEGER NOT NULL,\n    creator_id INTEGER NOT NULL,\n    role TEXT NOT NULL CHECK(role IN ('AUTHOR', 'ARTIST', 'BOTH', 'UNKNOWN')),\n    creator_order INTEGER NOT NULL,\n    origin TEXT NOT NULL CHECK(origin IN ('AUTOMATIC', 'USER', 'MIGRATION', 'RESTORE')),\n    verification TEXT NOT NULL CHECK(verification IN ('POSSIBLE', 'VERIFIED')),\n    source_text TEXT,\n    confidence REAL NOT NULL CHECK(confidence >= 0.0 AND confidence <= 1.0),\n    evidence TEXT NOT NULL,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL,\n    UNIQUE(source_work_id, creator_id),\n    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE,\n    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_watches(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    creator_id INTEGER NOT NULL UNIQUE,\n    enabled INTEGER NOT NULL,\n    period_millis INTEGER NOT NULL,\n    lease_owner TEXT,\n    lease_expires_at INTEGER,\n    last_checked_at INTEGER,\n    last_success_at INTEGER,\n    last_error TEXT,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL,\n    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE,\n    CHECK((lease_owner IS NULL) = (lease_expires_at IS NULL))\n)"
"CREATE TABLE author_archive_watch_sources(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    watch_id INTEGER NOT NULL,\n    source_id INTEGER NOT NULL,\n    baseline_state TEXT NOT NULL CHECK(baseline_state IN ('NEEDS_BASELINE', 'BASELINED')),\n    baseline_generation INTEGER NOT NULL,\n    next_due_at INTEGER,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL,\n    UNIQUE(watch_id, source_id),\n    FOREIGN KEY(watch_id) REFERENCES author_archive_watches(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_watch_result_policies(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    watch_id INTEGER NOT NULL UNIQUE,\n    include_probable INTEGER NOT NULL,\n    include_unknown INTEGER NOT NULL,\n    notify_probable INTEGER NOT NULL,\n    notify_unknown INTEGER NOT NULL,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL,\n    FOREIGN KEY(watch_id) REFERENCES author_archive_watches(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_watch_languages(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    policy_id INTEGER NOT NULL,\n    language_tag TEXT NOT NULL,\n    UNIQUE(policy_id, language_tag),\n    FOREIGN KEY(policy_id) REFERENCES author_archive_watch_result_policies(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_runs(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    run_key TEXT NOT NULL UNIQUE,\n    watch_id INTEGER NOT NULL,\n    state TEXT NOT NULL CHECK(state IN ('QUEUED', 'RUNNING', 'PARTIAL', 'SUCCEEDED', 'FAILED', 'CANCELLED')),\n    completed_sources INTEGER NOT NULL,\n    total_sources INTEGER NOT NULL,\n    truncated INTEGER NOT NULL,\n    error_code TEXT,\n    error_message TEXT,\n    queued_at INTEGER NOT NULL,\n    started_at INTEGER,\n    finished_at INTEGER,\n    FOREIGN KEY(watch_id) REFERENCES author_archive_watches(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_source_checkpoints(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    watch_id INTEGER NOT NULL,\n    source_id INTEGER NOT NULL,\n    cursor TEXT,\n    result_state TEXT NOT NULL CHECK(result_state IN ('NEVER', 'SUCCESS', 'EMPTY', 'TRUNCATED', 'FAILED', 'CANCELLED')),\n    consecutive_failures INTEGER NOT NULL,\n    backoff_until INTEGER,\n    last_checked_at INTEGER,\n    last_success_at INTEGER,\n    error_code TEXT,\n    error_message TEXT,\n    UNIQUE(watch_id, source_id),\n    FOREIGN KEY(watch_id) REFERENCES author_archive_watches(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_discoveries(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    watch_id INTEGER NOT NULL,\n    source_work_id INTEGER NOT NULL,\n    kind TEXT NOT NULL CHECK(kind IN ('NEW_WORK_CANDIDATE', 'NEW_SOURCE_VERSION')),\n    reason TEXT NOT NULL,\n    baseline_generation INTEGER NOT NULL,\n    read_state TEXT NOT NULL CHECK(read_state IN ('UNSEEN', 'SEEN')),\n    review_disposition TEXT NOT NULL CHECK(review_disposition IN ('PENDING', 'ACCEPTED', 'IGNORED')),\n    first_discovered_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL,\n    UNIQUE(watch_id, source_work_id),\n    FOREIGN KEY(watch_id) REFERENCES author_archive_watches(_id) ON DELETE CASCADE,\n    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_canonical_works(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    portable_key TEXT NOT NULL UNIQUE,\n    primary_title TEXT NOT NULL,\n    normalized_title TEXT NOT NULL,\n    status TEXT NOT NULL CHECK(status IN ('ACTIVE', 'DELETED')),\n    legacy_work_id INTEGER UNIQUE,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL\n)"
"CREATE TABLE author_archive_canonical_creators(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    work_id INTEGER NOT NULL,\n    creator_id INTEGER NOT NULL,\n    role TEXT NOT NULL CHECK(role IN ('AUTHOR', 'ARTIST', 'BOTH', 'UNKNOWN')),\n    creator_order INTEGER NOT NULL,\n    origin TEXT NOT NULL CHECK(origin IN ('ALGORITHM', 'USER', 'MIGRATION', 'RESTORE')),\n    evidence TEXT NOT NULL,\n    UNIQUE(work_id, creator_id),\n    FOREIGN KEY(work_id) REFERENCES author_archive_canonical_works(_id) ON DELETE CASCADE,\n    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_canonical_versions(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    work_id INTEGER NOT NULL,\n    source_work_id INTEGER NOT NULL UNIQUE,\n    confirmation TEXT NOT NULL CHECK(confirmation IN ('CONFIRMED', 'RESTORED')),\n    evidence TEXT NOT NULL,\n    confirmed_at INTEGER NOT NULL,\n    FOREIGN KEY(work_id) REFERENCES author_archive_canonical_works(_id) ON DELETE CASCADE,\n    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_work_decisions(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    source_work_id INTEGER NOT NULL,\n    work_id INTEGER NOT NULL,\n    state TEXT NOT NULL CHECK(state IN ('SUGGESTED', 'CONFIRMED', 'REJECTED')),\n    actor TEXT NOT NULL CHECK(actor IN ('ALGORITHM', 'USER', 'RESTORE')),\n    explicit INTEGER NOT NULL,\n    algorithm_version TEXT,\n    score REAL,\n    evidence TEXT NOT NULL,\n    decided_at INTEGER NOT NULL,\n    idempotency_key TEXT NOT NULL UNIQUE,\n    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE,\n    FOREIGN KEY(work_id) REFERENCES author_archive_canonical_works(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_language_assertions(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    subject_type TEXT NOT NULL CHECK(subject_type IN ('SOURCE_WORK', 'CANONICAL_WORK', 'CREATOR')),\n    subject_key TEXT NOT NULL,\n    dimension TEXT NOT NULL CHECK(dimension IN ('READING', 'ORIGINAL')),\n    language_tag TEXT NOT NULL,\n    confidence REAL NOT NULL CHECK(confidence >= 0.0 AND confidence <= 1.0),\n    evidence_kind TEXT NOT NULL CHECK(\n        evidence_kind IN ('UNKNOWN', 'TEXT_DETECTION', 'SINGLE_LANGUAGE_SOURCE', 'SOURCE_FILTER_OR_TAG', 'STRUCTURED_METADATA', 'MANUAL')\n    ),\n    evidence_payload TEXT NOT NULL,\n    actor TEXT NOT NULL CHECK(actor IN ('ALGORITHM', 'USER', 'RESTORE')),\n    algorithm_version TEXT,\n    withdrawn INTEGER NOT NULL,\n    asserted_at INTEGER NOT NULL,\n    idempotency_key TEXT NOT NULL UNIQUE\n)"
"CREATE TABLE author_archive_chapter_variants(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    source_work_id INTEGER NOT NULL,\n    chapter_natural_key TEXT NOT NULL,\n    volume_number REAL,\n    chapter_number REAL,\n    part_number REAL,\n    variant_type TEXT NOT NULL CHECK(variant_type IN ('REGULAR', 'SPLIT', 'VOLUME', 'EXTRA', 'OMAKE', 'SPECIAL', 'UNKNOWN')),\n    raw_name TEXT NOT NULL,\n    evidence TEXT NOT NULL,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL,\n    UNIQUE(source_work_id, chapter_natural_key),\n    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_notification_outbox(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    discovery_id INTEGER NOT NULL,\n    channel TEXT NOT NULL,\n    idempotency_key TEXT NOT NULL UNIQUE,\n    attempt_count INTEGER NOT NULL,\n    state TEXT NOT NULL CHECK(state IN ('PENDING', 'DELIVERED', 'FAILED', 'CANCELLED')),\n    last_error TEXT,\n    next_attempt_at INTEGER,\n    created_at INTEGER NOT NULL,\n    last_attempt_at INTEGER,\n    delivered_at INTEGER,\n    FOREIGN KEY(discovery_id) REFERENCES author_archive_discoveries(_id) ON DELETE CASCADE\n)"
"CREATE TABLE author_archive_legacy_import_state(\n    entity_type TEXT NOT NULL,\n    legacy_key TEXT NOT NULL,\n    fingerprint TEXT NOT NULL,\n    imported_at INTEGER NOT NULL,\n    PRIMARY KEY(entity_type, legacy_key)\n)"
"CREATE TABLE author_archive_identity_commands(\n    command_key TEXT NOT NULL PRIMARY KEY,\n    request_fingerprint TEXT NOT NULL,\n    creator_id INTEGER NOT NULL,\n    recovery_graph TEXT NOT NULL,\n    completed_at INTEGER NOT NULL,\n    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE RESTRICT\n)"
"CREATE TABLE categories(\n    _id INTEGER NOT NULL PRIMARY KEY,\n    name TEXT NOT NULL,\n    sort INTEGER NOT NULL,\n    flags INTEGER NOT NULL\n)"
"CREATE TABLE chapter_pairings (\n    chapter_id INTEGER NOT NULL PRIMARY KEY,\n    format_version INTEGER NOT NULL,\n    page_count INTEGER NOT NULL,\n    revision INTEGER NOT NULL,\n    FOREIGN KEY(chapter_id) REFERENCES chapters(_id) ON DELETE CASCADE\n)"
"CREATE TABLE chapter_pairing_boundaries (\n    chapter_id INTEGER NOT NULL,\n    page_ordinal INTEGER NOT NULL,\n    PRIMARY KEY(chapter_id, page_ordinal),\n    FOREIGN KEY(chapter_id) REFERENCES chapter_pairings(chapter_id) ON DELETE CASCADE\n)"
"CREATE TABLE chapter_pairing_revisions (\n    chapter_id INTEGER NOT NULL PRIMARY KEY,\n    revision INTEGER NOT NULL,\n    FOREIGN KEY(chapter_id) REFERENCES chapters(_id) ON DELETE CASCADE\n)"
"CREATE TABLE chapters(\n    _id INTEGER NOT NULL PRIMARY KEY,\n    manga_id INTEGER NOT NULL,\n    url TEXT NOT NULL,\n    name TEXT NOT NULL,\n    scanlator TEXT,\n    read INTEGER NOT NULL,\n    bookmark INTEGER NOT NULL,\n    last_page_read INTEGER NOT NULL,\n    chapter_number REAL NOT NULL,\n    source_order INTEGER NOT NULL,\n    date_fetch INTEGER NOT NULL,\n    date_upload INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL DEFAULT 0,\n    version INTEGER NOT NULL DEFAULT 0,\n    is_syncing INTEGER NOT NULL DEFAULT 0,\n    memo BLOB NOT NULL DEFAULT (CAST('{}' AS BLOB)),\n    FOREIGN KEY(manga_id) REFERENCES mangas (_id)\n    ON DELETE CASCADE\n)"
"CREATE TABLE creators(\n    _id INTEGER NOT NULL PRIMARY KEY,\n    display_name TEXT NOT NULL,\n    normalized_name TEXT NOT NULL UNIQUE,\n    sort_name TEXT,\n    aliases TEXT NOT NULL,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL\n)"
"CREATE TABLE manga_creators(\n    manga_id INTEGER NOT NULL,\n    creator_id INTEGER NOT NULL,\n    role TEXT NOT NULL,\n    source_text TEXT,\n    confidence REAL NOT NULL,\n    evidence TEXT NOT NULL,\n    PRIMARY KEY(manga_id, creator_id, role)\n)"
"CREATE TABLE discovery_candidate_creators(\n    candidate_id INTEGER NOT NULL,\n    creator_id INTEGER NOT NULL,\n    role TEXT NOT NULL,\n    source_text TEXT,\n    confidence REAL NOT NULL,\n    evidence TEXT NOT NULL,\n    PRIMARY KEY(candidate_id, creator_id, role)\n)"
"CREATE TABLE creator_watches(\n    creator_id INTEGER NOT NULL PRIMARY KEY,\n    enabled INTEGER NOT NULL,\n    source_ids TEXT NOT NULL,\n    language_tags TEXT NOT NULL,\n    last_checked_at INTEGER,\n    last_success_at INTEGER,\n    last_error TEXT,\n    created_at INTEGER NOT NULL\n)"
"CREATE TABLE canonical_works(\n    _id INTEGER NOT NULL PRIMARY KEY,\n    primary_title TEXT NOT NULL,\n    normalized_title TEXT NOT NULL,\n    primary_creator_id INTEGER,\n    original_language TEXT,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL\n)"
"CREATE TABLE manga_work_matches(\n    manga_id INTEGER NOT NULL UNIQUE,\n    work_id INTEGER NOT NULL,\n    confidence REAL NOT NULL,\n    match_reason TEXT NOT NULL,\n    state TEXT NOT NULL,\n    manually_confirmed INTEGER NOT NULL,\n    created_at INTEGER NOT NULL,\n    last_modified_at INTEGER NOT NULL\n)"
"CREATE TABLE discovery_candidates(\n    _id INTEGER NOT NULL PRIMARY KEY,\n    source INTEGER NOT NULL,\n    url TEXT NOT NULL,\n    title TEXT NOT NULL,\n    normalized_title TEXT NOT NULL,\n    author_text TEXT,\n    artist_text TEXT,\n    language_tag TEXT NOT NULL,\n    language_confidence REAL NOT NULL,\n    language_evidence TEXT NOT NULL,\n    thumbnail_url TEXT,\n    first_seen_at INTEGER NOT NULL,\n    last_seen_at INTEGER NOT NULL,\n    details_fetched_at INTEGER,\n    state TEXT NOT NULL,\n    UNIQUE(source, url)\n)"
"CREATE TABLE download_queue(\n    chapter_id INTEGER NOT NULL PRIMARY KEY,\n    manga_id INTEGER NOT NULL,\n    source_id INTEGER NOT NULL,\n    manga_title TEXT NOT NULL,\n    chapter_name TEXT NOT NULL,\n    chapter_url TEXT NOT NULL,\n    page_urls TEXT NOT NULL,\n    status TEXT NOT NULL,\n    progress INTEGER NOT NULL DEFAULT 0,\n    position INTEGER NOT NULL,\n    retry_count INTEGER NOT NULL DEFAULT 0,\n    failure TEXT\n)"
"CREATE TABLE excluded_scanlators(\n    manga_id INTEGER NOT NULL,\n    scanlator TEXT NOT NULL,\n    FOREIGN KEY(manga_id) REFERENCES mangas (_id)\n    ON DELETE CASCADE\n)"
"CREATE TABLE extension_repos (\n    base_url TEXT NOT NULL PRIMARY KEY,\n    name TEXT NOT NULL,\n    short_name TEXT,\n    website TEXT NOT NULL,\n    signing_key_fingerprint TEXT UNIQUE NOT NULL,\n    index_url TEXT,\n    extension_list_url TEXT,\n    contact_discord TEXT\n)"
"CREATE TABLE history(\n    _id INTEGER NOT NULL PRIMARY KEY,\n    chapter_id INTEGER NOT NULL UNIQUE,\n    last_read INTEGER,\n    time_read INTEGER NOT NULL,\n    FOREIGN KEY(chapter_id) REFERENCES chapters (_id)\n    ON DELETE CASCADE\n)"
"CREATE TABLE manga_sync(\n    _id INTEGER NOT NULL PRIMARY KEY,\n    manga_id INTEGER NOT NULL,\n    sync_id INTEGER NOT NULL,\n    remote_id INTEGER NOT NULL,\n    library_id INTEGER,\n    title TEXT NOT NULL,\n    last_chapter_read REAL NOT NULL,\n    total_chapters INTEGER NOT NULL,\n    status INTEGER NOT NULL,\n    score REAL NOT NULL,\n    remote_url TEXT NOT NULL,\n    start_date INTEGER NOT NULL,\n    finish_date INTEGER NOT NULL,\n    private INTEGER DEFAULT 0 NOT NULL,\n    UNIQUE (manga_id, sync_id) ON CONFLICT REPLACE,\n    FOREIGN KEY(manga_id) REFERENCES mangas (_id)\n    ON DELETE CASCADE\n)"
"CREATE TABLE mangas(\n    _id INTEGER NOT NULL PRIMARY KEY,\n    source INTEGER NOT NULL,\n    url TEXT NOT NULL,\n    artist TEXT,\n    author TEXT,\n    description TEXT,\n    genre TEXT,\n    title TEXT NOT NULL,\n    status INTEGER NOT NULL,\n    thumbnail_url TEXT,\n    favorite INTEGER NOT NULL,\n    last_update INTEGER,\n    next_update INTEGER,\n    initialized INTEGER NOT NULL,\n    viewer INTEGER NOT NULL,\n    chapter_flags INTEGER NOT NULL,\n    cover_last_modified INTEGER NOT NULL,\n    date_added INTEGER NOT NULL,\n    update_strategy INTEGER NOT NULL DEFAULT 0,\n    calculate_interval INTEGER DEFAULT 0 NOT NULL,\n    last_modified_at INTEGER NOT NULL DEFAULT 0,\n    favorite_modified_at INTEGER,\n    version INTEGER NOT NULL DEFAULT 0,\n    is_syncing INTEGER NOT NULL DEFAULT 0,\n    notes TEXT NOT NULL DEFAULT \"\",\n    memo BLOB NOT NULL DEFAULT (CAST('{}' AS BLOB))\n)"
"CREATE TABLE mangas_categories(\n    _id INTEGER NOT NULL PRIMARY KEY,\n    manga_id INTEGER NOT NULL,\n    category_id INTEGER NOT NULL,\n    FOREIGN KEY(category_id) REFERENCES categories (_id)\n    ON DELETE CASCADE,\n    FOREIGN KEY(manga_id) REFERENCES mangas (_id)\n    ON DELETE CASCADE\n)"
"CREATE TABLE reading_events(\n    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    idempotency_key TEXT NOT NULL UNIQUE,\n    chapter_id INTEGER NOT NULL,\n    event TEXT NOT NULL,\n    page INTEGER NOT NULL,\n    occurred_at INTEGER NOT NULL,\n    FOREIGN KEY(chapter_id) REFERENCES chapters(_id) ON DELETE CASCADE\n)"
"CREATE TABLE sources(\n    _id INTEGER NOT NULL PRIMARY KEY,\n    lang TEXT NOT NULL,\n    name TEXT NOT NULL\n)"
"CREATE TABLE sync_history_clears (\n    target_key TEXT NOT NULL PRIMARY KEY\n)"
"CREATE TABLE sync_history_watermarks (\n    target_key TEXT NOT NULL REFERENCES sync_history_clears(target_key),\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    actor_id TEXT NOT NULL,\n    epoch INTEGER NOT NULL,\n    seq INTEGER NOT NULL,\n    PRIMARY KEY (target_key, space_id, generation, actor_id, epoch)\n)"
"CREATE TABLE sync_http_account_gates (\n    account_id INTEGER NOT NULL PRIMARY KEY,\n    not_before_ms INTEGER NOT NULL DEFAULT 0,\n    updated_at INTEGER NOT NULL\n)"
"CREATE TABLE sync_imports (\n    import_id TEXT NOT NULL PRIMARY KEY,\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    origin TEXT NOT NULL,\n    actor_id TEXT NOT NULL,\n    epoch INTEGER NOT NULL,\n    next_seq INTEGER NOT NULL,\n    total INTEGER NOT NULL DEFAULT 0,\n    FOREIGN KEY (space_id, generation) REFERENCES sync_spaces(space_id, generation)\n)"
"CREATE TABLE sync_import_entries (\n    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,\n    import_id TEXT NOT NULL REFERENCES sync_imports(import_id),\n    category TEXT NOT NULL,\n    source_id INTEGER,\n    object_url TEXT,\n    parent_url TEXT,\n    portable_key TEXT,\n    title TEXT NOT NULL,\n    parent_title TEXT,\n    author TEXT,\n    artist TEXT,\n    thumbnail TEXT,\n    chapter_number REAL,\n    source_order INTEGER,\n    scanlator TEXT,\n    is_read INTEGER NOT NULL DEFAULT 0,\n    page_index INTEGER NOT NULL DEFAULT 0,\n    read_at INTEGER NOT NULL DEFAULT 0\n)"
"CREATE TABLE sync_import_heads (\n    import_id TEXT NOT NULL REFERENCES sync_imports(import_id),\n    object_key TEXT NOT NULL,\n    field TEXT NOT NULL,\n    ref_json TEXT NOT NULL,\n    PRIMARY KEY (import_id, object_key, field)\n)"
"CREATE TABLE sync_private_reading (\n    chapter_id INTEGER NOT NULL PRIMARY KEY REFERENCES chapters(_id) ON DELETE CASCADE,\n    public_read INTEGER NOT NULL,\n    public_page INTEGER NOT NULL,\n    public_read_at INTEGER NOT NULL\n)"
"CREATE TABLE sync_inbox_batches (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    batch_id TEXT NOT NULL,\n    status TEXT NOT NULL,\n    body_json TEXT NOT NULL,\n    error TEXT,\n    PRIMARY KEY (space_id, generation, batch_id, status)\n)"
"CREATE TABLE sync_descriptions (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    object_key TEXT NOT NULL,\n    description_json TEXT NOT NULL,\n    PRIMARY KEY (space_id, generation, object_key)\n)"
"CREATE TABLE sync_event_fields (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    event_key TEXT NOT NULL,\n    object_key TEXT NOT NULL,\n    field TEXT NOT NULL,\n    object_json TEXT NOT NULL,\n    PRIMARY KEY (space_id, generation, event_key, object_key, field),\n    FOREIGN KEY (space_id, generation, event_key) REFERENCES sync_events(space_id, generation, event_key)\n        ON DELETE CASCADE\n)"
