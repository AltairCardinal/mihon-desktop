"CREATE TABLE sync_spaces (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL CHECK (generation >= 0),\n    repository_owner TEXT NOT NULL,\n    repository_name TEXT NOT NULL,\n    repository_branch TEXT NOT NULL,\n    active INTEGER NOT NULL DEFAULT 0,\n    exchange_enabled INTEGER NOT NULL DEFAULT 1,\n    PRIMARY KEY (space_id, generation)\n)"
"CREATE TABLE sync_actors (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    actor_id TEXT NOT NULL,\n    epoch INTEGER NOT NULL CHECK (epoch > 0),\n    next_seq INTEGER NOT NULL DEFAULT 1 CHECK (next_seq > 0),\n    local_current INTEGER NOT NULL DEFAULT 1,\n    PRIMARY KEY (space_id, generation, actor_id, epoch),\n    FOREIGN KEY (space_id, generation) REFERENCES sync_spaces(space_id, generation)\n)"
"CREATE TABLE sync_batches (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    batch_id TEXT NOT NULL,\n    actor_id TEXT NOT NULL,\n    epoch INTEGER NOT NULL,\n    first_seq INTEGER NOT NULL,\n    last_seq INTEGER NOT NULL,\n    event_count INTEGER NOT NULL DEFAULT 0,\n    plaintext_bytes INTEGER NOT NULL,\n    status TEXT NOT NULL DEFAULT 'OPEN',\n    prepared_upload TEXT,\n    objects_json TEXT NOT NULL DEFAULT '[]',\n    PRIMARY KEY (space_id, generation, batch_id),\n    FOREIGN KEY (space_id, generation, actor_id, epoch)\n        REFERENCES sync_actors(space_id, generation, actor_id, epoch)\n)"
"CREATE TABLE sync_events (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    actor_id TEXT NOT NULL,\n    epoch INTEGER NOT NULL,\n    seq INTEGER NOT NULL,\n    category TEXT NOT NULL,\n    origin TEXT NOT NULL,\n    batch_id TEXT NOT NULL,\n    event_json TEXT NOT NULL,\n    occurred_at INTEGER NOT NULL,\n    event_key TEXT NOT NULL DEFAULT '',\n    sync_indexed INTEGER NOT NULL DEFAULT 0,\n    PRIMARY KEY (space_id, generation, actor_id, epoch, seq)\n)"
"CREATE TABLE sync_outbox (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    actor_id TEXT NOT NULL,\n    epoch INTEGER NOT NULL,\n    seq INTEGER NOT NULL,\n    batch_id TEXT NOT NULL,\n    status TEXT NOT NULL DEFAULT 'QUEUED',\n    PRIMARY KEY (space_id, generation, actor_id, epoch, seq),\n    FOREIGN KEY (space_id, generation, actor_id, epoch, seq)\n        REFERENCES sync_events(space_id, generation, actor_id, epoch, seq),\n    FOREIGN KEY (space_id, generation, batch_id) REFERENCES sync_batches(space_id, generation, batch_id)\n)"
"CREATE TABLE sync_object_heads (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    object_key TEXT NOT NULL,\n    field TEXT NOT NULL,\n    refs_json TEXT NOT NULL,\n    PRIMARY KEY (space_id, generation, object_key, field)\n)"
"CREATE TABLE sync_remote_guards (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    repository_owner TEXT NOT NULL,\n    repository_name TEXT NOT NULL,\n    repository_branch TEXT NOT NULL,\n    blocked INTEGER NOT NULL DEFAULT 0,\n    latest_head TEXT,\n    revision INTEGER NOT NULL DEFAULT 0,\n    PRIMARY KEY (space_id, generation)\n)"
"CREATE TABLE sync_remote_objects (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    object_id TEXT NOT NULL,\n    fingerprint TEXT NOT NULL,\n    PRIMARY KEY (space_id, generation, object_id)\n)"
"CREATE TABLE sync_remote_heads (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    head_sha TEXT NOT NULL,\n    snapshot_fingerprint TEXT NOT NULL,\n    PRIMARY KEY (space_id, generation, head_sha)\n)"
"CREATE TABLE sync_snapshot_manifests (\n    space_id TEXT NOT NULL,\n    generation INTEGER NOT NULL,\n    account_id INTEGER NOT NULL,\n    repository_id INTEGER NOT NULL,\n    repository_owner TEXT NOT NULL,\n    repository_name TEXT NOT NULL,\n    repository_branch TEXT NOT NULL,\n    api_origin TEXT NOT NULL,\n    validator_version TEXT NOT NULL,\n    validation_scope TEXT NOT NULL,\n    connection_revision TEXT NOT NULL,\n    head_sha TEXT NOT NULL,\n    head_fingerprint TEXT NOT NULL,\n    checksum TEXT NOT NULL,\n    tree_sha TEXT NOT NULL,\n    truncated INTEGER NOT NULL DEFAULT 0,\n    manifest_json TEXT NOT NULL,\n    PRIMARY KEY (space_id, generation)\n)"
