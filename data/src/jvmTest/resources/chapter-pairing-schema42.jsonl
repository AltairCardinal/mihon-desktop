"CREATE TRIGGER author_archive_identity_names_insert_revision\nAFTER INSERT ON author_archive_identity_names\nBEGIN\n    UPDATE author_archive_creators SET identity_revision = identity_revision + 1 WHERE _id = new.creator_id;\nEND"
"CREATE TRIGGER author_archive_identity_names_delete_revision\nAFTER DELETE ON author_archive_identity_names\nBEGIN\n    UPDATE author_archive_creators SET identity_revision = identity_revision + 1 WHERE _id = old.creator_id;\nEND"
"CREATE TRIGGER author_archive_identity_names_update_revision\nAFTER UPDATE OF creator_id, name_text ON author_archive_identity_names\nWHEN old.creator_id != new.creator_id OR old.name_text != new.name_text\nBEGIN\n    UPDATE author_archive_creators SET identity_revision = identity_revision + 1\n    WHERE _id IN (old.creator_id, new.creator_id);\nEND"
