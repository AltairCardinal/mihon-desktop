-- The compatibility bridge makes this migration safe for both published schema-28 families.
-- Existing objects are validated by DatabaseMigration after this migration completes.
CREATE TABLE IF NOT EXISTS author_archive_representative_work_cache(
    creator_id INTEGER NOT NULL PRIMARY KEY,
    strategy_version INTEGER NOT NULL,
    payload TEXT NOT NULL CHECK(length(payload) <= 8192),
    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS sync_runtime_runs (
    run_id TEXT NOT NULL PRIMARY KEY,
    space_id TEXT NOT NULL,
    generation INTEGER NOT NULL,
    trigger TEXT NOT NULL,
    state TEXT NOT NULL,
    phase TEXT NOT NULL,
    processed INTEGER NOT NULL DEFAULT 0,
    total INTEGER NOT NULL DEFAULT 0,
    completed INTEGER NOT NULL DEFAULT 0,
    skipped INTEGER NOT NULL DEFAULT 0,
    failed INTEGER NOT NULL DEFAULT 0,
    attempt INTEGER NOT NULL DEFAULT 0,
    next_retry_at INTEGER NOT NULL DEFAULT 0,
    last_progress_at INTEGER NOT NULL,
    stop_reason TEXT,
    owner_session TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS sync_runtime_active ON sync_runtime_runs(space_id, generation, state);

CREATE TABLE IF NOT EXISTS sync_runtime_logs (
    run_id TEXT NOT NULL REFERENCES sync_runtime_runs(run_id) ON DELETE CASCADE,
    log_key TEXT NOT NULL,
    title TEXT NOT NULL,
    detail TEXT NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (run_id, log_key)
);

CREATE INDEX IF NOT EXISTS sync_runtime_log_order ON sync_runtime_logs(run_id, created_at DESC);
