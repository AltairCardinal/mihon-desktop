    :workId,
    :state,
    :actor,
    :explicit,
    :algorithmVersion,
    :score,
    :evidence,
    :decidedAt,
    :idempotencyKey
)
ON CONFLICT(idempotency_key) DO NOTHING;

upsertArchiveLanguageAssertion:
INSERT INTO author_archive_language_assertions(
    subject_type,
    subject_key,
    dimension,
    language_tag,
    confidence,
    evidence_kind,
    evidence_payload,
    actor,
    algorithm_version,
    withdrawn,
    asserted_at,
