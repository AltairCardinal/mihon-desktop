)
VALUES (
    :subjectType,
    :subjectKey,
    :dimension,
    :languageTag,
    :confidence,
    :evidenceKind,
    :evidencePayload,
    :actor,
    :algorithmVersion,
    :withdrawn,
    :assertedAt,
    :idempotencyKey
)
ON CONFLICT(idempotency_key) DO NOTHING;

getArchiveLanguageAssertionByIdempotencyKey:
SELECT
    subject_type,
    subject_key,
    dimension,
    language_tag,
    confidence,
    evidence_kind,
    evidence_payload,
    actor,
    algorithm_version,
    withdrawn,
    asserted_at
FROM author_archive_language_assertions
WHERE idempotency_key = :idempotencyKey;
