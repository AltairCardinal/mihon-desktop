import kotlin.Boolean;

CREATE TABLE author_archive_creators(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    portable_key TEXT NOT NULL UNIQUE,
    display_name TEXT NOT NULL,
    normalized_name TEXT NOT NULL,
    sort_name TEXT,
    status TEXT NOT NULL CHECK(status IN ('ACTIVE', 'MERGED', 'DELETED')),
    merged_into_creator_id INTEGER,
    needs_review INTEGER AS Boolean NOT NULL DEFAULT 0,
    identity_revision INTEGER NOT NULL DEFAULT 0,
    legacy_creator_id INTEGER UNIQUE,
    created_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL,
    FOREIGN KEY(merged_into_creator_id) REFERENCES author_archive_creators(_id) ON DELETE RESTRICT,
    CHECK(
        (status = 'MERGED' AND merged_into_creator_id IS NOT NULL) OR
        (status IN ('ACTIVE', 'DELETED') AND merged_into_creator_id IS NULL)
    )
);

CREATE INDEX idx_author_archive_creators_normalized_name
ON author_archive_creators(normalized_name);
CREATE INDEX idx_author_archive_creators_status
ON author_archive_creators(status);
CREATE INDEX idx_author_archive_creators_merged_into
ON author_archive_creators(merged_into_creator_id);

-- Device-local rebuildable presentation state; backup and sync queries explicitly exclude it.
CREATE TABLE author_archive_representative_work_cache(
    creator_id INTEGER NOT NULL PRIMARY KEY,
    strategy_version INTEGER NOT NULL,
    payload TEXT NOT NULL CHECK(length(payload) <= 8192),
    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE
);

-- Device-local presentation corrections. These records are intentionally excluded from backup
-- and sync; source_work_id preserves the natural source identity without changing canonical facts.
CREATE TABLE author_archive_presentation_exclusions(
    creator_id INTEGER NOT NULL,
    source_work_id INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY(creator_id, source_work_id),
    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE,
    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_presentation_exclusions_source_work
ON author_archive_presentation_exclusions(source_work_id);

-- Device-local, rebuildable evidence for source supplied dates. It is intentionally not part of
-- the backup contract: a new extension version gets a fresh quality bucket.
CREATE TABLE author_archive_source_date_quality(
    extension_package TEXT NOT NULL,
    extension_version TEXT NOT NULL,
    source_id INTEGER NOT NULL,
    field_kind TEXT NOT NULL CHECK(field_kind IN ('WORK_PUBLISHED', 'CHAPTER_UPDATED')),
    status TEXT NOT NULL CHECK(status IN ('UNKNOWN', 'TRUSTED', 'SUSPECT')),
    strategy_version INTEGER NOT NULL,
    sample_count INTEGER NOT NULL,
    observed_work_count INTEGER NOT NULL,
    stable_chapter_count INTEGER NOT NULL,
    distinct_history_date_count INTEGER NOT NULL,
    first_observed_at INTEGER,
    last_observed_at INTEGER,
    projected_date_at INTEGER,
    last_reason TEXT,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(extension_package, extension_version, source_id, field_kind)
);

-- The most recently observed extension identity is explicit so equal observation timestamps
-- cannot make an older trusted parser win projection reads.
CREATE TABLE author_archive_source_date_quality_current(
    source_id INTEGER NOT NULL,
    field_kind TEXT NOT NULL CHECK(field_kind IN ('WORK_PUBLISHED', 'CHAPTER_UPDATED')),
    extension_package TEXT NOT NULL,
    extension_version TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(source_id, field_kind),
    FOREIGN KEY(extension_package, extension_version, source_id, field_kind)
        REFERENCES author_archive_source_date_quality(
            extension_package, extension_version, source_id, field_kind
        ) ON DELETE CASCADE
);

CREATE TABLE author_archive_source_date_quality_samples(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    extension_package TEXT NOT NULL,
    extension_version TEXT NOT NULL,
    source_id INTEGER NOT NULL,
    field_kind TEXT NOT NULL CHECK(field_kind IN ('WORK_PUBLISHED', 'CHAPTER_UPDATED')),
    work_natural_key TEXT NOT NULL,
    chapter_natural_key TEXT,
    raw_value TEXT,
    value_at INTEGER,
    precision TEXT NOT NULL CHECK(precision IN ('UNKNOWN', 'YEAR', 'MONTH', 'DAY')),
    semantic_confirmed INTEGER AS Boolean NOT NULL,
    observed_at INTEGER NOT NULL,
    reason TEXT,
    network_failure INTEGER AS Boolean NOT NULL,
    FOREIGN KEY(extension_package, extension_version, source_id, field_kind)
        REFERENCES author_archive_source_date_quality(
            extension_package, extension_version, source_id, field_kind
        ) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_source_date_quality_samples_key
ON author_archive_source_date_quality_samples(
    extension_package, extension_version, source_id, field_kind, work_natural_key, chapter_natural_key
);

CREATE INDEX idx_author_archive_source_date_quality_samples_observed
ON author_archive_source_date_quality_samples(observed_at);

CREATE TABLE author_archive_identity_names(
    name_text TEXT COLLATE BINARY NOT NULL PRIMARY KEY,
    creator_id INTEGER NOT NULL,
    origin TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL,
    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE RESTRICT
);

CREATE INDEX idx_author_archive_identity_names_creator
ON author_archive_identity_names(creator_id);

CREATE TABLE author_archive_identity_migrations(
    migration_key TEXT NOT NULL PRIMARY KEY,
    state TEXT NOT NULL CHECK(state IN ('RUNNING', 'COMPLETED', 'FAILED')),
    last_error TEXT,
    updated_at INTEGER NOT NULL
);

CREATE TABLE author_archive_identity_migration_components(
    migration_key TEXT NOT NULL,
    component_key TEXT NOT NULL,
    target_creator_id INTEGER NOT NULL,
    source_creator_ids TEXT NOT NULL,
    accepted_names TEXT NOT NULL,
    recovery_graph TEXT,
    state TEXT NOT NULL CHECK(state IN ('PREPARED', 'RUNNING', 'COMPLETED')),
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(migration_key, component_key)
);

CREATE TABLE author_archive_aliases(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    creator_id INTEGER NOT NULL,
    raw_alias TEXT NOT NULL,
    normalized_alias TEXT NOT NULL,
    source TEXT NOT NULL,
    evidence TEXT NOT NULL,
    confidence REAL NOT NULL CHECK(confidence >= 0.0 AND confidence <= 1.0),
    is_manual INTEGER AS Boolean NOT NULL,
    created_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL,
    UNIQUE(creator_id, normalized_alias),
    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_aliases_normalized
ON author_archive_aliases(normalized_alias);
CREATE INDEX idx_author_archive_aliases_creator
ON author_archive_aliases(creator_id);

CREATE TABLE author_archive_manga_links(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    manga_id INTEGER NOT NULL,
    creator_id INTEGER NOT NULL,
    role TEXT NOT NULL CHECK(role IN ('AUTHOR', 'ARTIST', 'BOTH', 'UNKNOWN')),
    creator_order INTEGER NOT NULL,
    origin TEXT NOT NULL CHECK(origin IN ('AUTOMATIC', 'USER', 'MIGRATION', 'RESTORE')),
    source_text TEXT,
    confidence REAL NOT NULL CHECK(confidence >= 0.0 AND confidence <= 1.0),
    evidence TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL,
    UNIQUE(manga_id, creator_id),
    FOREIGN KEY(manga_id) REFERENCES mangas(_id) ON DELETE CASCADE,
    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_manga_links_creator
ON author_archive_manga_links(creator_id);
CREATE INDEX idx_author_archive_manga_links_manga_order
ON author_archive_manga_links(manga_id, creator_order);

CREATE TABLE author_archive_source_works(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    source_id INTEGER NOT NULL,
    stable_source_url TEXT NOT NULL CHECK(length(trim(stable_source_url)) > 0),
    manga_id INTEGER,
    title TEXT NOT NULL,
    normalized_title TEXT NOT NULL,
    author_text TEXT,
    artist_text TEXT,
    thumbnail_url TEXT,
    first_seen_at INTEGER NOT NULL,
    first_seen_date TEXT NOT NULL DEFAULT '',
    first_seen_zone TEXT NOT NULL DEFAULT 'UTC',
    last_seen_at INTEGER NOT NULL,
    details_fetched_at INTEGER,
    chapter_count_state TEXT NOT NULL DEFAULT 'UNKNOWN' CHECK(
        chapter_count_state IN ('UNKNOWN', 'PARTIAL', 'COMPLETE')
    ),
    catalog_chapter_count INTEGER NOT NULL DEFAULT 0 CHECK(catalog_chapter_count >= 0),
    latest_chapter_at INTEGER,
    published_date_snapshot_at INTEGER CHECK(published_date_snapshot_at IS NULL OR published_date_snapshot_at > 0),
    published_date_snapshot_basis TEXT,
    published_date_snapshot_reason TEXT,
    legacy_candidate_id INTEGER UNIQUE,
    legacy_review_snapshot TEXT CHECK(
        legacy_review_snapshot IS NULL OR
        legacy_review_snapshot IN ('PENDING', 'ACCEPTED', 'IGNORED', 'MERGED')
    ),
    UNIQUE(source_id, stable_source_url),
    FOREIGN KEY(manga_id) REFERENCES mangas(_id) ON DELETE SET NULL
);

CREATE TRIGGER author_archive_source_work_first_seen_defaults
AFTER INSERT ON author_archive_source_works
WHEN new.first_seen_at > 0 AND length(trim(new.first_seen_date)) = 0
BEGIN
    UPDATE author_archive_source_works
    SET first_seen_date = strftime('%Y-%m-%d', new.first_seen_at / 1000, 'unixepoch'),
        first_seen_zone = CASE
            WHEN length(trim(new.first_seen_zone)) = 0 THEN 'UTC'
            ELSE new.first_seen_zone
        END
    WHERE _id = new._id;
END;

CREATE INDEX idx_author_archive_source_works_manga
ON author_archive_source_works(manga_id);
CREATE INDEX idx_author_archive_source_works_title
ON author_archive_source_works(normalized_title);
CREATE INDEX idx_author_archive_source_works_last_seen
ON author_archive_source_works(last_seen_at);

CREATE TABLE author_archive_source_work_creators(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    source_work_id INTEGER NOT NULL,
    creator_id INTEGER NOT NULL,
    role TEXT NOT NULL CHECK(role IN ('AUTHOR', 'ARTIST', 'BOTH', 'UNKNOWN')),
    creator_order INTEGER NOT NULL,
    origin TEXT NOT NULL CHECK(origin IN ('AUTOMATIC', 'USER', 'MIGRATION', 'RESTORE')),
    verification TEXT NOT NULL CHECK(verification IN ('POSSIBLE', 'VERIFIED')),
    source_text TEXT,
    confidence REAL NOT NULL CHECK(confidence >= 0.0 AND confidence <= 1.0),
    evidence TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL,
    UNIQUE(source_work_id, creator_id),
    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE,
    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_source_work_creators_creator
ON author_archive_source_work_creators(creator_id);
CREATE INDEX idx_author_archive_source_work_creators_work_order
ON author_archive_source_work_creators(source_work_id, creator_order);

CREATE TABLE author_archive_watches(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    creator_id INTEGER NOT NULL UNIQUE,
    enabled INTEGER AS Boolean NOT NULL,
    period_millis INTEGER NOT NULL,
    lease_owner TEXT,
    lease_expires_at INTEGER,
    last_checked_at INTEGER,
    last_success_at INTEGER,
    last_error TEXT,
    created_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL,
    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE,
    CHECK((lease_owner IS NULL) = (lease_expires_at IS NULL))
);

CREATE INDEX idx_author_archive_watches_due
ON author_archive_watches(enabled, last_success_at);
CREATE INDEX idx_author_archive_watches_lease
ON author_archive_watches(lease_expires_at);

CREATE TABLE author_archive_watch_sources(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    watch_id INTEGER NOT NULL,
    source_id INTEGER NOT NULL,
    baseline_state TEXT NOT NULL CHECK(baseline_state IN ('NEEDS_BASELINE', 'BASELINED')),
    baseline_generation INTEGER NOT NULL,
    next_due_at INTEGER,
    created_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL,
    UNIQUE(watch_id, source_id),
    FOREIGN KEY(watch_id) REFERENCES author_archive_watches(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_watch_sources_due
ON author_archive_watch_sources(next_due_at, watch_id);

CREATE TABLE author_archive_watch_result_policies(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    watch_id INTEGER NOT NULL UNIQUE,
    include_probable INTEGER AS Boolean NOT NULL,
    include_unknown INTEGER AS Boolean NOT NULL,
    notify_probable INTEGER AS Boolean NOT NULL,
    notify_unknown INTEGER AS Boolean NOT NULL,
    created_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL,
    FOREIGN KEY(watch_id) REFERENCES author_archive_watches(_id) ON DELETE CASCADE
);

CREATE TABLE author_archive_watch_languages(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    policy_id INTEGER NOT NULL,
    language_tag TEXT NOT NULL,
    UNIQUE(policy_id, language_tag),
    FOREIGN KEY(policy_id) REFERENCES author_archive_watch_result_policies(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_watch_languages_tag
ON author_archive_watch_languages(language_tag);

CREATE TABLE author_archive_runs(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    run_key TEXT NOT NULL UNIQUE,
    watch_id INTEGER NOT NULL,
    state TEXT NOT NULL CHECK(state IN ('QUEUED', 'RUNNING', 'PARTIAL', 'SUCCEEDED', 'FAILED', 'CANCELLED')),
    completed_sources INTEGER NOT NULL,
    total_sources INTEGER NOT NULL,
    truncated INTEGER AS Boolean NOT NULL,
    error_code TEXT,
    error_message TEXT,
    queued_at INTEGER NOT NULL,
    started_at INTEGER,
    finished_at INTEGER,
    FOREIGN KEY(watch_id) REFERENCES author_archive_watches(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_runs_watch_state
ON author_archive_runs(watch_id, state, queued_at);

CREATE TABLE author_archive_source_checkpoints(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    watch_id INTEGER NOT NULL,
    source_id INTEGER NOT NULL,
    cursor TEXT,
    result_state TEXT NOT NULL CHECK(result_state IN ('NEVER', 'SUCCESS', 'EMPTY', 'TRUNCATED', 'FAILED', 'CANCELLED')),
    consecutive_failures INTEGER NOT NULL,
    backoff_until INTEGER,
    last_checked_at INTEGER,
    last_success_at INTEGER,
    error_code TEXT,
    error_message TEXT,
    UNIQUE(watch_id, source_id),
    FOREIGN KEY(watch_id) REFERENCES author_archive_watches(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_source_checkpoints_backoff
ON author_archive_source_checkpoints(backoff_until, watch_id);

CREATE TABLE author_archive_discoveries(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    watch_id INTEGER NOT NULL,
    source_work_id INTEGER NOT NULL,
    kind TEXT NOT NULL CHECK(kind IN ('NEW_WORK_CANDIDATE', 'NEW_SOURCE_VERSION')),
    reason TEXT NOT NULL,
    baseline_generation INTEGER NOT NULL,
    read_state TEXT NOT NULL CHECK(read_state IN ('UNSEEN', 'SEEN')),
    review_disposition TEXT NOT NULL CHECK(review_disposition IN ('PENDING', 'ACCEPTED', 'IGNORED')),
    first_discovered_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL,
    UNIQUE(watch_id, source_work_id),
    FOREIGN KEY(watch_id) REFERENCES author_archive_watches(_id) ON DELETE CASCADE,
    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_discoveries_feed
ON author_archive_discoveries(watch_id, read_state, first_discovered_at DESC);
CREATE INDEX idx_author_archive_discoveries_review
ON author_archive_discoveries(review_disposition, first_discovered_at DESC);
CREATE INDEX idx_author_archive_discoveries_unread
ON author_archive_discoveries(read_state, first_discovered_at DESC);

CREATE TABLE author_archive_canonical_works(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    portable_key TEXT NOT NULL UNIQUE,
    primary_title TEXT NOT NULL,
    normalized_title TEXT NOT NULL,
    status TEXT NOT NULL CHECK(status IN ('ACTIVE', 'DELETED')),
    legacy_work_id INTEGER UNIQUE,
    created_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL
);

CREATE INDEX idx_author_archive_canonical_works_title
ON author_archive_canonical_works(normalized_title);

CREATE TABLE author_archive_canonical_creators(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    work_id INTEGER NOT NULL,
    creator_id INTEGER NOT NULL,
    role TEXT NOT NULL CHECK(role IN ('AUTHOR', 'ARTIST', 'BOTH', 'UNKNOWN')),
    creator_order INTEGER NOT NULL,
    origin TEXT NOT NULL CHECK(origin IN ('ALGORITHM', 'USER', 'MIGRATION', 'RESTORE')),
    evidence TEXT NOT NULL,
    UNIQUE(work_id, creator_id),
    FOREIGN KEY(work_id) REFERENCES author_archive_canonical_works(_id) ON DELETE CASCADE,
    FOREIGN KEY(creator_id) REFERENCES author_archive_creators(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_canonical_creators_creator
ON author_archive_canonical_creators(creator_id);


CREATE TRIGGER author_archive_identity_names_insert_revision
AFTER INSERT ON author_archive_identity_names
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1 WHERE _id = new.creator_id;
END;
CREATE TRIGGER author_archive_identity_names_delete_revision
AFTER DELETE ON author_archive_identity_names
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1 WHERE _id = old.creator_id;
END;
CREATE TRIGGER author_archive_identity_names_update_revision
AFTER UPDATE OF creator_id, name_text ON author_archive_identity_names
WHEN old.creator_id != new.creator_id OR old.name_text != new.name_text
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1
    WHERE _id IN (old.creator_id, new.creator_id);
END;
CREATE TRIGGER author_archive_manga_links_insert_revision
AFTER INSERT ON author_archive_manga_links
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1 WHERE _id = new.creator_id;
END;
CREATE TRIGGER author_archive_manga_links_delete_revision
AFTER DELETE ON author_archive_manga_links
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1 WHERE _id = old.creator_id;
END;
CREATE TRIGGER author_archive_manga_links_update_revision
AFTER UPDATE OF creator_id, role, creator_order, origin, source_text, confidence, evidence ON author_archive_manga_links
WHEN old.creator_id != new.creator_id OR old.role != new.role OR old.creator_order != new.creator_order OR
     old.origin != new.origin OR old.source_text IS NOT new.source_text OR old.confidence != new.confidence OR
     old.evidence != new.evidence
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1
    WHERE _id IN (old.creator_id, new.creator_id);
END;
CREATE TRIGGER author_archive_source_work_creators_insert_revision
AFTER INSERT ON author_archive_source_work_creators
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1 WHERE _id = new.creator_id;
END;
CREATE TRIGGER author_archive_source_work_creators_delete_revision
AFTER DELETE ON author_archive_source_work_creators
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1 WHERE _id = old.creator_id;
END;
CREATE TRIGGER author_archive_source_work_creators_update_revision
AFTER UPDATE OF creator_id, role, creator_order, origin, verification, source_text, confidence, evidence
ON author_archive_source_work_creators
WHEN old.creator_id != new.creator_id OR old.role != new.role OR old.creator_order != new.creator_order OR
     old.origin != new.origin OR old.verification != new.verification OR old.source_text IS NOT new.source_text OR
     old.confidence != new.confidence OR old.evidence != new.evidence
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1
    WHERE _id IN (old.creator_id, new.creator_id);
END;
CREATE TRIGGER author_archive_canonical_creators_insert_revision
AFTER INSERT ON author_archive_canonical_creators
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1 WHERE _id = new.creator_id;
END;
CREATE TRIGGER author_archive_canonical_creators_delete_revision
AFTER DELETE ON author_archive_canonical_creators
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1 WHERE _id = old.creator_id;
END;
CREATE TRIGGER author_archive_canonical_creators_update_revision
AFTER UPDATE OF creator_id, role, creator_order, origin, evidence ON author_archive_canonical_creators
WHEN old.creator_id != new.creator_id OR old.role != new.role OR old.creator_order != new.creator_order OR
     old.origin != new.origin OR old.evidence != new.evidence
BEGIN
    UPDATE author_archive_creators SET identity_revision = identity_revision + 1
    WHERE _id IN (old.creator_id, new.creator_id);
END;

CREATE TABLE author_archive_canonical_versions(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    work_id INTEGER NOT NULL,
    source_work_id INTEGER NOT NULL UNIQUE,
    confirmation TEXT NOT NULL CHECK(confirmation IN ('CONFIRMED', 'RESTORED')),
    evidence TEXT NOT NULL,
    confirmed_at INTEGER NOT NULL,
    FOREIGN KEY(work_id) REFERENCES author_archive_canonical_works(_id) ON DELETE CASCADE,
    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_canonical_versions_work
ON author_archive_canonical_versions(work_id);

CREATE TABLE author_archive_work_decisions(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    source_work_id INTEGER NOT NULL,
    work_id INTEGER NOT NULL,
    state TEXT NOT NULL CHECK(state IN ('SUGGESTED', 'CONFIRMED', 'REJECTED')),
    actor TEXT NOT NULL CHECK(actor IN ('ALGORITHM', 'USER', 'RESTORE')),
    explicit INTEGER AS Boolean NOT NULL,
    algorithm_version TEXT,
    score REAL,
    evidence TEXT NOT NULL,
    decided_at INTEGER NOT NULL,
    idempotency_key TEXT NOT NULL UNIQUE,
    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE,
    FOREIGN KEY(work_id) REFERENCES author_archive_canonical_works(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_work_decisions_pair
ON author_archive_work_decisions(source_work_id, work_id, decided_at DESC);
CREATE INDEX idx_author_archive_work_decisions_state
ON author_archive_work_decisions(state, decided_at DESC);

CREATE TABLE author_archive_language_assertions(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    subject_type TEXT NOT NULL CHECK(subject_type IN ('SOURCE_WORK', 'CANONICAL_WORK', 'CREATOR')),
    subject_key TEXT NOT NULL,
    dimension TEXT NOT NULL CHECK(dimension IN ('READING', 'ORIGINAL')),
    language_tag TEXT NOT NULL,
    confidence REAL NOT NULL CHECK(confidence >= 0.0 AND confidence <= 1.0),
    evidence_kind TEXT NOT NULL CHECK(
        evidence_kind IN ('UNKNOWN', 'TEXT_DETECTION', 'SINGLE_LANGUAGE_SOURCE', 'SOURCE_FILTER_OR_TAG', 'STRUCTURED_METADATA', 'MANUAL')
    ),
    evidence_payload TEXT NOT NULL,
    actor TEXT NOT NULL CHECK(actor IN ('ALGORITHM', 'USER', 'RESTORE')),
    algorithm_version TEXT,
    withdrawn INTEGER AS Boolean NOT NULL,
    asserted_at INTEGER NOT NULL,
    idempotency_key TEXT NOT NULL UNIQUE
);

CREATE INDEX idx_author_archive_language_assertions_subject
ON author_archive_language_assertions(subject_type, subject_key, dimension, withdrawn, asserted_at DESC);
CREATE INDEX idx_author_archive_language_assertions_tag
ON author_archive_language_assertions(dimension, language_tag, withdrawn);

CREATE TABLE author_archive_chapter_variants(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    source_work_id INTEGER NOT NULL,
    chapter_natural_key TEXT NOT NULL,
    volume_number REAL,
    chapter_number REAL,
    part_number REAL,
    variant_type TEXT NOT NULL CHECK(variant_type IN ('REGULAR', 'SPLIT', 'VOLUME', 'EXTRA', 'OMAKE', 'SPECIAL', 'UNKNOWN')),
    raw_name TEXT NOT NULL,
    evidence TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL,
    UNIQUE(source_work_id, chapter_natural_key),
    FOREIGN KEY(source_work_id) REFERENCES author_archive_source_works(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_chapter_variants_work_order
ON author_archive_chapter_variants(source_work_id, volume_number, chapter_number, part_number);

deleteArchiveChapterVariants:
DELETE FROM author_archive_chapter_variants
WHERE source_work_id = (
    SELECT _id FROM author_archive_source_works
    WHERE source_id = :sourceId AND stable_source_url = :stableSourceUrl
);

insertArchiveChapterVariant:
INSERT INTO author_archive_chapter_variants(
    source_work_id, chapter_natural_key, volume_number, chapter_number, part_number,
    variant_type, raw_name, evidence, created_at, last_modified_at
)
SELECT
    SW._id, :chapterNaturalKey, :volumeNumber, :chapterNumber, :partNumber,
    :variantType, :rawName, :evidence, :createdAt, :lastModifiedAt
FROM author_archive_source_works SW
WHERE SW.source_id = :sourceId AND SW.stable_source_url = :stableSourceUrl;

getArchiveChapterVariants:
SELECT
    CV.chapter_natural_key, CV.volume_number, CV.chapter_number, CV.part_number,
    CV.variant_type, CV.raw_name, CV.evidence
FROM author_archive_chapter_variants CV
JOIN author_archive_source_works SW ON SW._id = CV.source_work_id
WHERE SW.source_id = :sourceId AND SW.stable_source_url = :stableSourceUrl
ORDER BY CV._id;

CREATE TABLE author_archive_notification_outbox(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    discovery_id INTEGER NOT NULL,
    channel TEXT NOT NULL,
    idempotency_key TEXT NOT NULL UNIQUE,
    attempt_count INTEGER NOT NULL,
    state TEXT NOT NULL CHECK(state IN ('PENDING', 'DELIVERED', 'FAILED', 'CANCELLED')),
    last_error TEXT,
    next_attempt_at INTEGER,
    created_at INTEGER NOT NULL,
    last_attempt_at INTEGER,
    delivered_at INTEGER,
    FOREIGN KEY(discovery_id) REFERENCES author_archive_discoveries(_id) ON DELETE CASCADE
);

CREATE INDEX idx_author_archive_notification_outbox_pending
ON author_archive_notification_outbox(state, next_attempt_at, created_at);

CREATE TABLE author_archive_legacy_import_state(
    entity_type TEXT NOT NULL,
    legacy_key TEXT NOT NULL,
    fingerprint TEXT NOT NULL,
    imported_at INTEGER NOT NULL,
    PRIMARY KEY(entity_type, legacy_key)
);

CREATE INDEX idx_author_archive_legacy_import_state_imported
ON author_archive_legacy_import_state(imported_at);

getArchiveCreator:
SELECT
    C._id,
    C.display_name,
    C.normalized_name,
    C.sort_name,
    coalesce((
        SELECT group_concat(ORDERED_ALIAS.encoded_alias, ',')
        FROM (
            SELECT hex(N.name_text) AS encoded_alias
            FROM author_archive_identity_names N
            WHERE N.creator_id = C._id
            ORDER BY N.name_text COLLATE BINARY
        ) ORDERED_ALIAS
    ), '') AS aliases,
    C.created_at,
    C.last_modified_at
FROM author_archive_creators C
WHERE C._id = :id
AND C.status = 'ACTIVE';

getArchiveCreatorsByAlias:
SELECT
    C._id,
    C.display_name,
    C.normalized_name,
    C.sort_name,
    coalesce((
        SELECT group_concat(ORDERED_ALIAS.encoded_alias, ',')
        FROM (
            SELECT hex(N.name_text) AS encoded_alias
            FROM author_archive_identity_names N
            WHERE N.creator_id = C._id
            ORDER BY N.name_text COLLATE BINARY
        ) ORDERED_ALIAS
    ), '') AS aliases,
    C.created_at,
    C.last_modified_at
FROM author_archive_creators C
WHERE EXISTS(
    SELECT 1
    FROM author_archive_aliases MATCHED_ALIAS
    WHERE MATCHED_ALIAS.creator_id = C._id
    AND MATCHED_ALIAS.normalized_alias = :normalizedAlias
)
AND C.status = 'ACTIVE'
ORDER BY C._id;

getArchiveCreators:
SELECT
    C._id,
    C.display_name,
    C.normalized_name,
    C.sort_name,
    coalesce((
        SELECT group_concat(ORDERED_ALIAS.encoded_alias, ',')
        FROM (
            SELECT hex(N.name_text) AS encoded_alias
            FROM author_archive_identity_names N
            WHERE N.creator_id = C._id
            ORDER BY N.name_text COLLATE BINARY
        ) ORDERED_ALIAS
    ), '') AS aliases,
    C.created_at,
    C.last_modified_at
FROM author_archive_creators C
WHERE C.status = 'ACTIVE'
ORDER BY C.sort_name COLLATE NOCASE, C.display_name COLLATE NOCASE, C._id;

getArchiveCreatorIdByLegacyId:
WITH RECURSIVE identity_path(_id, status, merged_into_creator_id, depth) AS (
    SELECT _id, status, merged_into_creator_id, 0 FROM author_archive_creators
    WHERE legacy_creator_id = :legacyCreatorId
    UNION ALL
    SELECT C._id, C.status, C.merged_into_creator_id, P.depth + 1
    FROM author_archive_creators C JOIN identity_path P ON C._id = P.merged_into_creator_id
    WHERE P.status = 'MERGED' AND P.depth < 100
)
SELECT _id FROM identity_path WHERE status = 'ACTIVE' ORDER BY depth DESC LIMIT 1;

attachArchiveLegacyCreatorId:
UPDATE author_archive_creators
SET legacy_creator_id = coalesce(legacy_creator_id, :legacyCreatorId),
    last_modified_at = max(last_modified_at, :lastModifiedAt)
WHERE _id = :creatorId
AND (legacy_creator_id IS NULL OR legacy_creator_id = :legacyCreatorId);

getArchiveCreatorIdByPortableKey:
SELECT _id
FROM author_archive_creators
WHERE portable_key = :portableKey;

getArchiveCreatorIdByExactName:
SELECT N.creator_id
FROM author_archive_identity_names N
JOIN author_archive_creators C ON C._id = N.creator_id
WHERE N.name_text = :nameText COLLATE BINARY
AND C.status = 'ACTIVE';

getArchiveIdentityNames:
SELECT name_text, creator_id, origin, created_at, last_modified_at
FROM author_archive_identity_names
ORDER BY name_text COLLATE BINARY;

getArchiveIdentityNamesForCreator:
SELECT name_text
FROM author_archive_identity_names
WHERE creator_id = :creatorId
ORDER BY name_text COLLATE BINARY;

registerArchiveIdentityName:
INSERT INTO author_archive_identity_names(name_text, creator_id, origin, created_at, last_modified_at)
VALUES (:nameText, :creatorId, :origin, :createdAt, :lastModifiedAt);

registerArchiveIdentityNameIfAbsent:
INSERT OR IGNORE INTO author_archive_identity_names(name_text, creator_id, origin, created_at, last_modified_at)
VALUES (:nameText, :creatorId, :origin, :createdAt, :lastModifiedAt);

moveArchiveIdentityNames:
UPDATE author_archive_identity_names
SET creator_id = :targetCreatorId,
    last_modified_at = max(last_modified_at, :lastModifiedAt)
WHERE creator_id = :sourceCreatorId;

deleteArchiveIdentityName:
DELETE FROM author_archive_identity_names
WHERE name_text = :nameText COLLATE BINARY
AND creator_id = :creatorId;

bumpArchiveCreatorIdentityRevision:
UPDATE author_archive_creators
SET identity_revision = identity_revision + 1,
    last_modified_at = max(last_modified_at, :lastModifiedAt)
WHERE _id = :creatorId;

getArchiveIdentityMigrationState:
SELECT state
FROM author_archive_identity_migrations
WHERE migration_key = :migrationKey;

getArchiveIdentityMigrationComponentState:
SELECT state
FROM author_archive_identity_migration_components
WHERE migration_key = :migrationKey AND component_key = :componentKey;

upsertArchiveIdentityMigrationComponent:
INSERT INTO author_archive_identity_migration_components(
    migration_key, component_key, target_creator_id, source_creator_ids, accepted_names, state, updated_at
)
VALUES (:migrationKey, :componentKey, :targetCreatorId, :sourceCreatorIds, :acceptedNames, :state, :updatedAt)
ON CONFLICT(migration_key, component_key) DO UPDATE SET
    target_creator_id = excluded.target_creator_id,
    source_creator_ids = excluded.source_creator_ids,
    accepted_names = excluded.accepted_names,
    state = excluded.state,
    updated_at = excluded.updated_at;

upsertArchiveIdentityMigration:
INSERT INTO author_archive_identity_migrations(migration_key, state, last_error, updated_at)
VALUES (:migrationKey, :state, :lastError, :updatedAt)
ON CONFLICT(migration_key) DO UPDATE SET
    state = excluded.state,
    last_error = excluded.last_error,
    updated_at = excluded.updated_at;

insertArchiveCreator:
INSERT INTO author_archive_creators(
    portable_key,
    display_name,
    normalized_name,
    sort_name,
    status,
    merged_into_creator_id,
    needs_review,
    legacy_creator_id,
    created_at,
    last_modified_at
)
VALUES (:portableKey, :displayName, :normalizedName, :sortName, 'ACTIVE', NULL, 0, NULL, :createdAt, :lastModifiedAt);

insertArchiveCreatorForReview:
INSERT INTO author_archive_creators(
    portable_key,
    display_name,
    normalized_name,
    sort_name,
    status,
    merged_into_creator_id,
    needs_review,
    legacy_creator_id,
    created_at,
    last_modified_at
)
VALUES (
    :portableKey,
    :displayName,
    :normalizedName,
    :sortName,
    'ACTIVE',
    NULL,
    :needsReview,
    NULL,
    :createdAt,
    :lastModifiedAt
);

insertArchiveCreatorFromLegacy:
INSERT INTO author_archive_creators(
    portable_key,
    display_name,
    normalized_name,
    sort_name,
    status,
    merged_into_creator_id,
    needs_review,
    legacy_creator_id,
    created_at,
    last_modified_at
)
VALUES (
    :portableKey,
    :displayName,
    :normalizedName,
    :sortName,
    'ACTIVE',
    NULL,
    0,
    :legacyCreatorId,
    :createdAt,
    :lastModifiedAt
);

markArchiveCreatorNeedsReview:
UPDATE author_archive_creators
SET needs_review = 1,
    last_modified_at = max(last_modified_at, :lastModifiedAt)
WHERE _id = :id
AND status = 'ACTIVE';

updateArchiveCreator:
UPDATE author_archive_creators
SET display_name = :displayName,
    normalized_name = :normalizedName,
    sort_name = :sortName,
    last_modified_at = :lastModifiedAt
WHERE _id = :id
AND status = 'ACTIVE';

getArchiveCreatorIdentityRecord:
SELECT portable_key, display_name, normalized_name, sort_name, needs_review, status, merged_into_creator_id
FROM author_archive_creators
WHERE _id = :id;

resolveArchiveCreatorRootId:
WITH RECURSIVE identity_path(_id, status, merged_into_creator_id, depth) AS (
    SELECT _id, status, merged_into_creator_id, 0
    FROM author_archive_creators
    WHERE _id = :creatorId
    UNION ALL
    SELECT C._id, C.status, C.merged_into_creator_id, P.depth + 1
    FROM author_archive_creators C
    JOIN identity_path P ON C._id = P.merged_into_creator_id
    WHERE P.status = 'MERGED' AND P.depth < 100
)
SELECT _id
FROM identity_path
WHERE status = 'ACTIVE'
ORDER BY depth DESC
LIMIT 1;

getArchiveCreatorRedirects:
SELECT _id, status, merged_into_creator_id
FROM author_archive_creators
ORDER BY _id;

getArchiveCreatorsForBackup:
SELECT
    C.portable_key,
    C.display_name,
    C.normalized_name,
    C.sort_name,
    C.status,
    TARGET.portable_key AS merged_into_portable_key,
    C.needs_review
FROM author_archive_creators C
LEFT JOIN author_archive_creators TARGET ON TARGET._id = C.merged_into_creator_id
WHERE C.status IN ('ACTIVE', 'MERGED')
ORDER BY C.portable_key;

getArchiveAliasesForBackup:
SELECT
    C.portable_key AS creator_portable_key,
    A.raw_alias,
    A.normalized_alias,
    A.source,
    A.evidence,
    A.confidence,
    A.is_manual
FROM author_archive_aliases A
JOIN author_archive_creators C ON C._id = A.creator_id
WHERE C.status IN ('ACTIVE', 'MERGED')
ORDER BY C.portable_key, A.is_manual DESC, A._id;

upsertArchiveCreatorFromBackup:
INSERT INTO author_archive_creators(
    portable_key,
    display_name,
    normalized_name,
    sort_name,
    status,
    merged_into_creator_id,
    needs_review,
    legacy_creator_id,
    created_at,
    last_modified_at
)
VALUES (
    :portableKey,
    :displayName,
    :normalizedName,
    :sortName,
    'ACTIVE',
    NULL,
    :needsReview,
    NULL,
    :createdAt,
    :lastModifiedAt
)
ON CONFLICT(portable_key)
DO UPDATE SET
    needs_review = author_archive_creators.needs_review OR excluded.needs_review,
    last_modified_at = max(author_archive_creators.last_modified_at, excluded.last_modified_at);

markArchiveCreatorMergedFromBackup:
UPDATE author_archive_creators
SET status = 'MERGED',
    merged_into_creator_id = :targetCreatorId,
    needs_review = 0,
    last_modified_at = max(last_modified_at, :lastModifiedAt)
WHERE _id = :sourceCreatorId
AND status = 'ACTIVE';

getArchiveCreatorIdsByAlias:
SELECT C._id
FROM author_archive_creators C
JOIN author_archive_aliases A ON A.creator_id = C._id
WHERE A.normalized_alias = :normalizedAlias
AND C.status = 'ACTIVE'
ORDER BY C._id;

getArchiveBoundCreatorIdsByAlias:
SELECT C._id
FROM author_archive_manga_links ML
JOIN author_archive_creators C ON C._id = ML.creator_id
JOIN author_archive_identity_names N ON N.creator_id = C._id
WHERE ML.manga_id = :mangaId
AND N.name_text = :nameText COLLATE BINARY
AND C.status = 'ACTIVE'
ORDER BY
    CASE ML.origin WHEN 'USER' THEN 0 WHEN 'RESTORE' THEN 1 ELSE 2 END,
    C._id;

getArchiveCreatorIdentityOptions:
SELECT
    C._id,
    C.portable_key,
    C.display_name,
    coalesce((
        SELECT group_concat(ORDERED_ALIAS.encoded_alias, ',')
        FROM (
            SELECT hex(N.name_text) AS encoded_alias
            FROM author_archive_identity_names N
            WHERE N.creator_id = C._id
            ORDER BY N.name_text COLLATE BINARY
        ) ORDERED_ALIAS
    ), '') AS aliases,
    C.needs_review,
    EXISTS(
        SELECT 1
        FROM author_archive_manga_links CURRENT_LINK
        WHERE CURRENT_LINK.manga_id = :mangaId
        AND CURRENT_LINK.creator_id = C._id
    ) AS currently_bound
FROM author_archive_creators C
WHERE C.status = 'ACTIVE'
AND EXISTS(
    SELECT 1
    FROM author_archive_identity_names MATCHED_NAME
    WHERE MATCHED_NAME.creator_id = C._id
    AND MATCHED_NAME.name_text = :nameText COLLATE BINARY
)
ORDER BY currently_bound DESC, C.needs_review, C._id;

getArchiveAliasesForCreatorIdentity:
SELECT raw_alias, normalized_alias, source, evidence, confidence, is_manual, created_at, last_modified_at
FROM author_archive_aliases
WHERE creator_id = :creatorId
ORDER BY is_manual DESC, _id;

getArchiveManualAliases:
SELECT raw_alias
FROM author_archive_aliases
WHERE creator_id = :creatorId
AND is_manual = 1
AND source = 'USER'
AND evidence = 'manual alias'
ORDER BY _id;

deleteArchiveManualAlias:
DELETE FROM author_archive_aliases
WHERE creator_id = :creatorId
AND normalized_alias = :normalizedAlias
AND is_manual = 1
AND source = 'USER'
AND evidence = 'manual alias';

deleteArchiveAlias:
DELETE FROM author_archive_aliases
WHERE creator_id = :creatorId
AND normalized_alias = :normalizedAlias;

markArchiveCreatorMerged:
UPDATE author_archive_creators
SET status = 'MERGED',
    merged_into_creator_id = :targetCreatorId,
    needs_review = 0,
    last_modified_at = :lastModifiedAt
WHERE _id = :sourceCreatorId
AND status = 'ACTIVE';

upsertArchiveAlias:
INSERT INTO author_archive_aliases(
    creator_id,
    raw_alias,
    normalized_alias,
    source,
    evidence,
    confidence,
    is_manual,
    created_at,
    last_modified_at
)
VALUES (
    :creatorId,
    :rawAlias,
    :normalizedAlias,
    :source,
    :evidence,
    :confidence,
    :isManual,
    :createdAt,
    :lastModifiedAt
)
ON CONFLICT(creator_id, normalized_alias)
DO UPDATE SET
    raw_alias = CASE WHEN author_archive_aliases.is_manual THEN author_archive_aliases.raw_alias ELSE excluded.raw_alias END,
    source = CASE WHEN author_archive_aliases.is_manual THEN author_archive_aliases.source ELSE excluded.source END,
    evidence = CASE WHEN author_archive_aliases.is_manual THEN author_archive_aliases.evidence ELSE excluded.evidence END,
    confidence = max(author_archive_aliases.confidence, excluded.confidence),
    is_manual = author_archive_aliases.is_manual OR excluded.is_manual,
    last_modified_at = excluded.last_modified_at;

selectArchiveLastInsertedRowId:
SELECT last_insert_rowid();

upsertArchiveMangaLink:
INSERT INTO author_archive_manga_links(
    manga_id,
    creator_id,
    role,
    creator_order,
    origin,
    source_text,
    confidence,
    evidence,
    created_at,
    last_modified_at
)
VALUES (
    :mangaId,
    :creatorId,
    :role,
    :creatorOrder,
    :origin,
    :sourceText,
    :confidence,
    :evidence,
    :createdAt,
    :lastModifiedAt
)
ON CONFLICT(manga_id, creator_id)
DO UPDATE SET
    role = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_manga_links.role
        ELSE excluded.role
    END,
    creator_order = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_manga_links.creator_order
        ELSE excluded.creator_order
    END,
    origin = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_manga_links.origin
        ELSE excluded.origin
    END,
    source_text = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_manga_links.source_text
        ELSE excluded.source_text
    END,
    confidence = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_manga_links.confidence
        ELSE excluded.confidence
    END,
    evidence = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_manga_links.evidence
        ELSE excluded.evidence
    END,
    last_modified_at = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_manga_links.last_modified_at
        ELSE excluded.last_modified_at
    END;

getArchiveMangaCreatorsForCreator:
SELECT manga_id, creator_id, role, source_text, confidence, evidence
FROM author_archive_manga_links
WHERE creator_id = :creatorId
ORDER BY manga_id, creator_order;

getArchiveMangaRelationsForIdentityMerge:
SELECT manga_id, role, creator_order, origin, source_text, confidence, evidence, created_at, last_modified_at
FROM author_archive_manga_links
WHERE creator_id = :creatorId
ORDER BY manga_id, creator_order;

getArchiveMangaTitlesForCreator:
SELECT DISTINCT ML.manga_id, M.title
FROM author_archive_manga_links ML
JOIN mangas M ON M._id = ML.manga_id
WHERE ML.creator_id = :creatorId
ORDER BY ML.manga_id;

getArchiveMangaLink:
SELECT role, origin, source_text, confidence, evidence, last_modified_at
FROM author_archive_manga_links
WHERE manga_id = :mangaId
AND creator_id = :creatorId;

getArchiveMangaLinksForIndex:
SELECT creator_id, role, creator_order, origin, source_text, confidence, evidence, created_at, last_modified_at
FROM author_archive_manga_links
WHERE manga_id = :mangaId
ORDER BY creator_order, _id;

deleteArchiveMangaLink:
DELETE FROM author_archive_manga_links
WHERE manga_id = :mangaId
AND creator_id = :creatorId;

unionArchiveMangaLinkRole:
UPDATE author_archive_manga_links
SET role = CASE
    WHEN role = :incomingRole THEN role
    WHEN role = 'BOTH' OR :incomingRole = 'BOTH' THEN 'BOTH'
    WHEN (role = 'AUTHOR' AND :incomingRole = 'ARTIST') OR
         (role = 'ARTIST' AND :incomingRole = 'AUTHOR') THEN 'BOTH'
    WHEN role = 'UNKNOWN' THEN :incomingRole
    ELSE role
END
WHERE manga_id = :mangaId AND creator_id = :creatorId;

deleteAutomaticArchiveMangaLink:
DELETE FROM author_archive_manga_links
WHERE manga_id = :mangaId
AND creator_id = :creatorId
AND origin IN ('AUTOMATIC', 'MIGRATION');

deleteStaleAutomaticArchiveMangaLinks:
DELETE FROM author_archive_manga_links
WHERE origin IN ('AUTOMATIC', 'MIGRATION')
AND manga_id NOT IN (
    SELECT _id
    FROM mangas
    WHERE favorite = 1
);

getArchiveSourceWorkByKey:
SELECT *
FROM author_archive_source_works
WHERE source_id = :sourceId
AND stable_source_url = :stableSourceUrl;

getArchiveSourceWorkById:
SELECT *
FROM author_archive_source_works
WHERE _id = :id;

getArchiveSourceWorkIdByLegacyId:
SELECT _id
FROM author_archive_source_works
WHERE legacy_candidate_id = :legacyCandidateId;

getArchiveSourceWorkByManga:
SELECT *
FROM author_archive_source_works
WHERE manga_id = :mangaId
ORDER BY _id
LIMIT 1;

getSourceDateQualitySnapshot:
SELECT
    extension_package,
    extension_version,
    source_id,
    field_kind,
    status,
    strategy_version,
    sample_count,
    observed_work_count,
    stable_chapter_count,
    distinct_history_date_count,
    first_observed_at,
    last_observed_at,
    projected_date_at,
    last_reason,
    updated_at
FROM author_archive_source_date_quality
WHERE extension_package = :extensionPackage
AND extension_version = :extensionVersion
AND source_id = :sourceId
AND field_kind = :fieldKind;

getSourceDateQualityObservations:
SELECT
    extension_package,
    extension_version,
    source_id,
    field_kind,
    work_natural_key,
    chapter_natural_key,
    raw_value,
    value_at,
    precision,
    semantic_confirmed,
    observed_at,
    reason,
    network_failure
FROM author_archive_source_date_quality_samples
WHERE extension_package = :extensionPackage
AND extension_version = :extensionVersion
AND source_id = :sourceId
AND field_kind = :fieldKind
ORDER BY observed_at, _id;

deleteSourceDateQualitySamplesForKey:
DELETE FROM author_archive_source_date_quality_samples
WHERE extension_package = :extensionPackage
AND extension_version = :extensionVersion
AND source_id = :sourceId
AND field_kind = :fieldKind;

insertSourceDateQualityObservation:
INSERT INTO author_archive_source_date_quality_samples(
    extension_package,
    extension_version,
    source_id,
    field_kind,
    work_natural_key,
    chapter_natural_key,
    raw_value,
    value_at,
    precision,
    semantic_confirmed,
    observed_at,
    reason,
    network_failure
)
VALUES(
    :extensionPackage,
    :extensionVersion,
    :sourceId,
    :fieldKind,
    :workNaturalKey,
    :chapterNaturalKey,
    :rawValue,
    :valueAt,
    :precision,
    :semanticConfirmed,
    :observedAt,
    :reason,
    :networkFailure
);

upsertSourceDateQualitySnapshot:
INSERT INTO author_archive_source_date_quality(
    extension_package,
    extension_version,
    source_id,
    field_kind,
    status,
    strategy_version,
    sample_count,
    observed_work_count,
    stable_chapter_count,
    distinct_history_date_count,
    first_observed_at,
    last_observed_at,
    projected_date_at,
    last_reason,
    updated_at
)
VALUES(
    :extensionPackage,
    :extensionVersion,
    :sourceId,
    :fieldKind,
    :status,
    :strategyVersion,
    :sampleCount,
    :observedWorkCount,
    :stableChapterCount,
    :distinctHistoryDateCount,
    :firstObservedAt,
    :lastObservedAt,
    :projectedDateAt,
    :lastReason,
    :updatedAt
)
ON CONFLICT(extension_package, extension_version, source_id, field_kind) DO UPDATE SET
    status = excluded.status,
    strategy_version = excluded.strategy_version,
    sample_count = excluded.sample_count,
    observed_work_count = excluded.observed_work_count,
    stable_chapter_count = excluded.stable_chapter_count,
    distinct_history_date_count = excluded.distinct_history_date_count,
    first_observed_at = excluded.first_observed_at,
    last_observed_at = excluded.last_observed_at,
    projected_date_at = excluded.projected_date_at,
    last_reason = excluded.last_reason,
    updated_at = excluded.updated_at;

upsertSourceDateQualityCurrent:
INSERT INTO author_archive_source_date_quality_current(
    source_id,
    field_kind,
    extension_package,
    extension_version,
    updated_at
)
VALUES(
    :sourceId,
    :fieldKind,
    :extensionPackage,
    :extensionVersion,
    :updatedAt
)
ON CONFLICT(source_id, field_kind) DO UPDATE SET
    extension_package = excluded.extension_package,
    extension_version = excluded.extension_version,
    updated_at = excluded.updated_at
WHERE excluded.updated_at >= author_archive_source_date_quality_current.updated_at;

deleteSourceDateQualitySamplesBefore:
DELETE FROM author_archive_source_date_quality_samples
WHERE observed_at < :cutoff;

retainTrustedWorkPublicationDate:
UPDATE author_archive_source_works
SET published_date_snapshot_at = CASE
        WHEN published_date_snapshot_at IS NULL OR :publishedDateAt < published_date_snapshot_at
            THEN :publishedDateAt
        ELSE published_date_snapshot_at
    END,
    published_date_snapshot_basis = CASE
        WHEN published_date_snapshot_at IS NULL OR :publishedDateAt <= published_date_snapshot_at
            THEN :basis
        ELSE published_date_snapshot_basis
    END,
    published_date_snapshot_reason = CASE
        WHEN published_date_snapshot_at IS NULL OR :publishedDateAt <= published_date_snapshot_at
            THEN NULL
        ELSE published_date_snapshot_reason
    END
WHERE source_id = :sourceId AND stable_source_url = :stableSourceUrl
AND :publishedDateAt > 0;

markRetainedWorkPublicationEvidence:
UPDATE author_archive_source_works
SET published_date_snapshot_reason = CASE
        WHEN :qualityStatus = 'TRUSTED' AND published_date_snapshot_basis = :basis THEN NULL
        WHEN published_date_snapshot_basis != :basis THEN 'extension_version_changed'
        ELSE coalesce(:qualityReason, 'date_quality_downgraded')
    END
WHERE source_id = :sourceId AND published_date_snapshot_at IS NOT NULL;

restoreWorkPublicationDate:
UPDATE author_archive_source_works
SET published_date_snapshot_at = CASE
        WHEN published_date_snapshot_at IS NULL OR :publishedDateAt < published_date_snapshot_at
            THEN :publishedDateAt ELSE published_date_snapshot_at END,
    published_date_snapshot_basis = CASE
        WHEN published_date_snapshot_at IS NULL OR :publishedDateAt <= published_date_snapshot_at
            THEN :basis ELSE published_date_snapshot_basis END,
    published_date_snapshot_reason = CASE
        WHEN published_date_snapshot_at IS NULL OR :publishedDateAt <= published_date_snapshot_at
            THEN :reason ELSE published_date_snapshot_reason END
WHERE _id = :sourceWorkId AND :publishedDateAt > 0;

getArchiveSourceWorksByManga:
SELECT *
FROM author_archive_source_works
WHERE manga_id = :mangaId
ORDER BY _id;

getArchiveSourceWorksForBackup:
SELECT
    SW._id,
    SW.source_id,
    SW.stable_source_url,
    SW.title,
    SW.author_text,
    SW.artist_text,
    SW.thumbnail_url,
    SW.first_seen_at,
    SW.first_seen_date,
    SW.first_seen_zone,
    SW.catalog_chapter_count,
    SW.chapter_count_state,
    SW.latest_chapter_at,
    SW.published_date_snapshot_at,
    SW.published_date_snapshot_basis,
    SW.published_date_snapshot_reason
FROM author_archive_source_works SW
WHERE EXISTS(
    SELECT 1
    FROM author_archive_source_work_creators SWC
    WHERE SWC.source_work_id = SW._id
)
ORDER BY SW.source_id, SW.stable_source_url;

getArchiveSourceWorkBindingsForBackup:
SELECT
    SW.source_id,
    SW.stable_source_url,
    C.portable_key AS creator_portable_key,
    SWC.role,
    SWC.creator_order,
    SWC.origin,
    SWC.verification,
    SWC.source_text,
    SWC.confidence,
    SWC.evidence
FROM author_archive_source_work_creators SWC
JOIN author_archive_source_works SW ON SW._id = SWC.source_work_id
JOIN author_archive_creators C ON C._id = SWC.creator_id
WHERE C.status = 'ACTIVE'
ORDER BY SW.source_id, SW.stable_source_url, SWC.creator_order, C.portable_key;

getMangaSourceWorkSeed:
SELECT source, url, title, author, artist, thumbnail_url
FROM mangas
WHERE _id = :mangaId;

getArchiveMangaIdByNaturalKey:
SELECT _id
FROM mangas
WHERE source = :sourceId
AND trim(url) = trim(:stableSourceUrl)
LIMIT 1;

getArchiveBlankUrlMangaSeeds:
SELECT _id, url, title, author, artist
FROM mangas
WHERE source = :sourceId
AND length(trim(url)) = 0
ORDER BY _id;

insertArchiveSourceWork:
INSERT INTO author_archive_source_works(
    source_id,
    stable_source_url,
    manga_id,
    title,
    normalized_title,
    author_text,
    artist_text,
    thumbnail_url,
    first_seen_at,
    first_seen_date,
    first_seen_zone,
    last_seen_at,
    details_fetched_at,
    chapter_count_state,
    catalog_chapter_count,
    latest_chapter_at,
    legacy_candidate_id,
    legacy_review_snapshot
)
VALUES (
    :sourceId,
    :stableSourceUrl,
    :mangaId,
    :title,
    :normalizedTitle,
    :authorText,
    :artistText,
    :thumbnailUrl,
    :firstSeenAt,
    :firstSeenDate,
    :firstSeenZone,
    :lastSeenAt,
    :detailsFetchedAt,
    :chapterCountState,
    :catalogChapterCount,
    :latestChapterAt,
    NULL,
    :legacyReviewSnapshot
);

insertArchiveSourceWorkFromLegacy:
INSERT INTO author_archive_source_works(
    source_id,
    stable_source_url,
    manga_id,
    title,
    normalized_title,
    author_text,
    artist_text,
    thumbnail_url,
    first_seen_at,
    first_seen_date,
    first_seen_zone,
    last_seen_at,
    details_fetched_at,
    legacy_candidate_id,
    legacy_review_snapshot
)
VALUES (
    :sourceId,
    :stableSourceUrl,
    NULL,
    :title,
    :normalizedTitle,
    :authorText,
    :artistText,
    :thumbnailUrl,
    :firstSeenAt,
    :firstSeenDate,
    :firstSeenZone,
    :lastSeenAt,
    :detailsFetchedAt,
    :legacyCandidateId,
    :legacyReviewSnapshot
);

attachArchiveLegacyCandidateId:
UPDATE author_archive_source_works
SET legacy_candidate_id = :legacyCandidateId
WHERE _id = :id
AND legacy_candidate_id IS NULL;

updateArchiveSourceWorkFromLegacyBridge:
UPDATE author_archive_source_works
SET title = :title,
    normalized_title = :normalizedTitle,
    author_text = :authorText,
    artist_text = :artistText,
    thumbnail_url = :thumbnailUrl,
    first_seen_at = min(first_seen_at, :firstSeenAt),
    first_seen_date = CASE
        WHEN :firstSeenAt < first_seen_at THEN :firstSeenDate
        ELSE first_seen_date
    END,
    first_seen_zone = CASE
        WHEN :firstSeenAt < first_seen_at THEN :firstSeenZone
        ELSE first_seen_zone
    END,
    last_seen_at = max(last_seen_at, :lastSeenAt),
    details_fetched_at = coalesce(:detailsFetchedAt, details_fetched_at),
    legacy_candidate_id = coalesce(legacy_candidate_id, :legacyCandidateId)
WHERE _id = :id;

updateArchiveSourceWorkReviewFromLegacyBridge:
UPDATE author_archive_source_works
SET legacy_review_snapshot = CASE
        WHEN legacy_review_snapshot IN ('ACCEPTED', 'IGNORED', 'MERGED')
            AND :legacyReviewSnapshot = 'PENDING'
            THEN legacy_review_snapshot
        ELSE :legacyReviewSnapshot
    END
WHERE _id = :id;

updateArchiveSourceWorkMetadata:
UPDATE author_archive_source_works
SET manga_id = coalesce(:mangaId, manga_id),
    title = :title,
    normalized_title = :normalizedTitle,
    author_text = :authorText,
    artist_text = :artistText,
    thumbnail_url = :thumbnailUrl,
    last_seen_at = :lastSeenAt,
    details_fetched_at = coalesce(:detailsFetchedAt, details_fetched_at)
WHERE _id = :id;

updateArchiveSourceWorkCatalog:
UPDATE author_archive_source_works
SET chapter_count_state = :chapterCountState,
    catalog_chapter_count = :catalogChapterCount,
    latest_chapter_at = :latestChapterAt,
    last_seen_at = max(last_seen_at, :lastSeenAt)
WHERE source_id = :sourceId
AND (
    stable_source_url = trim(:stableSourceUrl)
    OR (
        :mangaId IS NOT NULL
        AND manga_id = :mangaId
        AND stable_source_url LIKE 'legacy-manga:%'
    )
);

restoreArchiveSourceWorkFirstSeen:
UPDATE author_archive_source_works
SET first_seen_at = :firstSeenAt,
    first_seen_date = :firstSeenDate,
    first_seen_zone = :firstSeenZone
WHERE _id = :id
AND :firstSeenAt < first_seen_at;

updateArchiveSourceWorkLegacyReviewSnapshot:
UPDATE author_archive_source_works
SET legacy_review_snapshot = CASE
        WHEN legacy_review_snapshot IN ('ACCEPTED', 'IGNORED', 'MERGED')
            AND :legacyReviewSnapshot = 'PENDING'
            THEN legacy_review_snapshot
        ELSE :legacyReviewSnapshot
    END
WHERE _id = :id;

upsertArchiveSourceWorkCreator:
INSERT INTO author_archive_source_work_creators(
    source_work_id,
    creator_id,
    role,
    creator_order,
    origin,
    verification,
    source_text,
    confidence,
    evidence,
    created_at,
    last_modified_at
)
VALUES (
    :sourceWorkId,
    :creatorId,
    :role,
    :creatorOrder,
    :origin,
    :verification,
    :sourceText,
    :confidence,
    :evidence,
    :createdAt,
    :lastModifiedAt
)
ON CONFLICT(source_work_id, creator_id)
DO UPDATE SET
    role = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_source_work_creators.role
        ELSE excluded.role
    END,
    creator_order = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_source_work_creators.creator_order
        ELSE excluded.creator_order
    END,
    origin = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_source_work_creators.origin
        ELSE excluded.origin
    END,
    verification = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_source_work_creators.verification
        ELSE excluded.verification
    END,
    source_text = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_source_work_creators.source_text
        ELSE excluded.source_text
    END,
    confidence = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_source_work_creators.confidence
        ELSE excluded.confidence
    END,
    evidence = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_source_work_creators.evidence
        ELSE excluded.evidence
    END,
    last_modified_at = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_source_work_creators.last_modified_at
        ELSE excluded.last_modified_at
    END;

getArchiveSourceWorkCreatorsForCreator:
SELECT source_work_id, creator_id, role, source_text, confidence, evidence
FROM author_archive_source_work_creators
WHERE creator_id = :creatorId
ORDER BY source_work_id, creator_order;

getArchiveSourceWorkRelationsForIdentityMerge:
SELECT source_work_id, role, creator_order, origin, verification, source_text, confidence, evidence,
       created_at, last_modified_at
FROM author_archive_source_work_creators
WHERE creator_id = :creatorId
ORDER BY source_work_id, creator_order;

getArchiveSourceWorkCreator:
SELECT role, creator_order, origin, verification, source_text, confidence, evidence
FROM author_archive_source_work_creators
WHERE source_work_id = :sourceWorkId
AND creator_id = :creatorId;

getArchiveSourceWorkCreatorsForIndex:
SELECT creator_id, role, creator_order, origin, verification, source_text, confidence, evidence, created_at, last_modified_at
FROM author_archive_source_work_creators
WHERE source_work_id = :sourceWorkId
ORDER BY creator_order, _id;

deleteArchiveSourceWorkCreator:
DELETE FROM author_archive_source_work_creators
WHERE source_work_id = :sourceWorkId
AND creator_id = :creatorId;

unionArchiveSourceWorkCreatorRole:
UPDATE author_archive_source_work_creators
SET role = CASE
    WHEN role = :incomingRole THEN role
    WHEN role = 'BOTH' OR :incomingRole = 'BOTH' THEN 'BOTH'
    WHEN (role = 'AUTHOR' AND :incomingRole = 'ARTIST') OR
         (role = 'ARTIST' AND :incomingRole = 'AUTHOR') THEN 'BOTH'
    WHEN role = 'UNKNOWN' THEN :incomingRole
    ELSE role
END
WHERE source_work_id = :sourceWorkId AND creator_id = :creatorId;

deleteAutomaticArchiveSourceWorkCreator:
DELETE FROM author_archive_source_work_creators
WHERE source_work_id = :sourceWorkId
AND creator_id = :creatorId
AND origin IN ('AUTOMATIC', 'MIGRATION');

deleteStaleAutomaticArchiveSourceWorkCreators:
DELETE FROM author_archive_source_work_creators
WHERE origin IN ('AUTOMATIC', 'MIGRATION')
AND source_work_id IN (
    SELECT SW._id
    FROM author_archive_source_works SW
    LEFT JOIN mangas M ON M._id = SW.manga_id
    WHERE SW.manga_id IS NOT NULL
    AND (M._id IS NULL OR M.favorite = 0)
);

detachArchiveSourceWorkFromManga:
UPDATE author_archive_source_works
SET manga_id = NULL
WHERE manga_id = :mangaId;

detachOtherArchiveSourceWorksFromManga:
UPDATE author_archive_source_works
SET manga_id = NULL
WHERE manga_id = :mangaId
AND (source_id != :sourceId OR stable_source_url != :stableSourceUrl);

detachStaleArchiveSourceWorksFromLibrary:
UPDATE author_archive_source_works
SET manga_id = NULL
WHERE manga_id IS NOT NULL
AND manga_id NOT IN (
    SELECT _id
    FROM mangas
    WHERE favorite = 1
);

createArchiveIndexWorkBuffer:
CREATE TEMP TABLE IF NOT EXISTS author_archive_index_work_buffer(
    manga_id INTEGER NOT NULL PRIMARY KEY,
    normalized_title TEXT NOT NULL,
    stable_source_url TEXT NOT NULL,
    indexed_at INTEGER NOT NULL
);

createArchiveIndexMentionBuffer:
CREATE TEMP TABLE IF NOT EXISTS author_archive_index_mention_buffer(
    manga_id INTEGER NOT NULL,
    normalized_title TEXT NOT NULL,
    stable_source_url TEXT NOT NULL,
    display_name TEXT NOT NULL,
    normalized_alias TEXT NOT NULL,
    role TEXT NOT NULL,
    creator_order INTEGER NOT NULL,
    source_text TEXT,
    portable_key TEXT NOT NULL,
    creator_id INTEGER,
    new_identity INTEGER NOT NULL DEFAULT 0,
    needs_review INTEGER NOT NULL DEFAULT 0,
    indexed_at INTEGER NOT NULL,
    PRIMARY KEY(manga_id, normalized_alias)
);

clearArchiveIndexWorkBuffer:
DELETE FROM author_archive_index_work_buffer;

clearArchiveIndexMentionBuffer:
DELETE FROM author_archive_index_mention_buffer;

insertArchiveIndexWorkBuffer:
INSERT INTO author_archive_index_work_buffer(
    manga_id,
    normalized_title,
    stable_source_url,
    indexed_at
)
VALUES (
    :mangaId,
    :normalizedTitle,
    :stableSourceUrl,
    :indexedAt
);

insertArchiveIndexMentionBuffer:
INSERT INTO author_archive_index_mention_buffer(
    manga_id,
    normalized_title,
    stable_source_url,
    display_name,
    normalized_alias,
    role,
    creator_order,
    source_text,
    portable_key,
    indexed_at
)
VALUES (
    :mangaId,
    :normalizedTitle,
    :stableSourceUrl,
    :displayName,
    :normalizedAlias,
    :role,
    :creatorOrder,
    :sourceText,
    :portableKey,
    :indexedAt
);

insertArchiveIndexWorkPayload:
WITH RECURSIVE
payload_records(row_number, record, remainder) AS (
    SELECT 0, '', :payload || char(30)
    UNION ALL
    SELECT
        row_number + 1,
        substr(remainder, 1, instr(remainder, char(30)) - 1),
        substr(remainder, instr(remainder, char(30)) + 1)
    FROM payload_records
    WHERE length(remainder) > 0
),
payload_fields(row_number, field_number, value, remainder) AS (
    SELECT row_number, 0, '', record || char(31)
    FROM payload_records
    WHERE row_number > 0
    UNION ALL
    SELECT
        row_number,
        field_number + 1,
        substr(remainder, 1, instr(remainder, char(31)) - 1),
        substr(remainder, instr(remainder, char(31)) + 1)
    FROM payload_fields
    WHERE length(remainder) > 0
),
payload_rows AS (
    SELECT
        row_number,
        max(CASE WHEN field_number = 1 THEN value END) AS manga_id,
        max(CASE WHEN field_number = 2 THEN value END) AS normalized_title,
        max(CASE WHEN field_number = 3 THEN value END) AS stable_source_url,
        max(CASE WHEN field_number = 4 THEN value END) AS indexed_at
    FROM payload_fields
    GROUP BY row_number
)
INSERT INTO author_archive_index_work_buffer(manga_id, normalized_title, stable_source_url, indexed_at)
SELECT
    manga_id,
    replace(
        replace(
            replace(
                replace(normalized_title, '%00', char(0)),
                '%1E',
                char(30)
            ),
            '%1F',
            char(31)
        ),
        '%25',
        '%'
    ),
    replace(replace(replace(replace(stable_source_url, '%00', char(0)), '%1E', char(30)), '%1F', char(31)), '%25', '%'),
    indexed_at
FROM payload_rows;

insertArchiveIndexMentionPayload:
WITH RECURSIVE
payload_records(row_number, record, remainder) AS (
    SELECT 0, '', :payload || char(30)
    UNION ALL
    SELECT
        row_number + 1,
        substr(remainder, 1, instr(remainder, char(30)) - 1),
        substr(remainder, instr(remainder, char(30)) + 1)
    FROM payload_records
    WHERE length(remainder) > 0
),
payload_fields(row_number, field_number, value, remainder) AS (
    SELECT row_number, 0, '', record || char(31)
    FROM payload_records
    WHERE row_number > 0
    UNION ALL
    SELECT
        row_number,
        field_number + 1,
        substr(remainder, 1, instr(remainder, char(31)) - 1),
        substr(remainder, instr(remainder, char(31)) + 1)
    FROM payload_fields
    WHERE length(remainder) > 0
),
payload_rows AS (
    SELECT
        row_number,
        max(CASE WHEN field_number = 1 THEN value END) AS manga_id,
        max(CASE WHEN field_number = 2 THEN value END) AS normalized_title,
        max(CASE WHEN field_number = 3 THEN value END) AS stable_source_url,
        max(CASE WHEN field_number = 4 THEN value END) AS display_name,
        max(CASE WHEN field_number = 5 THEN value END) AS normalized_alias,
        max(CASE WHEN field_number = 6 THEN value END) AS role,
        max(CASE WHEN field_number = 7 THEN value END) AS creator_order,
        max(CASE WHEN field_number = 8 THEN value END) AS source_text,
        max(CASE WHEN field_number = 9 THEN value END) AS portable_key,
        max(CASE WHEN field_number = 10 THEN value END) AS indexed_at
    FROM payload_fields
    GROUP BY row_number
)
INSERT INTO author_archive_index_mention_buffer(
    manga_id,
    normalized_title,
    stable_source_url,
    display_name,
    normalized_alias,
    role,
    creator_order,
    source_text,
    portable_key,
    indexed_at
)
SELECT
    manga_id,
    replace(replace(replace(replace(normalized_title, '%00', char(0)), '%1E', char(30)), '%1F', char(31)), '%25', '%'),
    replace(replace(replace(replace(stable_source_url, '%00', char(0)), '%1E', char(30)), '%1F', char(31)), '%25', '%'),
    replace(replace(replace(replace(display_name, '%00', char(0)), '%1E', char(30)), '%1F', char(31)), '%25', '%'),
    replace(replace(replace(replace(normalized_alias, '%00', char(0)), '%1E', char(30)), '%1F', char(31)), '%25', '%'),
    role,
    creator_order,
    replace(replace(replace(replace(source_text, '%00', char(0)), '%1E', char(30)), '%1F', char(31)), '%25', '%'),
    replace(replace(replace(replace(portable_key, '%00', char(0)), '%1E', char(30)), '%1F', char(31)), '%25', '%'),
    indexed_at
FROM payload_rows;

resolveArchiveIndexUniqueCurrentBindings:
UPDATE author_archive_index_mention_buffer
SET creator_id = (
    SELECT min(ML.creator_id)
    FROM author_archive_manga_links ML
    JOIN author_archive_creators C ON C._id = ML.creator_id
    JOIN author_archive_aliases A ON A.creator_id = C._id
    WHERE ML.manga_id = author_archive_index_mention_buffer.manga_id
    AND A.normalized_alias = author_archive_index_mention_buffer.normalized_alias
    AND C.status = 'ACTIVE'
)
WHERE creator_id IS NULL
AND 1 = (
    SELECT count(DISTINCT ML.creator_id)
    FROM author_archive_manga_links ML
    JOIN author_archive_creators C ON C._id = ML.creator_id
    JOIN author_archive_aliases A ON A.creator_id = C._id
    WHERE ML.manga_id = author_archive_index_mention_buffer.manga_id
    AND A.normalized_alias = author_archive_index_mention_buffer.normalized_alias
    AND C.status = 'ACTIVE'
);

resolveArchiveIndexProtectedCurrentBindings:
UPDATE author_archive_index_mention_buffer
SET creator_id = (
    SELECT min(ML.creator_id)
    FROM author_archive_manga_links ML
    JOIN author_archive_creators C ON C._id = ML.creator_id
    JOIN author_archive_aliases A ON A.creator_id = C._id
    WHERE ML.manga_id = author_archive_index_mention_buffer.manga_id
    AND A.normalized_alias = author_archive_index_mention_buffer.normalized_alias
    AND C.status = 'ACTIVE'
    AND ML.origin IN ('USER', 'RESTORE')
)
WHERE creator_id IS NULL
AND 1 = (
    SELECT count(DISTINCT ML.creator_id)
    FROM author_archive_manga_links ML
    JOIN author_archive_creators C ON C._id = ML.creator_id
    JOIN author_archive_aliases A ON A.creator_id = C._id
    WHERE ML.manga_id = author_archive_index_mention_buffer.manga_id
    AND A.normalized_alias = author_archive_index_mention_buffer.normalized_alias
    AND C.status = 'ACTIVE'
    AND ML.origin IN ('USER', 'RESTORE')
);

markArchiveIndexAmbiguousExistingCreators:
UPDATE author_archive_creators
SET needs_review = 1,
    last_modified_at = (
        SELECT max(B.indexed_at)
        FROM author_archive_index_mention_buffer B
        JOIN author_archive_aliases A ON A.normalized_alias = B.normalized_alias
        WHERE B.creator_id IS NULL
        AND A.creator_id = author_archive_creators._id
    )
WHERE status = 'ACTIVE'
AND EXISTS (
    SELECT 1
    FROM author_archive_index_mention_buffer B
    JOIN author_archive_aliases A ON A.normalized_alias = B.normalized_alias
    WHERE B.creator_id IS NULL
    AND A.creator_id = author_archive_creators._id
);

markArchiveIndexNewIdentities:
UPDATE author_archive_index_mention_buffer
SET new_identity = 1
WHERE creator_id IS NULL;

markArchiveIndexNewIdentityReviews:
UPDATE author_archive_index_mention_buffer
SET needs_review = 1
WHERE new_identity = 1
AND normalized_alias IN (
    SELECT A.normalized_alias
    FROM author_archive_aliases A
    JOIN author_archive_creators C ON C._id = A.creator_id
    WHERE C.status = 'ACTIVE'
    UNION
    SELECT normalized_alias
    FROM author_archive_index_mention_buffer
    WHERE new_identity = 1
    GROUP BY normalized_alias
    HAVING count(*) > 1
);

insertArchiveIndexCreators:
INSERT INTO author_archive_creators(
    portable_key,
    display_name,
    normalized_name,
    sort_name,
    status,
    merged_into_creator_id,
    needs_review,
    legacy_creator_id,
    created_at,
    last_modified_at
)
SELECT
    B.portable_key,
    B.display_name,
    B.normalized_alias,
    B.display_name,
    'ACTIVE',
    NULL,
    B.needs_review,
    NULL,
    B.indexed_at,
    B.indexed_at
FROM author_archive_index_mention_buffer B
WHERE B.new_identity = 1;

resolveArchiveIndexNewCreatorIds:
UPDATE author_archive_index_mention_buffer
SET creator_id = (
    SELECT C._id
    FROM author_archive_creators C
    WHERE C.portable_key = author_archive_index_mention_buffer.portable_key
)
WHERE new_identity = 1;

insertArchiveIndexAliases:
INSERT INTO author_archive_aliases(
    creator_id,
    raw_alias,
    normalized_alias,
    source,
    evidence,
    confidence,
    is_manual,
    created_at,
    last_modified_at
)
SELECT
    B.creator_id,
    B.display_name,
    B.normalized_alias,
    'BIBLIOGRAPHY',
    'library-index:v1',
    1.0,
    0,
    B.indexed_at,
    B.indexed_at
FROM author_archive_index_mention_buffer B
WHERE B.new_identity = 1;

upsertArchiveIndexSourceWorks:
INSERT INTO author_archive_source_works(
    source_id,
    stable_source_url,
    manga_id,
    title,
    normalized_title,
    author_text,
    artist_text,
    thumbnail_url,
    first_seen_at,
    first_seen_date,
    first_seen_zone,
    last_seen_at,
    details_fetched_at,
    chapter_count_state,
    catalog_chapter_count,
    latest_chapter_at,
    legacy_candidate_id,
    legacy_review_snapshot
)
SELECT
    M.source,
    B.stable_source_url,
    M._id,
    CASE
        WHEN length(trim(M.title)) = 0 THEN 'Untitled ' || M._id
        ELSE M.title
    END,
    B.normalized_title,
    M.author,
    M.artist,
    M.thumbnail_url,
    B.indexed_at,
    CASE
        WHEN B.indexed_at > 0 THEN strftime('%Y-%m-%d', B.indexed_at / 1000, 'unixepoch')
        ELSE ''
    END,
    'UTC',
    B.indexed_at,
    CASE WHEN M.last_modified_at > 0 THEN M.last_modified_at ELSE NULL END,
    'UNKNOWN',
    0,
    NULL,
    NULL,
    NULL
FROM (
    SELECT
        manga_id,
        max(normalized_title) AS normalized_title,
        max(stable_source_url) AS stable_source_url,
        max(indexed_at) AS indexed_at
    FROM author_archive_index_mention_buffer
    GROUP BY manga_id
    UNION ALL
    SELECT
        manga_id,
        normalized_title,
        stable_source_url,
        indexed_at
    FROM author_archive_index_work_buffer
) B
JOIN mangas M ON M._id = B.manga_id
WHERE 1 = 1
ON CONFLICT(source_id, stable_source_url)
DO UPDATE SET
    manga_id = excluded.manga_id,
    title = excluded.title,
    normalized_title = excluded.normalized_title,
    author_text = excluded.author_text,
    artist_text = excluded.artist_text,
    thumbnail_url = excluded.thumbnail_url,
    last_seen_at = excluded.last_seen_at,
    details_fetched_at = coalesce(excluded.details_fetched_at, author_archive_source_works.details_fetched_at);

detachStaleArchiveIndexSourceWorks:
UPDATE author_archive_source_works
SET manga_id = NULL
WHERE manga_id IN (
    SELECT manga_id FROM author_archive_index_mention_buffer
    UNION
    SELECT manga_id FROM author_archive_index_work_buffer
)
AND NOT EXISTS (
    SELECT 1
    FROM (
        SELECT manga_id, stable_source_url FROM author_archive_index_mention_buffer
        UNION
        SELECT manga_id, stable_source_url FROM author_archive_index_work_buffer
    ) B
    JOIN mangas M ON M._id = B.manga_id
    WHERE B.manga_id = author_archive_source_works.manga_id
    AND B.stable_source_url = author_archive_source_works.stable_source_url
    AND M.source = author_archive_source_works.source_id
);

upsertArchiveIndexMangaLinks:
INSERT INTO author_archive_manga_links(
    manga_id,
    creator_id,
    role,
    creator_order,
    origin,
    source_text,
    confidence,
    evidence,
    created_at,
    last_modified_at
)
SELECT
    B.manga_id,
    B.creator_id,
    B.role,
    B.creator_order,
    'AUTOMATIC',
    B.source_text,
    1.0,
    'library-index:v1',
    B.indexed_at,
    B.indexed_at
FROM author_archive_index_mention_buffer B
WHERE B.creator_id IS NOT NULL
ON CONFLICT(manga_id, creator_id)
DO UPDATE SET
    role = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') THEN author_archive_manga_links.role
        ELSE excluded.role
    END,
    creator_order = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') THEN author_archive_manga_links.creator_order
        ELSE excluded.creator_order
    END,
    origin = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') THEN author_archive_manga_links.origin
        ELSE excluded.origin
    END,
    source_text = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') THEN author_archive_manga_links.source_text
        ELSE excluded.source_text
    END,
    confidence = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') THEN author_archive_manga_links.confidence
        ELSE excluded.confidence
    END,
    evidence = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') THEN author_archive_manga_links.evidence
        ELSE excluded.evidence
    END,
    last_modified_at = CASE
        WHEN author_archive_manga_links.origin IN ('USER', 'RESTORE') THEN author_archive_manga_links.last_modified_at
        ELSE excluded.last_modified_at
    END;

upsertArchiveIndexSourceWorkCreators:
INSERT INTO author_archive_source_work_creators(
    source_work_id,
    creator_id,
    role,
    creator_order,
    origin,
    verification,
    source_text,
    confidence,
    evidence,
    created_at,
    last_modified_at
)
SELECT
    SW._id,
    B.creator_id,
    B.role,
    B.creator_order,
    'AUTOMATIC',
    'VERIFIED',
    B.source_text,
    1.0,
    'library-index:v1',
    B.indexed_at,
    B.indexed_at
FROM author_archive_index_mention_buffer B
JOIN mangas M ON M._id = B.manga_id
JOIN author_archive_source_works SW
    ON SW.source_id = M.source
    AND SW.stable_source_url = B.stable_source_url
WHERE B.creator_id IS NOT NULL
ON CONFLICT(source_work_id, creator_id)
DO UPDATE SET
    role = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE')
            THEN author_archive_source_work_creators.role
        ELSE excluded.role
    END,
    creator_order = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE')
            THEN author_archive_source_work_creators.creator_order
        ELSE excluded.creator_order
    END,
    origin = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE')
            THEN author_archive_source_work_creators.origin
        ELSE excluded.origin
    END,
    verification = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE')
            THEN author_archive_source_work_creators.verification
        ELSE excluded.verification
    END,
    source_text = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE')
            THEN author_archive_source_work_creators.source_text
        ELSE excluded.source_text
    END,
    confidence = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE')
            THEN author_archive_source_work_creators.confidence
        ELSE excluded.confidence
    END,
    evidence = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE')
            THEN author_archive_source_work_creators.evidence
        ELSE excluded.evidence
    END,
    last_modified_at = CASE
        WHEN author_archive_source_work_creators.origin IN ('USER', 'RESTORE')
            THEN author_archive_source_work_creators.last_modified_at
        ELSE excluded.last_modified_at
    END;

deleteStaleArchiveIndexMangaLinks:
DELETE FROM author_archive_manga_links
WHERE origin IN ('AUTOMATIC', 'MIGRATION')
AND manga_id IN (
    SELECT manga_id FROM author_archive_index_mention_buffer
    UNION
    SELECT manga_id FROM author_archive_index_work_buffer
)
AND NOT EXISTS (
    SELECT 1
    FROM author_archive_index_mention_buffer B
    WHERE B.manga_id = author_archive_manga_links.manga_id
    AND B.creator_id = author_archive_manga_links.creator_id
);

deleteStaleArchiveIndexSourceWorkCreators:
DELETE FROM author_archive_source_work_creators
WHERE origin IN ('AUTOMATIC', 'MIGRATION')
AND source_work_id IN (
    SELECT _id
    FROM author_archive_source_works
    WHERE manga_id IN (
        SELECT manga_id FROM author_archive_index_mention_buffer
        UNION
        SELECT manga_id FROM author_archive_index_work_buffer
    )
)
AND NOT EXISTS (
    SELECT 1
    FROM author_archive_index_mention_buffer B
    JOIN author_archive_source_works SW ON SW.manga_id = B.manga_id
    WHERE SW._id = author_archive_source_work_creators.source_work_id
    AND B.creator_id = author_archive_source_work_creators.creator_id
);

getArchiveCandidatesForCreator:
SELECT
    SW._id,
    SW.source_id,
    SW.stable_source_url,
    SW.title,
    SW.normalized_title,
    SW.author_text,
    SW.artist_text,
    coalesce((
        SELECT LA.language_tag
        FROM author_archive_language_assertions LA
        WHERE LA.subject_type = 'SOURCE_WORK'
        AND LA.subject_key = 'source:' || SW.source_id || ':' || SW.stable_source_url
        AND LA.dimension = 'READING'
        AND LA.withdrawn = 0
        ORDER BY
            CASE LA.evidence_kind
                WHEN 'MANUAL' THEN 5
                WHEN 'STRUCTURED_METADATA' THEN 4
                WHEN 'SOURCE_FILTER_OR_TAG' THEN 3
                WHEN 'SINGLE_LANGUAGE_SOURCE' THEN 2
                WHEN 'TEXT_DETECTION' THEN 1
                ELSE 0
            END DESC,
            LA.confidence DESC,
            LA.asserted_at DESC
        LIMIT 1
    ), 'und') AS language_tag,
    coalesce((
        SELECT LA.confidence
        FROM author_archive_language_assertions LA
        WHERE LA.subject_type = 'SOURCE_WORK'
        AND LA.subject_key = 'source:' || SW.source_id || ':' || SW.stable_source_url
        AND LA.dimension = 'READING'
        AND LA.withdrawn = 0
        ORDER BY
            CASE LA.evidence_kind
                WHEN 'MANUAL' THEN 5
                WHEN 'STRUCTURED_METADATA' THEN 4
                WHEN 'SOURCE_FILTER_OR_TAG' THEN 3
                WHEN 'SINGLE_LANGUAGE_SOURCE' THEN 2
                WHEN 'TEXT_DETECTION' THEN 1
                ELSE 0
            END DESC,
            LA.confidence DESC,
            LA.asserted_at DESC
        LIMIT 1
    ), 0.0) AS language_confidence,
    coalesce((
        SELECT LA.evidence_kind
        FROM author_archive_language_assertions LA
        WHERE LA.subject_type = 'SOURCE_WORK'
        AND LA.subject_key = 'source:' || SW.source_id || ':' || SW.stable_source_url
        AND LA.dimension = 'READING'
        AND LA.withdrawn = 0
        ORDER BY
            CASE LA.evidence_kind
                WHEN 'MANUAL' THEN 5
                WHEN 'STRUCTURED_METADATA' THEN 4
                WHEN 'SOURCE_FILTER_OR_TAG' THEN 3
                WHEN 'SINGLE_LANGUAGE_SOURCE' THEN 2
                WHEN 'TEXT_DETECTION' THEN 1
                ELSE 0
            END DESC,
            LA.confidence DESC,
            LA.asserted_at DESC
        LIMIT 1
    ), 'UNKNOWN') AS language_evidence,
    SW.thumbnail_url,
    SW.first_seen_at,
    SW.last_seen_at,
    SW.details_fetched_at,
    coalesce(SW.legacy_review_snapshot, 'PENDING') AS review_state
FROM author_archive_source_works SW
WHERE SW._id = :sourceWorkId
OR SW._id IN (
    SELECT SWC.source_work_id
    FROM author_archive_source_work_creators SWC
    WHERE :creatorId IS NOT NULL
    AND SWC.creator_id = :creatorId
)
ORDER BY SW.first_seen_at DESC, SW._id
LIMIT :limit;

upsertArchiveWatch:
INSERT INTO author_archive_watches(
    creator_id,
    enabled,
    period_millis,
    lease_owner,
    lease_expires_at,
    last_checked_at,
    last_success_at,
    last_error,
    created_at,
    last_modified_at
)
VALUES (:creatorId, 1, :periodMillis, NULL, NULL, NULL, NULL, NULL, :createdAt, :lastModifiedAt)
ON CONFLICT(creator_id)
DO UPDATE SET
    enabled = 1,
    last_error = NULL,
    last_modified_at = excluded.last_modified_at;

upsertArchiveWatchFromLegacy:
INSERT INTO author_archive_watches(
    creator_id,
    enabled,
    period_millis,
    lease_owner,
    lease_expires_at,
    last_checked_at,
    last_success_at,
    last_error,
    created_at,
    last_modified_at
)
VALUES (
    :creatorId,
    :enabled,
    :periodMillis,
    NULL,
    NULL,
    :lastCheckedAt,
    :lastSuccessAt,
    :lastError,
    :createdAt,
    :lastModifiedAt
)
ON CONFLICT(creator_id)
DO UPDATE SET
    enabled = excluded.enabled,
    last_checked_at = excluded.last_checked_at,
    last_success_at = excluded.last_success_at,
    last_error = excluded.last_error,
    last_modified_at = excluded.last_modified_at;

getArchiveWatchIdByCreator:
SELECT _id
FROM author_archive_watches
WHERE creator_id = :creatorId;

reassignArchiveWatchCreator:
UPDATE author_archive_watches
SET creator_id = :targetCreatorId,
    lease_owner = NULL,
    lease_expires_at = NULL,
    last_modified_at = max(last_modified_at, :lastModifiedAt)
WHERE _id = :sourceWatchId;

mergeArchiveWatchRoot:
UPDATE author_archive_watches
SET enabled = max(enabled, (SELECT enabled FROM author_archive_watches WHERE _id = :sourceWatchId)),
    period_millis = min(period_millis, (SELECT period_millis FROM author_archive_watches WHERE _id = :sourceWatchId)),
    lease_owner = NULL,
    lease_expires_at = NULL,
    last_checked_at = CASE
        WHEN last_checked_at IS NULL THEN (SELECT last_checked_at FROM author_archive_watches WHERE _id = :sourceWatchId)
        WHEN (SELECT last_checked_at FROM author_archive_watches WHERE _id = :sourceWatchId) IS NULL THEN last_checked_at
        ELSE max(last_checked_at, (SELECT last_checked_at FROM author_archive_watches WHERE _id = :sourceWatchId))
    END,
    last_success_at = CASE
        WHEN last_success_at IS NULL THEN (SELECT last_success_at FROM author_archive_watches WHERE _id = :sourceWatchId)
        WHEN (SELECT last_success_at FROM author_archive_watches WHERE _id = :sourceWatchId) IS NULL THEN last_success_at
        ELSE max(last_success_at, (SELECT last_success_at FROM author_archive_watches WHERE _id = :sourceWatchId))
    END,
    last_error = CASE
        WHEN (SELECT last_modified_at FROM author_archive_watches WHERE _id = :sourceWatchId) > last_modified_at
            THEN (SELECT last_error FROM author_archive_watches WHERE _id = :sourceWatchId)
        ELSE last_error
    END,
    created_at = min(created_at, (SELECT created_at FROM author_archive_watches WHERE _id = :sourceWatchId)),
    last_modified_at = max(last_modified_at, (SELECT last_modified_at FROM author_archive_watches WHERE _id = :sourceWatchId), :lastModifiedAt)
WHERE _id = :targetWatchId;

mergeArchiveWatchSources:
INSERT INTO author_archive_watch_sources(
    watch_id,
    source_id,
    baseline_state,
    baseline_generation,
    next_due_at,
    created_at,
    last_modified_at
)
SELECT
    :targetWatchId,
    source_id,
    baseline_state,
    baseline_generation,
    next_due_at,
    created_at,
    last_modified_at
FROM author_archive_watch_sources
WHERE watch_id = :sourceWatchId
ON CONFLICT(watch_id, source_id)
DO UPDATE SET
    baseline_state = CASE
        WHEN author_archive_watch_sources.baseline_state = 'BASELINED' OR excluded.baseline_state = 'BASELINED'
            THEN 'BASELINED'
        ELSE 'NEEDS_BASELINE'
    END,
    baseline_generation = max(author_archive_watch_sources.baseline_generation, excluded.baseline_generation),
    next_due_at = CASE
        WHEN author_archive_watch_sources.next_due_at IS NULL THEN excluded.next_due_at
        WHEN excluded.next_due_at IS NULL THEN author_archive_watch_sources.next_due_at
        ELSE min(author_archive_watch_sources.next_due_at, excluded.next_due_at)
    END,
    created_at = min(author_archive_watch_sources.created_at, excluded.created_at),
    last_modified_at = max(author_archive_watch_sources.last_modified_at, excluded.last_modified_at);

mergeArchiveWatchPolicy:
INSERT INTO author_archive_watch_result_policies(
    watch_id,
    include_probable,
    include_unknown,
    notify_probable,
    notify_unknown,
    created_at,
    last_modified_at
)
SELECT
    :targetWatchId,
    include_probable,
    include_unknown,
    notify_probable,
    notify_unknown,
    created_at,
    last_modified_at
FROM author_archive_watch_result_policies
WHERE watch_id = :sourceWatchId
ON CONFLICT(watch_id)
DO UPDATE SET
    include_probable = max(author_archive_watch_result_policies.include_probable, excluded.include_probable),
    include_unknown = max(author_archive_watch_result_policies.include_unknown, excluded.include_unknown),
    notify_probable = max(author_archive_watch_result_policies.notify_probable, excluded.notify_probable),
    notify_unknown = max(author_archive_watch_result_policies.notify_unknown, excluded.notify_unknown),
    created_at = min(author_archive_watch_result_policies.created_at, excluded.created_at),
    last_modified_at = max(author_archive_watch_result_policies.last_modified_at, excluded.last_modified_at);

mergeArchiveWatchLanguages:
INSERT INTO author_archive_watch_languages(policy_id, language_tag)
SELECT :targetPolicyId, WL.language_tag
FROM author_archive_watch_result_policies WP
JOIN author_archive_watch_languages WL ON WL.policy_id = WP._id
WHERE WP.watch_id = :sourceWatchId
ON CONFLICT(policy_id, language_tag) DO NOTHING;

moveArchiveWatchRuns:
UPDATE author_archive_runs
SET watch_id = :targetWatchId
WHERE watch_id = :sourceWatchId;

mergeArchiveSourceCheckpoints:
INSERT INTO author_archive_source_checkpoints(
    watch_id,
    source_id,
    cursor,
    result_state,
    consecutive_failures,
    backoff_until,
    last_checked_at,
    last_success_at,
    error_code,
    error_message
)
SELECT
    :targetWatchId,
    source_id,
    cursor,
    result_state,
    consecutive_failures,
    backoff_until,
    last_checked_at,
    last_success_at,
    error_code,
    error_message
FROM author_archive_source_checkpoints
WHERE watch_id = :sourceWatchId
ON CONFLICT(watch_id, source_id)
DO UPDATE SET
    cursor = CASE
        WHEN coalesce(excluded.last_checked_at, -1) >= coalesce(author_archive_source_checkpoints.last_checked_at, -1)
            THEN excluded.cursor ELSE author_archive_source_checkpoints.cursor
    END,
    result_state = CASE
        WHEN coalesce(excluded.last_checked_at, -1) >= coalesce(author_archive_source_checkpoints.last_checked_at, -1)
            THEN excluded.result_state ELSE author_archive_source_checkpoints.result_state
    END,
    consecutive_failures = CASE
        WHEN coalesce(excluded.last_checked_at, -1) >= coalesce(author_archive_source_checkpoints.last_checked_at, -1)
            THEN excluded.consecutive_failures ELSE author_archive_source_checkpoints.consecutive_failures
    END,
    backoff_until = CASE
        WHEN coalesce(excluded.last_checked_at, -1) >= coalesce(author_archive_source_checkpoints.last_checked_at, -1)
            THEN excluded.backoff_until ELSE author_archive_source_checkpoints.backoff_until
    END,
    last_checked_at = CASE
        WHEN author_archive_source_checkpoints.last_checked_at IS NULL THEN excluded.last_checked_at
        WHEN excluded.last_checked_at IS NULL THEN author_archive_source_checkpoints.last_checked_at
        ELSE max(author_archive_source_checkpoints.last_checked_at, excluded.last_checked_at)
    END,
    last_success_at = CASE
        WHEN author_archive_source_checkpoints.last_success_at IS NULL THEN excluded.last_success_at
        WHEN excluded.last_success_at IS NULL THEN author_archive_source_checkpoints.last_success_at
        ELSE max(author_archive_source_checkpoints.last_success_at, excluded.last_success_at)
    END,
    error_code = CASE
        WHEN coalesce(excluded.last_checked_at, -1) >= coalesce(author_archive_source_checkpoints.last_checked_at, -1)
            THEN excluded.error_code ELSE author_archive_source_checkpoints.error_code
    END,
    error_message = CASE
        WHEN coalesce(excluded.last_checked_at, -1) >= coalesce(author_archive_source_checkpoints.last_checked_at, -1)
            THEN excluded.error_message ELSE author_archive_source_checkpoints.error_message
    END;

mergeArchiveDuplicateDiscoveries:
UPDATE author_archive_discoveries
SET kind = CASE
        WHEN kind = 'NEW_WORK_CANDIDATE' OR (
            SELECT kind FROM author_archive_discoveries SD
            WHERE SD.watch_id = :sourceWatchId
            AND SD.source_work_id = author_archive_discoveries.source_work_id
        ) = 'NEW_WORK_CANDIDATE' THEN 'NEW_WORK_CANDIDATE'
        ELSE 'NEW_SOURCE_VERSION'
    END,
    reason = CASE
        WHEN reason = (
            SELECT reason FROM author_archive_discoveries SD
            WHERE SD.watch_id = :sourceWatchId
            AND SD.source_work_id = author_archive_discoveries.source_work_id
        ) THEN reason
        ELSE reason || char(10) || (
            SELECT reason FROM author_archive_discoveries SD
            WHERE SD.watch_id = :sourceWatchId
            AND SD.source_work_id = author_archive_discoveries.source_work_id
        )
    END,
    baseline_generation = max(baseline_generation, (
        SELECT baseline_generation FROM author_archive_discoveries SD
        WHERE SD.watch_id = :sourceWatchId
        AND SD.source_work_id = author_archive_discoveries.source_work_id
    )),
    read_state = CASE
        WHEN read_state = 'UNSEEN' OR (
            SELECT read_state FROM author_archive_discoveries SD
            WHERE SD.watch_id = :sourceWatchId
            AND SD.source_work_id = author_archive_discoveries.source_work_id
        ) = 'UNSEEN' THEN 'UNSEEN'
        ELSE 'SEEN'
    END,
    review_disposition = CASE
        WHEN review_disposition = 'PENDING' OR (
            SELECT review_disposition FROM author_archive_discoveries SD
            WHERE SD.watch_id = :sourceWatchId
            AND SD.source_work_id = author_archive_discoveries.source_work_id
        ) = 'PENDING' THEN 'PENDING'
        WHEN review_disposition = 'ACCEPTED' OR (
            SELECT review_disposition FROM author_archive_discoveries SD
            WHERE SD.watch_id = :sourceWatchId
            AND SD.source_work_id = author_archive_discoveries.source_work_id
        ) = 'ACCEPTED' THEN 'ACCEPTED'
        ELSE 'IGNORED'
    END,
    first_discovered_at = min(first_discovered_at, (
        SELECT first_discovered_at FROM author_archive_discoveries SD
        WHERE SD.watch_id = :sourceWatchId
        AND SD.source_work_id = author_archive_discoveries.source_work_id
    )),
    last_modified_at = max(last_modified_at, (
        SELECT last_modified_at FROM author_archive_discoveries SD
        WHERE SD.watch_id = :sourceWatchId
        AND SD.source_work_id = author_archive_discoveries.source_work_id
    ))
WHERE watch_id = :targetWatchId
AND EXISTS(
    SELECT 1 FROM author_archive_discoveries SD
    WHERE SD.watch_id = :sourceWatchId
    AND SD.source_work_id = author_archive_discoveries.source_work_id
);

repointArchiveDuplicateDiscoveryOutbox:
UPDATE author_archive_notification_outbox
SET discovery_id = (
    SELECT TD._id
    FROM author_archive_discoveries SD
    JOIN author_archive_discoveries TD ON TD.source_work_id = SD.source_work_id
    WHERE SD._id = author_archive_notification_outbox.discovery_id
    AND SD.watch_id = :sourceWatchId
    AND TD.watch_id = :targetWatchId
)
WHERE discovery_id IN (
    SELECT SD._id
    FROM author_archive_discoveries SD
    JOIN author_archive_discoveries TD ON TD.source_work_id = SD.source_work_id
    WHERE SD.watch_id = :sourceWatchId
    AND TD.watch_id = :targetWatchId
);

deleteArchiveDuplicateDiscoveries:
DELETE FROM author_archive_discoveries
WHERE watch_id = :sourceWatchId
AND EXISTS(
    SELECT 1
    FROM author_archive_discoveries TD
    WHERE TD.watch_id = :targetWatchId
    AND TD.source_work_id = author_archive_discoveries.source_work_id
);

moveArchiveWatchDiscoveries:
UPDATE author_archive_discoveries
SET watch_id = :targetWatchId
WHERE watch_id = :sourceWatchId;

moveArchiveDiscoveriesForSourceWorks:
UPDATE author_archive_discoveries
SET watch_id = :targetWatchId
WHERE watch_id = :sourceWatchId
AND source_work_id IN :sourceWorkIds;

deleteArchiveWatchById:
DELETE FROM author_archive_watches
WHERE _id = :watchId;

insertArchiveSplitWatch:
INSERT INTO author_archive_watches(
    creator_id,
    enabled,
    period_millis,
    lease_owner,
    lease_expires_at,
    last_checked_at,
    last_success_at,
    last_error,
    created_at,
    last_modified_at
)
SELECT
    :targetCreatorId,
    enabled,
    period_millis,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    :createdAt,
    :lastModifiedAt
FROM author_archive_watches
WHERE _id = :sourceWatchId;

insertArchiveSplitWatchSources:
INSERT INTO author_archive_watch_sources(
    watch_id,
    source_id,
    baseline_state,
    baseline_generation,
    next_due_at,
    created_at,
    last_modified_at
)
SELECT :targetWatchId, source_id, 'NEEDS_BASELINE', 0, NULL, :createdAt, :lastModifiedAt
FROM author_archive_watch_sources
WHERE watch_id = :sourceWatchId;

replaceArchiveWatchSources:
DELETE FROM author_archive_watch_sources
WHERE watch_id = :watchId;

getArchiveWatchSourceIds:
SELECT source_id
FROM author_archive_watch_sources
WHERE watch_id = :watchId
ORDER BY source_id;

deleteArchiveWatchSource:
DELETE FROM author_archive_watch_sources
WHERE watch_id = :watchId
AND source_id = :sourceId;

deleteArchiveSourceCheckpoint:
DELETE FROM author_archive_source_checkpoints
WHERE watch_id = :watchId
AND source_id = :sourceId;

insertArchiveWatchSource:
INSERT INTO author_archive_watch_sources(
    watch_id,
    source_id,
    baseline_state,
    baseline_generation,
    next_due_at,
    created_at,
    last_modified_at
)
VALUES (:watchId, :sourceId, 'NEEDS_BASELINE', 0, NULL, :createdAt, :lastModifiedAt)
ON CONFLICT(watch_id, source_id) DO NOTHING;

upsertArchiveWatchPolicy:
INSERT INTO author_archive_watch_result_policies(
    watch_id,
    include_probable,
    include_unknown,
    notify_probable,
    notify_unknown,
    created_at,
    last_modified_at
)
VALUES (:watchId, 0, 0, 0, 0, :createdAt, :lastModifiedAt)
ON CONFLICT(watch_id)
DO UPDATE SET last_modified_at = excluded.last_modified_at;

getArchiveWatchPolicyId:
SELECT _id
FROM author_archive_watch_result_policies
WHERE watch_id = :watchId;

replaceArchiveWatchLanguages:
DELETE FROM author_archive_watch_languages
WHERE policy_id = :policyId;

getArchiveWatchLanguages:
SELECT language_tag
FROM author_archive_watch_languages
WHERE policy_id = :policyId
ORDER BY language_tag;

deleteArchiveWatchLanguage:
DELETE FROM author_archive_watch_languages
WHERE policy_id = :policyId
AND language_tag = :languageTag;

insertArchiveWatchLanguage:
INSERT INTO author_archive_watch_languages(policy_id, language_tag)
VALUES (:policyId, :languageTag)
ON CONFLICT(policy_id, language_tag) DO NOTHING;

unfollowArchiveCreator:
UPDATE author_archive_watches
SET enabled = 0,
    lease_owner = NULL,
    lease_expires_at = NULL,
    last_modified_at = :lastModifiedAt
WHERE creator_id = :creatorId;

deleteArchiveWatchByCreator:
DELETE FROM author_archive_watches
WHERE creator_id = :creatorId;

getArchiveFollowedCreators:
SELECT
    W.creator_id,
    W.enabled,
    coalesce((
        SELECT group_concat(ORDERED_SOURCE.source_id, char(31))
        FROM (
            SELECT WS.source_id
            FROM author_archive_watch_sources WS
            WHERE WS.watch_id = W._id
            ORDER BY WS.source_id
        ) ORDERED_SOURCE
    ), '') AS source_ids,
    coalesce((
        SELECT group_concat(ORDERED_LANGUAGE.language_tag, char(31))
        FROM (
            SELECT WL.language_tag
            FROM author_archive_watch_result_policies WP
            JOIN author_archive_watch_languages WL ON WL.policy_id = WP._id
            WHERE WP.watch_id = W._id
            ORDER BY WL.language_tag
        ) ORDERED_LANGUAGE
    ), '') AS language_tags,
    W.last_checked_at,
    W.last_success_at,
    W.last_error,
    W.created_at
FROM author_archive_watches W
WHERE W.enabled = 1
ORDER BY W.created_at DESC, W._id;

getArchiveWatchPolicyByCreator:
SELECT
    W.creator_id,
    W.enabled,
    W.period_millis,
    P.include_probable,
    P.include_unknown,
    P.notify_probable,
    P.notify_unknown,
    coalesce((
        SELECT group_concat(ORDERED_SOURCE.source_id, char(31))
        FROM (
            SELECT WS.source_id
            FROM author_archive_watch_sources WS
            WHERE WS.watch_id = W._id
            ORDER BY WS.source_id
        ) ORDERED_SOURCE
    ), '') AS source_ids,
    coalesce((
        SELECT group_concat(ORDERED_LANGUAGE.language_tag, char(31))
        FROM (
            SELECT WL.language_tag
            FROM author_archive_watch_languages WL
            WHERE WL.policy_id = P._id
            ORDER BY WL.language_tag
        ) ORDERED_LANGUAGE
    ), '') AS language_tags
FROM author_archive_watches W
JOIN author_archive_watch_result_policies P ON P.watch_id = W._id
WHERE W.creator_id = :creatorId;

updateArchiveWatchCheckResult:
UPDATE author_archive_watches
SET last_checked_at = :checkedAt,
    last_success_at = CASE WHEN :success THEN :checkedAt ELSE last_success_at END,
    last_error = :error,
    last_modified_at = :checkedAt
WHERE creator_id = :creatorId;

insertArchiveCanonicalWork:
INSERT INTO author_archive_canonical_works(
    portable_key,
    primary_title,
    normalized_title,
    status,
    legacy_work_id,
    created_at,
    last_modified_at
)
VALUES (:portableKey, :primaryTitle, :normalizedTitle, 'ACTIVE', NULL, :createdAt, :lastModifiedAt);

upsertArchiveCanonicalWorkFromBackup:
INSERT INTO author_archive_canonical_works(
    portable_key, primary_title, normalized_title, status, legacy_work_id, created_at, last_modified_at
)
VALUES (:portableKey, :primaryTitle, :normalizedTitle, 'ACTIVE', NULL, :createdAt, :lastModifiedAt)
ON CONFLICT(portable_key) DO UPDATE SET
    primary_title = excluded.primary_title,
    normalized_title = excluded.normalized_title,
    status = 'ACTIVE',
    last_modified_at = max(author_archive_canonical_works.last_modified_at, excluded.last_modified_at);

getArchiveCanonicalWorksForBackup:
SELECT portable_key, primary_title
FROM author_archive_canonical_works
WHERE status = 'ACTIVE'
ORDER BY portable_key;

getArchiveWorkDecisionsForBackup:
SELECT
    SW.source_id,
    SW.stable_source_url,
    CW.portable_key,
    WD.state,
    WD.score,
    WD.evidence,
    WD.decided_at
FROM author_archive_work_decisions WD
JOIN author_archive_source_works SW ON SW._id = WD.source_work_id
JOIN author_archive_canonical_works CW ON CW._id = WD.work_id
WHERE WD.actor = 'USER'
AND WD.state IN ('CONFIRMED', 'REJECTED')
AND WD._id = (
    SELECT LAST_USER._id
    FROM author_archive_work_decisions LAST_USER
    WHERE LAST_USER.source_work_id = WD.source_work_id
    AND LAST_USER.work_id = WD.work_id
    AND LAST_USER.actor = 'USER'
    ORDER BY LAST_USER.decided_at DESC, LAST_USER._id DESC
    LIMIT 1
)
ORDER BY SW.source_id, SW.stable_source_url, CW.portable_key;

getArchiveManualLanguageDecisionsForBackup:
SELECT subject_type, subject_key, dimension, language_tag, withdrawn, asserted_at
FROM author_archive_language_assertions LA
WHERE evidence_kind = 'MANUAL'
AND actor IN ('USER', 'RESTORE')
AND LA._id = (
    SELECT LAST_MANUAL._id
    FROM author_archive_language_assertions LAST_MANUAL
    WHERE LAST_MANUAL.subject_type = LA.subject_type
    AND LAST_MANUAL.subject_key = LA.subject_key
    AND LAST_MANUAL.dimension = LA.dimension
    AND LAST_MANUAL.evidence_kind = 'MANUAL'
    AND LAST_MANUAL.actor IN ('USER', 'RESTORE')
    ORDER BY LAST_MANUAL.asserted_at DESC, LAST_MANUAL._id DESC
    LIMIT 1
)
ORDER BY subject_type, subject_key, dimension;

insertArchiveCanonicalWorkFromLegacy:
INSERT INTO author_archive_canonical_works(
    portable_key,
    primary_title,
    normalized_title,
    status,
    legacy_work_id,
    created_at,
    last_modified_at
)
VALUES (
    :portableKey,
    :primaryTitle,
    :normalizedTitle,
    'ACTIVE',
    :legacyWorkId,
    :createdAt,
    :lastModifiedAt
);

getArchiveCanonicalWorkIdByLegacyId:
SELECT _id
FROM author_archive_canonical_works
WHERE legacy_work_id = :legacyWorkId;

getArchiveCanonicalWorkPortableKey:
SELECT portable_key
FROM author_archive_canonical_works
WHERE _id = :id;

updateArchiveCanonicalWorkFromLegacyBridge:
UPDATE author_archive_canonical_works
SET primary_title = :primaryTitle,
    normalized_title = :normalizedTitle,
    last_modified_at = max(last_modified_at, :lastModifiedAt)
WHERE _id = :id;

upsertArchiveCanonicalCreator:
INSERT INTO author_archive_canonical_creators(
    work_id,
    creator_id,
    role,
    creator_order,
    origin,
    evidence
)
VALUES (:workId, :creatorId, :role, :creatorOrder, :origin, :evidence)
ON CONFLICT(work_id, creator_id)
DO UPDATE SET
    role = CASE
        WHEN author_archive_canonical_creators.origin IN ('USER', 'RESTORE') AND excluded.origin != 'USER'
            THEN author_archive_canonical_creators.role
        ELSE excluded.role
    END,
    creator_order = CASE
        WHEN author_archive_canonical_creators.origin IN ('USER', 'RESTORE')
        AND excluded.origin != 'USER'
            THEN author_archive_canonical_creators.creator_order
        ELSE excluded.creator_order
    END,
    origin = CASE
        WHEN author_archive_canonical_creators.origin IN ('USER', 'RESTORE')
        AND excluded.origin != 'USER'
            THEN author_archive_canonical_creators.origin
        ELSE excluded.origin
    END,
    evidence = CASE
        WHEN author_archive_canonical_creators.origin IN ('USER', 'RESTORE')
        AND excluded.origin != 'USER'
            THEN author_archive_canonical_creators.evidence
        ELSE excluded.evidence
    END;

getArchiveCanonicalCreatorsForCreator:
SELECT work_id, role, creator_order, origin, evidence
FROM author_archive_canonical_creators
WHERE creator_id = :creatorId
ORDER BY work_id, creator_order, _id;

getArchiveCanonicalWorkIdsForSourceWorks:
SELECT DISTINCT work_id
FROM author_archive_canonical_versions
WHERE source_work_id IN :sourceWorkIds
ORDER BY work_id;

countArchiveCanonicalVersionsForCreatorOutsideSelection:
SELECT count(*)
FROM author_archive_canonical_versions CV
JOIN author_archive_source_work_creators SWC ON SWC.source_work_id = CV.source_work_id
WHERE CV.work_id = :workId
AND SWC.creator_id = :creatorId
AND CV.source_work_id NOT IN :selectedSourceWorkIds;

deleteArchiveCanonicalCreator:
DELETE FROM author_archive_canonical_creators
WHERE work_id = :workId
AND creator_id = :creatorId;

unionArchiveCanonicalCreatorRole:
UPDATE author_archive_canonical_creators
SET role = CASE
    WHEN role = :incomingRole THEN role
    WHEN role = 'BOTH' OR :incomingRole = 'BOTH' THEN 'BOTH'
    WHEN (role = 'AUTHOR' AND :incomingRole = 'ARTIST') OR
         (role = 'ARTIST' AND :incomingRole = 'AUTHOR') THEN 'BOTH'
    WHEN role = 'UNKNOWN' THEN :incomingRole
    ELSE role
END
WHERE work_id = :workId AND creator_id = :creatorId;

getArchiveCanonicalWork:
SELECT
    CW._id,
    CW.primary_title,
    CW.normalized_title,
    CC.creator_id AS primary_creator_id,
    LA.language_tag AS original_language,
    CW.created_at,
    CW.last_modified_at
FROM author_archive_canonical_works CW
LEFT JOIN author_archive_canonical_creators CC
    ON CC._id = (
        SELECT FIRST_CC._id
        FROM author_archive_canonical_creators FIRST_CC
        WHERE FIRST_CC.work_id = CW._id
        ORDER BY FIRST_CC.creator_order, FIRST_CC._id
        LIMIT 1
    )
LEFT JOIN author_archive_language_assertions LA
    ON LA._id = (
        SELECT CURRENT_LA._id
        FROM author_archive_language_assertions CURRENT_LA
        WHERE CURRENT_LA.subject_type = 'CANONICAL_WORK'
        AND CURRENT_LA.subject_key = 'canonical:' || CW.portable_key
        AND CURRENT_LA.dimension = 'ORIGINAL'
        AND CURRENT_LA.withdrawn = 0
        ORDER BY
            CASE CURRENT_LA.evidence_kind
                WHEN 'MANUAL' THEN 5
                WHEN 'STRUCTURED_METADATA' THEN 4
                WHEN 'SOURCE_FILTER_OR_TAG' THEN 3
                WHEN 'SINGLE_LANGUAGE_SOURCE' THEN 2
                WHEN 'TEXT_DETECTION' THEN 1
                ELSE 0
            END DESC,
            CURRENT_LA.asserted_at DESC
        LIMIT 1
    )
WHERE CW._id = :id
AND CW.status = 'ACTIVE';

getArchiveCanonicalWorkIdByPortableKey:
SELECT _id
FROM author_archive_canonical_works
WHERE portable_key = :portableKey
AND status = 'ACTIVE';

upsertArchiveCanonicalVersion:
INSERT INTO author_archive_canonical_versions(
    work_id,
    source_work_id,
    confirmation,
    evidence,
    confirmed_at
)
VALUES (:workId, :sourceWorkId, :confirmation, :evidence, :confirmedAt)
ON CONFLICT(source_work_id)
DO UPDATE SET
    work_id = excluded.work_id,
    confirmation = excluded.confirmation,
    evidence = excluded.evidence,
    confirmed_at = excluded.confirmed_at;

deleteArchiveCanonicalVersion:
DELETE FROM author_archive_canonical_versions
WHERE source_work_id = :sourceWorkId;

getLatestArchiveWorkDecision:
SELECT state, actor, explicit, score, evidence, decided_at
FROM author_archive_work_decisions
WHERE source_work_id = :sourceWorkId
AND work_id = :workId
ORDER BY
    CASE actor
        WHEN 'USER' THEN 3
        WHEN 'RESTORE' THEN 2
        ELSE 1
    END DESC,
    CASE WHEN actor = 'RESTORE' THEN _id END ASC,
    CASE WHEN actor != 'RESTORE' THEN decided_at END DESC,
    CASE WHEN actor != 'RESTORE' THEN _id END DESC
LIMIT 1;

getArchiveWorkDecisionProjections:
SELECT
    WD.work_id,
    CW.portable_key,
    CW.primary_title,
    WD.state,
    WD.actor,
    WD.explicit,
    WD.score,
    WD.evidence,
    WD.decided_at
FROM author_archive_work_decisions WD
JOIN author_archive_source_works SW ON SW._id = WD.source_work_id
JOIN author_archive_canonical_works CW ON CW._id = WD.work_id
WHERE SW.source_id = :sourceId
AND SW.stable_source_url = :stableSourceUrl
AND CW.status = 'ACTIVE'
AND WD._id = (
    SELECT CURRENT_WD._id
    FROM author_archive_work_decisions CURRENT_WD
    WHERE CURRENT_WD.source_work_id = WD.source_work_id
    AND CURRENT_WD.work_id = WD.work_id
    ORDER BY
        CASE CURRENT_WD.actor
            WHEN 'USER' THEN 3
            WHEN 'RESTORE' THEN 2
            ELSE 1
        END DESC,
        CASE WHEN CURRENT_WD.actor = 'RESTORE' THEN CURRENT_WD._id END ASC,
        CASE WHEN CURRENT_WD.actor != 'RESTORE' THEN CURRENT_WD.decided_at END DESC,
        CASE WHEN CURRENT_WD.actor != 'RESTORE' THEN CURRENT_WD._id END DESC
    LIMIT 1
)
ORDER BY WD.decided_at DESC, WD._id DESC;

getCreatorWorkArchiveRows:
SELECT
    SW._id AS source_work_id,
    SW.source_id,
    SW.stable_source_url,
    SW.manga_id,
    SW.title,
    SW.thumbnail_url,
    SW.details_fetched_at,
    SW.first_seen_at,
    SW.first_seen_date,
    SW.first_seen_zone,
    SW.last_seen_at,
    SW.chapter_count_state,
    SW.catalog_chapter_count,
    SW.latest_chapter_at,
    coalesce(SW.published_date_snapshot_at, (
        SELECT S.value_at
        FROM author_archive_source_date_quality_samples S
        JOIN author_archive_source_date_quality Q
            ON Q.extension_package = S.extension_package
            AND Q.extension_version = S.extension_version
            AND Q.source_id = S.source_id
            AND Q.field_kind = S.field_kind
        JOIN author_archive_source_date_quality_current CURRENT_Q
            ON CURRENT_Q.source_id = Q.source_id
            AND CURRENT_Q.field_kind = Q.field_kind
            AND CURRENT_Q.extension_package = Q.extension_package
            AND CURRENT_Q.extension_version = Q.extension_version
        WHERE S.source_id = SW.source_id
        AND S.field_kind = 'WORK_PUBLISHED'
        AND S.work_natural_key = SW.stable_source_url
        AND S.value_at IS NOT NULL
        AND S.value_at > 0
        AND S.precision = 'DAY'
        AND S.semantic_confirmed = 1
        AND S.network_failure = 0
        AND Q.status = 'TRUSTED'
        AND S.value_at <= Q.updated_at
        ORDER BY S.value_at ASC, S.observed_at DESC, S._id DESC
        LIMIT 1
    )) AS published_date_at,
    CASE
        WHEN SW.published_date_snapshot_at IS NOT NULL AND (
            SELECT Q.status != 'TRUSTED' OR coalesce(SW.published_date_snapshot_basis, '') !=
                Q.extension_package || '@' || Q.extension_version
            FROM author_archive_source_date_quality Q
            JOIN author_archive_source_date_quality_current CURRENT_Q
                ON CURRENT_Q.source_id = Q.source_id
                AND CURRENT_Q.field_kind = Q.field_kind
                AND CURRENT_Q.extension_package = Q.extension_package
                AND CURRENT_Q.extension_version = Q.extension_version
            WHERE Q.source_id = SW.source_id AND Q.field_kind = 'WORK_PUBLISHED'
            LIMIT 1
        ) THEN 'SUSPECT'
        WHEN SW.published_date_snapshot_at IS NOT NULL AND NOT EXISTS(
            SELECT 1 FROM author_archive_source_date_quality_current CURRENT_Q
            WHERE CURRENT_Q.source_id = SW.source_id AND CURRENT_Q.field_kind = 'WORK_PUBLISHED'
        ) THEN 'SUSPECT'
        ELSE coalesce((
        SELECT Q.status
        FROM author_archive_source_date_quality Q
        JOIN author_archive_source_date_quality_current CURRENT_Q
            ON CURRENT_Q.source_id = Q.source_id
            AND CURRENT_Q.field_kind = Q.field_kind
            AND CURRENT_Q.extension_package = Q.extension_package
            AND CURRENT_Q.extension_version = Q.extension_version
        WHERE Q.source_id = SW.source_id
        AND Q.field_kind = 'WORK_PUBLISHED'
        LIMIT 1
        ), 'UNKNOWN')
    END AS published_date_quality,
    coalesce(SW.published_date_snapshot_reason, (
        SELECT Q.last_reason
        FROM author_archive_source_date_quality Q
        JOIN author_archive_source_date_quality_current CURRENT_Q
            ON CURRENT_Q.source_id = Q.source_id
            AND CURRENT_Q.field_kind = Q.field_kind
            AND CURRENT_Q.extension_package = Q.extension_package
            AND CURRENT_Q.extension_version = Q.extension_version
        WHERE Q.source_id = SW.source_id
        AND Q.field_kind = 'WORK_PUBLISHED'
        LIMIT 1
    )) AS published_date_reason,
    coalesce((
        SELECT Q.status
        FROM author_archive_source_date_quality Q
        JOIN author_archive_source_date_quality_current CURRENT_Q
            ON CURRENT_Q.source_id = Q.source_id
            AND CURRENT_Q.field_kind = Q.field_kind
            AND CURRENT_Q.extension_package = Q.extension_package
            AND CURRENT_Q.extension_version = Q.extension_version
        WHERE Q.source_id = SW.source_id
        AND Q.field_kind = 'CHAPTER_UPDATED'
        LIMIT 1
    ), 'UNKNOWN') AS latest_chapter_date_quality,
    (
        SELECT Q.last_reason
        FROM author_archive_source_date_quality Q
        JOIN author_archive_source_date_quality_current CURRENT_Q
            ON CURRENT_Q.source_id = Q.source_id
            AND CURRENT_Q.field_kind = Q.field_kind
            AND CURRENT_Q.extension_package = Q.extension_package
            AND CURRENT_Q.extension_version = Q.extension_version
        WHERE Q.source_id = SW.source_id
        AND Q.field_kind = 'CHAPTER_UPDATED'
        LIMIT 1
    ) AS latest_chapter_date_reason,
    SC.result_state AS last_check_result,
    coalesce(SC.consecutive_failures, 0) AS consecutive_failures,
    SC.last_success_at,
    coalesce(M.favorite, 0) AS in_library,
    CV.work_id AS canonical_work_id,
    CW.portable_key AS canonical_portable_key,
    CW.primary_title AS canonical_title,
    WD.work_id AS decision_work_id,
    DCW.portable_key AS decision_work_portable_key,
    DCW.primary_title AS decision_work_title,
    WD.state AS decision_state,
    WD.actor AS decision_actor,
    WD.explicit AS decision_explicit,
    WD.score AS decision_score,
    WD.evidence AS decision_evidence,
    WD.decided_at AS decision_decided_at,
    LA.language_tag,
    LA.confidence AS language_confidence,
    LA.evidence_kind AS language_evidence_kind,
    CASE WHEN EXISTS(
        SELECT 1
        FROM author_archive_language_assertions OTHER_LA
        WHERE OTHER_LA.subject_type = LA.subject_type
        AND OTHER_LA.subject_key = LA.subject_key
        AND OTHER_LA.dimension = LA.dimension
        AND OTHER_LA.withdrawn = 0
        AND OTHER_LA.evidence_kind = LA.evidence_kind
        AND OTHER_LA.evidence_kind != 'MANUAL'
        AND OTHER_LA.language_tag != LA.language_tag
    ) THEN 1 ELSE 0 END AS language_conflict,
    OLA.language_tag AS original_language_tag,
    OLA.confidence AS original_language_confidence,
    OLA.evidence_kind AS original_language_evidence_kind,
    CASE WHEN EXISTS(
        SELECT 1
        FROM author_archive_language_assertions OTHER_OLA
        WHERE OTHER_OLA.subject_type = OLA.subject_type
        AND OTHER_OLA.subject_key = OLA.subject_key
        AND OTHER_OLA.dimension = OLA.dimension
        AND OTHER_OLA.withdrawn = 0
        AND OTHER_OLA.evidence_kind = OLA.evidence_kind
        AND OTHER_OLA.evidence_kind != 'MANUAL'
        AND OTHER_OLA.language_tag != OLA.language_tag
    ) THEN 1 ELSE 0 END AS original_language_conflict
    ,CASE WHEN EXISTS(
        SELECT 1
        FROM author_archive_discoveries UNREAD_D
        JOIN author_archive_watches UNREAD_W ON UNREAD_W._id = UNREAD_D.watch_id
        LEFT JOIN author_archive_canonical_versions UNREAD_CV
            ON UNREAD_CV.source_work_id = UNREAD_D.source_work_id
        WHERE UNREAD_W.creator_id = :creatorId
        AND UNREAD_W.enabled = 1
        AND UNREAD_D.read_state = 'UNSEEN'
        AND (
            (CV.work_id IS NOT NULL AND UNREAD_CV.work_id = CV.work_id)
            OR (CV.work_id IS NULL AND UNREAD_D.source_work_id = SW._id)
        )
    ) THEN 1 ELSE 0 END AS unread,
    (
        SELECT min(UNREAD_D.first_discovered_at)
        FROM author_archive_discoveries UNREAD_D
        JOIN author_archive_watches UNREAD_W ON UNREAD_W._id = UNREAD_D.watch_id
        LEFT JOIN author_archive_canonical_versions UNREAD_CV
            ON UNREAD_CV.source_work_id = UNREAD_D.source_work_id
        WHERE UNREAD_W.creator_id = :creatorId
        AND UNREAD_W.enabled = 1
        AND UNREAD_D.read_state = 'UNSEEN'
        AND (
            (CV.work_id IS NOT NULL AND UNREAD_CV.work_id = CV.work_id)
            OR (CV.work_id IS NULL AND UNREAD_D.source_work_id = SW._id)
        )
    ) AS unread_first_discovered_at
FROM author_archive_source_works SW
JOIN author_archive_source_work_creators SWC ON SWC.source_work_id = SW._id
LEFT JOIN author_archive_watches W ON W.creator_id = SWC.creator_id
LEFT JOIN author_archive_source_checkpoints SC ON SC.watch_id = W._id AND SC.source_id = SW.source_id
LEFT JOIN mangas M ON M._id = SW.manga_id
LEFT JOIN author_archive_canonical_versions CV ON CV.source_work_id = SW._id
LEFT JOIN author_archive_canonical_works CW ON CW._id = CV.work_id AND CW.status = 'ACTIVE'
LEFT JOIN author_archive_work_decisions WD ON WD._id = (
    SELECT CURRENT_WD._id
    FROM author_archive_work_decisions CURRENT_WD
    WHERE CURRENT_WD.source_work_id = SW._id
    AND (CV.work_id IS NULL OR CURRENT_WD.work_id = CV.work_id)
    ORDER BY
        CASE CURRENT_WD.actor WHEN 'USER' THEN 3 WHEN 'RESTORE' THEN 2 ELSE 1 END DESC,
        CASE WHEN CURRENT_WD.actor = 'RESTORE' THEN CURRENT_WD._id END ASC,
        CASE WHEN CURRENT_WD.actor != 'RESTORE' THEN CURRENT_WD.decided_at END DESC,
        CASE WHEN CURRENT_WD.actor != 'RESTORE' THEN CURRENT_WD._id END DESC
    LIMIT 1
)
LEFT JOIN author_archive_canonical_works DCW ON DCW._id = WD.work_id AND DCW.status = 'ACTIVE'
LEFT JOIN author_archive_language_assertions LA ON LA._id = (
    SELECT CURRENT_LA._id
    FROM author_archive_language_assertions CURRENT_LA
    WHERE CURRENT_LA.subject_type = 'SOURCE_WORK'
    AND CURRENT_LA.subject_key = 'source:' || SW.source_id || ':' || SW.stable_source_url
    AND CURRENT_LA.dimension = 'READING'
    AND CURRENT_LA.withdrawn = 0
    AND (
        CURRENT_LA.evidence_kind != 'MANUAL'
        OR CURRENT_LA._id = (
            SELECT LAST_MANUAL._id
            FROM author_archive_language_assertions LAST_MANUAL
            WHERE LAST_MANUAL.subject_type = CURRENT_LA.subject_type
            AND LAST_MANUAL.subject_key = CURRENT_LA.subject_key
            AND LAST_MANUAL.dimension = CURRENT_LA.dimension
            AND LAST_MANUAL.evidence_kind = 'MANUAL'
            ORDER BY LAST_MANUAL.asserted_at DESC, LAST_MANUAL._id DESC
            LIMIT 1
        )
    )
    ORDER BY
        CASE CURRENT_LA.evidence_kind
            WHEN 'MANUAL' THEN 5
            WHEN 'STRUCTURED_METADATA' THEN 4
            WHEN 'SOURCE_FILTER_OR_TAG' THEN 3
            WHEN 'SINGLE_LANGUAGE_SOURCE' THEN 2
            WHEN 'TEXT_DETECTION' THEN 1
            ELSE 0
        END DESC,
        CURRENT_LA.asserted_at DESC,
        CURRENT_LA._id DESC
    LIMIT 1
)
LEFT JOIN author_archive_language_assertions OLA ON OLA._id = (
    SELECT CURRENT_OLA._id
    FROM author_archive_language_assertions CURRENT_OLA
    WHERE CURRENT_OLA.subject_type = 'SOURCE_WORK'
    AND CURRENT_OLA.subject_key = 'source:' || SW.source_id || ':' || SW.stable_source_url
    AND CURRENT_OLA.dimension = 'ORIGINAL'
    AND CURRENT_OLA.withdrawn = 0
    AND (
        CURRENT_OLA.evidence_kind != 'MANUAL'
        OR CURRENT_OLA._id = (
            SELECT LAST_MANUAL_OLA._id
            FROM author_archive_language_assertions LAST_MANUAL_OLA
            WHERE LAST_MANUAL_OLA.subject_type = CURRENT_OLA.subject_type
            AND LAST_MANUAL_OLA.subject_key = CURRENT_OLA.subject_key
            AND LAST_MANUAL_OLA.dimension = CURRENT_OLA.dimension
            AND LAST_MANUAL_OLA.evidence_kind = 'MANUAL'
            ORDER BY LAST_MANUAL_OLA.asserted_at DESC, LAST_MANUAL_OLA._id DESC
            LIMIT 1
        )
    )
    ORDER BY
        CASE CURRENT_OLA.evidence_kind
            WHEN 'MANUAL' THEN 5
            WHEN 'STRUCTURED_METADATA' THEN 4
            WHEN 'SOURCE_FILTER_OR_TAG' THEN 3
            WHEN 'SINGLE_LANGUAGE_SOURCE' THEN 2
            WHEN 'TEXT_DETECTION' THEN 1
            ELSE 0
        END DESC,
        CURRENT_OLA.asserted_at DESC,
        CURRENT_OLA._id DESC
    LIMIT 1
)
WHERE SWC.creator_id = :creatorId
ORDER BY coalesce(CW.primary_title, SW.title), SW.source_id, SW.stable_source_url;

getCreatorCardProjectionRows:
WITH page_creators AS (
    SELECT
        C._id AS creator_id,
        C.display_name,
        C.normalized_name,
        C.sort_name,
        coalesce((
            SELECT group_concat(ORDERED_ALIAS.encoded_alias, ',')
            FROM (
                SELECT hex(N.name_text) AS encoded_alias
                FROM author_archive_identity_names N
                WHERE N.creator_id = C._id
                ORDER BY N.name_text COLLATE BINARY
            ) ORDERED_ALIAS
        ), '') AS aliases,
        C.created_at,
        C.last_modified_at,
        coalesce(W.enabled, 0) AS followed
    FROM author_archive_creators C
    LEFT JOIN author_archive_watches W ON W.creator_id = C._id
    WHERE C.status = 'ACTIVE'
    AND (:followedOnly = 0 OR W.enabled = 1)
    AND (
        :nameQuery = ''
        OR instr(lower(C.display_name), lower(:nameQuery)) > 0
        OR EXISTS (
            SELECT 1
            FROM author_archive_identity_names SEARCH_NAME
            WHERE SEARCH_NAME.creator_id = C._id
            AND instr(lower(SEARCH_NAME.name_text), lower(:nameQuery)) > 0
        )
    )
    ORDER BY C.sort_name COLLATE NOCASE, C.display_name COLLATE NOCASE, C._id
    LIMIT :pageLimit OFFSET :offset
), related_source_works AS (
    SELECT
        P.creator_id,
        SW._id AS source_work_id,
        SW.source_id,
        SW.stable_source_url,
        SW.manga_id,
        SW.title,
        SW.title AS candidate_title,
        CW.primary_title AS canonical_title,
        CASE
            WHEN CW.portable_key IS NOT NULL THEN 'canonical:' || CW.portable_key
            ELSE 'source:' || SW.source_id || ':' || SW.stable_source_url
        END AS work_key,
        SW.details_fetched_at,
        SW.last_seen_at,
        coalesce(M.thumbnail_url, SW.thumbnail_url) AS cover_url,
        coalesce(M.cover_last_modified, SW.details_fetched_at, SW.last_seen_at, 0) AS cover_last_modified,
        coalesce(M.favorite, 0) AS in_library,
        SRC.lang AS source_language,
        SWC.verification AS relation_verification,
        WD.state AS decision_state
    FROM page_creators P
    JOIN author_archive_source_work_creators SWC ON SWC.creator_id = P.creator_id
    JOIN author_archive_source_works SW ON SW._id = SWC.source_work_id
    LEFT JOIN author_archive_canonical_versions CV ON CV.source_work_id = SW._id
    LEFT JOIN author_archive_canonical_works CW ON CW._id = CV.work_id AND CW.status = 'ACTIVE'
    LEFT JOIN author_archive_work_decisions WD ON WD._id = (
        SELECT CURRENT_WD._id
        FROM author_archive_work_decisions CURRENT_WD
        WHERE CURRENT_WD.source_work_id = SW._id
        AND (CV.work_id IS NULL OR CURRENT_WD.work_id = CV.work_id)
        ORDER BY
            CASE CURRENT_WD.actor WHEN 'USER' THEN 3 WHEN 'RESTORE' THEN 2 ELSE 1 END DESC,
            CASE WHEN CURRENT_WD.actor = 'RESTORE' THEN CURRENT_WD._id END ASC,
            CASE WHEN CURRENT_WD.actor != 'RESTORE' THEN CURRENT_WD.decided_at END DESC,
            CASE WHEN CURRENT_WD.actor != 'RESTORE' THEN CURRENT_WD._id END DESC
        LIMIT 1
    )
    LEFT JOIN mangas M ON M._id = SW.manga_id
    LEFT JOIN sources SRC ON SRC._id = SW.source_id
    WHERE SWC.verification IN ('VERIFIED', 'POSSIBLE')
), page_history AS (
    SELECT CH.manga_id, max(H.last_read) AS last_read_at
    FROM (
        SELECT DISTINCT manga_id
        FROM related_source_works
        WHERE manga_id IS NOT NULL AND relation_verification = 'VERIFIED'
    ) PAGE_MANGA
    JOIN chapters CH ON CH.manga_id = PAGE_MANGA.manga_id
    JOIN history H ON H.chapter_id = CH._id
    WHERE H.last_read > 0
    GROUP BY CH.manga_id
), card_work_candidates AS (
    SELECT
        RSW.creator_id,
        RSW.source_work_id,
        RSW.source_id,
        RSW.stable_source_url,
        RSW.manga_id,
        RSW.candidate_title,
        RSW.canonical_title,
        RSW.work_key,
        RSW.cover_url,
        RSW.cover_last_modified,
        RSW.in_library,
        RSW.source_language,
        PH.last_read_at,
        RSW.relation_verification,
        RSW.decision_state,
        CASE WHEN EXISTS (
            SELECT 1
            FROM author_archive_discoveries D
            JOIN author_archive_watches W ON W._id = D.watch_id
            WHERE D.source_work_id = RSW.source_work_id
            AND W.creator_id = RSW.creator_id
            AND W.enabled = 1
            AND D.read_state = 'UNSEEN'
        ) THEN 1 ELSE 0 END AS unread
    FROM related_source_works RSW
    LEFT JOIN page_history PH ON PH.manga_id = RSW.manga_id
    WHERE coalesce(RSW.decision_state, '') != 'REJECTED'
), card_work_counts AS (
    SELECT creator_id, count(DISTINCT work_key) AS unique_work_count
    FROM card_work_candidates
    WHERE relation_verification = 'VERIFIED'
    GROUP BY creator_id
), card_unread_counts AS (
    SELECT R.creator_id, count(DISTINCT R.work_key) AS unread_work_count
    FROM card_work_candidates R
    JOIN author_archive_discoveries D ON D.source_work_id = R.source_work_id
    JOIN author_archive_watches W ON W._id = D.watch_id AND W.creator_id = R.creator_id
    WHERE W.enabled = 1
    AND D.read_state = 'UNSEEN'
    GROUP BY R.creator_id
)
SELECT
    P.creator_id,
    P.display_name,
    P.normalized_name,
    P.sort_name,
    P.aliases,
    P.created_at,
    P.last_modified_at,
    P.followed,
    coalesce(CWC.unique_work_count, 0) AS unique_work_count,
    coalesce(CUC.unread_work_count, 0) AS unread_work_count,
    CAND.source_work_id,
    CAND.source_id,
    CAND.stable_source_url,
    CAND.manga_id,
    CAND.candidate_title,
    CAND.canonical_title,
    CAND.work_key,
    CAND.cover_url,
    CAND.cover_last_modified,
    CAND.in_library,
    CAND.last_read_at,
    CAND.relation_verification,
    CAND.decision_state,
    CAND.source_language,
    CAND.unread
FROM page_creators P
LEFT JOIN card_work_counts CWC ON CWC.creator_id = P.creator_id
LEFT JOIN card_unread_counts CUC ON CUC.creator_id = P.creator_id
LEFT JOIN card_work_candidates CAND ON CAND.creator_id = P.creator_id
ORDER BY P.sort_name COLLATE NOCASE, P.display_name COLLATE NOCASE, P.creator_id,
    CAND.candidate_title COLLATE NOCASE, CAND.source_id, CAND.stable_source_url;

getRepresentativeWorkCaches:
SELECT creator_id, strategy_version, payload
FROM author_archive_representative_work_cache
WHERE creator_id IN :creatorIds;

getPresentationExclusions:
SELECT SW.source_id, SW.stable_source_url
FROM author_archive_presentation_exclusions PE
JOIN author_archive_source_works SW ON SW._id = PE.source_work_id
WHERE PE.creator_id = :creatorId
ORDER BY SW.source_id, SW.stable_source_url;

getPresentationExclusionsForCreators:
SELECT PE.creator_id, SW.source_id, SW.stable_source_url
FROM author_archive_presentation_exclusions PE
JOIN author_archive_source_works SW ON SW._id = PE.source_work_id
WHERE PE.creator_id IN :creatorIds
ORDER BY PE.creator_id, SW.source_id, SW.stable_source_url;

upsertPresentationExclusion:
INSERT OR IGNORE INTO author_archive_presentation_exclusions(creator_id, source_work_id, created_at)
SELECT :creatorId, SW._id, :createdAt
FROM author_archive_source_works SW
WHERE SW.source_id = :sourceId AND SW.stable_source_url = :stableSourceUrl;

deletePresentationExclusion:
DELETE FROM author_archive_presentation_exclusions
WHERE creator_id = :creatorId
AND source_work_id = (
    SELECT _id
    FROM author_archive_source_works
    WHERE source_id = :sourceId AND stable_source_url = :stableSourceUrl
);

deletePresentationExclusionConflicts:
DELETE FROM author_archive_presentation_exclusions
WHERE creator_id = :sourceCreatorId
AND EXISTS (
    SELECT 1
    FROM author_archive_presentation_exclusions TARGET
    WHERE TARGET.creator_id = :targetCreatorId
    AND TARGET.source_work_id = author_archive_presentation_exclusions.source_work_id
);

movePresentationExclusionsRoot:
UPDATE author_archive_presentation_exclusions
SET creator_id = :targetCreatorId
WHERE creator_id = :sourceCreatorId;

deletePresentationExclusionsRoot:
DELETE FROM author_archive_presentation_exclusions
WHERE creator_id = :sourceCreatorId;

deletePresentationExclusionConflictsForSourceWorks:
DELETE FROM author_archive_presentation_exclusions
WHERE creator_id = :sourceCreatorId
AND source_work_id IN :sourceWorkIds
AND EXISTS (
    SELECT 1
    FROM author_archive_presentation_exclusions TARGET
    WHERE TARGET.creator_id = :targetCreatorId
    AND TARGET.source_work_id = author_archive_presentation_exclusions.source_work_id
);

movePresentationExclusionsForSourceWorks:
UPDATE author_archive_presentation_exclusions
SET creator_id = :targetCreatorId
WHERE creator_id = :sourceCreatorId
AND source_work_id IN :sourceWorkIds;

deleteMovedPresentationExclusions:
DELETE FROM author_archive_presentation_exclusions
WHERE creator_id = :sourceCreatorId
AND source_work_id IN :sourceWorkIds;

upsertRepresentativeWorkCache:
INSERT INTO author_archive_representative_work_cache(creator_id, strategy_version, payload)
SELECT :creatorId, :strategyVersion, :payload
WHERE EXISTS (
    SELECT 1
    FROM author_archive_creators
    WHERE _id = :creatorId
      AND status = 'ACTIVE'
      AND merged_into_creator_id IS NULL
)
ON CONFLICT(creator_id) DO UPDATE SET
    strategy_version = excluded.strategy_version,
    payload = excluded.payload
WHERE strategy_version != excluded.strategy_version OR payload != excluded.payload;

deleteRepresentativeWorkCaches:
DELETE FROM author_archive_representative_work_cache
WHERE creator_id IN :creatorIds;

getArchiveWorkDecisionsForBinding:
SELECT work_id, state, actor, evidence, decided_at
FROM author_archive_work_decisions
WHERE source_work_id = :sourceWorkId
ORDER BY
    CASE actor
        WHEN 'USER' THEN 3
        WHEN 'RESTORE' THEN 2
        ELSE 1
    END DESC,
    CASE WHEN actor = 'RESTORE' THEN _id END ASC,
    CASE WHEN actor != 'RESTORE' THEN decided_at END DESC,
    CASE WHEN actor != 'RESTORE' THEN _id END DESC;

getArchiveWorkDecisionByIdempotencyKey:
SELECT
    source_work_id,
    work_id,
    state,
    actor,
    explicit,
    algorithm_version,
    score,
    evidence,
    decided_at
FROM author_archive_work_decisions
WHERE idempotency_key = :idempotencyKey;

getLegacyImportFingerprint:
SELECT fingerprint
FROM author_archive_legacy_import_state
WHERE entity_type = :entityType
AND legacy_key = :legacyKey;

upsertLegacyImportFingerprint:
INSERT INTO author_archive_legacy_import_state(entity_type, legacy_key, fingerprint, imported_at)
VALUES (:entityType, :legacyKey, :fingerprint, :importedAt)
ON CONFLICT(entity_type, legacy_key)
DO UPDATE SET fingerprint = excluded.fingerprint, imported_at = excluded.imported_at;

upsertArchiveWorkDecision:
INSERT INTO author_archive_work_decisions(
    source_work_id,
    work_id,
    state,
    actor,
    explicit,
    algorithm_version,
    score,
    evidence,
    decided_at,
    idempotency_key
)
VALUES (
    :sourceWorkId,
    :workId,
    :state,
    :actor,
    :explicit,
    :algorithmVersion,
    :score,
    :evidence,
    :decidedAt,
    :idempotencyKey
)
ON CONFLICT(idempotency_key) DO NOTHING;

upsertArchiveLanguageAssertion:
INSERT INTO author_archive_language_assertions(
    subject_type,
    subject_key,
    dimension,
    language_tag,
    confidence,
    evidence_kind,
    evidence_payload,
    actor,
    algorithm_version,
    withdrawn,
    asserted_at,
    idempotency_key
)
VALUES (
    :subjectType,
    :subjectKey,
    :dimension,
    :languageTag,
    :confidence,
    :evidenceKind,
    :evidencePayload,
    :actor,
    :algorithmVersion,
    :withdrawn,
    :assertedAt,
    :idempotencyKey
)
ON CONFLICT(idempotency_key) DO NOTHING;

getArchiveLanguageAssertionByIdempotencyKey:
SELECT
    subject_type,
    subject_key,
    dimension,
    language_tag,
    confidence,
    evidence_kind,
    evidence_payload,
    actor,
    algorithm_version,
    withdrawn,
    asserted_at
FROM author_archive_language_assertions
WHERE idempotency_key = :idempotencyKey;

getArchiveLanguageAssertions:
SELECT language_tag, confidence, evidence_kind, withdrawn
FROM author_archive_language_assertions
WHERE subject_type = :subjectType
AND subject_key = :subjectKey
AND dimension = :dimension
ORDER BY asserted_at, _id;

remapArchiveCreatorLanguageAssertions:
UPDATE author_archive_language_assertions
SET subject_key = :targetSubjectKey
WHERE subject_type = 'CREATOR'
AND subject_key = :sourceSubjectKey;

upsertArchiveWatchPolicyCommand:
INSERT INTO author_archive_watches(
    creator_id, enabled, period_millis, lease_owner, lease_expires_at,
    last_checked_at, last_success_at, last_error, created_at, last_modified_at
)
VALUES (:creatorId, :enabled, :periodMillis, NULL, NULL, NULL, NULL, NULL, :now, :now)
ON CONFLICT(creator_id) DO UPDATE SET
    enabled = excluded.enabled,
    period_millis = excluded.period_millis,
    lease_owner = CASE WHEN excluded.enabled THEN author_archive_watches.lease_owner ELSE NULL END,
    lease_expires_at = CASE WHEN excluded.enabled THEN author_archive_watches.lease_expires_at ELSE NULL END,
    last_modified_at = excluded.last_modified_at;

upsertArchiveWatchSourceCommand:
INSERT INTO author_archive_watch_sources(
    watch_id, source_id, baseline_state, baseline_generation, next_due_at, created_at, last_modified_at
)
VALUES (:watchId, :sourceId, 'NEEDS_BASELINE', 0, :nextDueAt, :now, :now)
ON CONFLICT(watch_id, source_id) DO UPDATE SET
    next_due_at = coalesce(author_archive_watch_sources.next_due_at, excluded.next_due_at),
    last_modified_at = excluded.last_modified_at;

updateArchiveWatchResultPolicyCommand:
UPDATE author_archive_watch_result_policies
SET include_probable = :includeProbable,
    include_unknown = :includeUnknown,
    notify_probable = :notifyProbable,
    notify_unknown = :notifyUnknown,
    last_modified_at = :now
WHERE watch_id = :watchId;

getArchiveDueWatchSources:
SELECT
    W.creator_id,
    WS.source_id,
    WS.baseline_state,
    WS.baseline_generation,
    WS.next_due_at
FROM author_archive_watch_sources WS
JOIN author_archive_watches W ON W._id = WS.watch_id
WHERE W.enabled = 1
AND (W.lease_expires_at IS NULL OR W.lease_expires_at <= :now)
AND (WS.next_due_at IS NULL OR WS.next_due_at <= :now)
ORDER BY coalesce(WS.next_due_at, 0), W.creator_id, WS.source_id
LIMIT :limit;

getArchiveWatchLease:
SELECT enabled, lease_owner, lease_expires_at
FROM author_archive_watches
WHERE creator_id = :creatorId;

tryAcquireArchiveWatchLease:
UPDATE author_archive_watches
SET lease_owner = :ownerToken,
    lease_expires_at = :expiresAt,
    last_modified_at = :now
WHERE creator_id = :creatorId
AND enabled = 1
AND (
    lease_owner IS NULL OR
    lease_expires_at <= :now OR
    lease_owner = :ownerToken
);

releaseArchiveWatchLease:
UPDATE author_archive_watches
SET lease_owner = NULL,
    lease_expires_at = NULL,
    last_modified_at = :now
WHERE creator_id = :creatorId
AND lease_owner = :ownerToken;

insertArchiveDiscoveryRun:
INSERT INTO author_archive_runs(
    run_key, watch_id, state, completed_sources, total_sources, truncated,
    error_code, error_message, queued_at, started_at, finished_at
)
SELECT :runKey, W._id, 'QUEUED', 0, :totalSources, 0, NULL, NULL, :queuedAt, NULL, NULL
FROM author_archive_watches W
WHERE W.creator_id = :creatorId
ON CONFLICT(run_key) DO NOTHING;

getArchiveDiscoveryRunByKey:
SELECT
    R.run_key, W.creator_id, R.state, R.completed_sources, R.total_sources,
    R.truncated, R.error_code, R.error_message, R.queued_at, R.started_at, R.finished_at
FROM author_archive_runs R
JOIN author_archive_watches W ON W._id = R.watch_id
WHERE R.run_key = :runKey;

getArchiveRecoverableDiscoveryRuns:
SELECT
    R.run_key, W.creator_id, R.state, R.completed_sources, R.total_sources,
    R.truncated, R.error_code, R.error_message, R.queued_at, R.started_at, R.finished_at
FROM author_archive_runs R
JOIN author_archive_watches W ON W._id = R.watch_id
WHERE R.state IN ('QUEUED', 'RUNNING')
ORDER BY R.queued_at, R._id;

updateArchiveDiscoveryRun:
UPDATE author_archive_runs
SET state = :state,
    completed_sources = :completedSources,
    truncated = :truncated,
    error_code = :errorCode,
    error_message = :errorMessage,
    started_at = CASE WHEN :state = 'RUNNING' THEN coalesce(started_at, :occurredAt) ELSE started_at END,
    finished_at = CASE WHEN :state IN ('SUCCEEDED', 'FAILED', 'CANCELLED') THEN :occurredAt ELSE NULL END
WHERE run_key = :runKey;

upsertArchiveSourceCheckpoint:
INSERT INTO author_archive_source_checkpoints(
    watch_id, source_id, cursor, result_state, consecutive_failures, backoff_until,
    last_checked_at, last_success_at, error_code, error_message
)
SELECT
    W._id, :sourceId, :cursor, :resultState, :consecutiveFailures, :backoffUntil,
    :checkedAt, :successAt, :errorCode, :errorMessage
FROM author_archive_watches W
WHERE W.creator_id = :creatorId
ON CONFLICT(watch_id, source_id) DO UPDATE SET
    cursor = excluded.cursor,
    result_state = excluded.result_state,
    consecutive_failures = excluded.consecutive_failures,
    backoff_until = excluded.backoff_until,
    last_checked_at = excluded.last_checked_at,
    last_success_at = coalesce(excluded.last_success_at, author_archive_source_checkpoints.last_success_at),
    error_code = excluded.error_code,
    error_message = excluded.error_message;

updateArchiveWatchSourceAfterCheckpoint:
UPDATE author_archive_watch_sources
SET baseline_state = :baselineState,
    baseline_generation = :baselineGeneration,
    next_due_at = :nextDueAt,
    last_modified_at = :checkedAt
WHERE source_id = :sourceId
AND watch_id = (SELECT _id FROM author_archive_watches WHERE creator_id = :creatorId);

getArchiveWatchSourceState:
SELECT baseline_state, baseline_generation
FROM author_archive_watch_sources
WHERE source_id = :sourceId
AND watch_id = (SELECT _id FROM author_archive_watches WHERE creator_id = :creatorId);

getArchiveWatchSourceBaselines:
SELECT WS.source_id, WS.baseline_state, WS.baseline_generation
FROM author_archive_watch_sources WS
JOIN author_archive_watches W ON W._id = WS.watch_id
WHERE W.creator_id = :creatorId
ORDER BY WS.source_id;

sourceWorkInLibraryOrHistoryCount:
SELECT count(*)
FROM mangas M
WHERE M.source = :sourceId
AND trim(M.url) = trim(:stableSourceUrl)
AND (
    M.favorite = 1
    OR EXISTS (
        SELECT 1
        FROM chapters C
        JOIN history H ON H.chapter_id = C._id
        WHERE C.manga_id = M._id
    )
);

sourceWorkHasConfirmedCanonicalVersionCount:
SELECT count(*)
FROM author_archive_canonical_versions CV
JOIN author_archive_source_works SW ON SW._id = CV.source_work_id
WHERE SW.source_id = :sourceId
AND SW.stable_source_url = :stableSourceUrl;

getArchiveSourceCheckpoints:
SELECT
    W.creator_id, C.source_id, C.cursor, C.result_state, C.consecutive_failures,
    C.backoff_until, C.last_checked_at, C.last_success_at, C.error_code, C.error_message
FROM author_archive_source_checkpoints C
JOIN author_archive_watches W ON W._id = C.watch_id
WHERE W.creator_id = :creatorId
ORDER BY C.source_id;

updateArchiveWatchAfterCheckpoint:
UPDATE author_archive_watches
SET last_checked_at = :checkedAt,
    last_success_at = CASE WHEN :successAt IS NULL THEN last_success_at ELSE :successAt END,
    last_error = :errorMessage,
    last_modified_at = :checkedAt
WHERE creator_id = :creatorId;

insertArchiveDiscovery:
INSERT INTO author_archive_discoveries(
    watch_id, source_work_id, kind, reason, baseline_generation,
    read_state, review_disposition, first_discovered_at, last_modified_at
)
SELECT
    W._id, SW._id, :kind, :reason, :baselineGeneration,
    CASE WHEN :inheritSeen = 1 OR EXISTS (
        SELECT 1
        FROM author_archive_discoveries EXISTING_D
        LEFT JOIN author_archive_canonical_versions EXISTING_CV
            ON EXISTING_CV.source_work_id = EXISTING_D.source_work_id
        LEFT JOIN author_archive_canonical_versions CURRENT_CV
            ON CURRENT_CV.source_work_id = SW._id
        WHERE EXISTING_D.read_state = 'SEEN'
        AND (
            (CURRENT_CV.work_id IS NOT NULL AND EXISTING_CV.work_id = CURRENT_CV.work_id)
            OR (CURRENT_CV.work_id IS NULL AND EXISTING_D.source_work_id = SW._id)
        )
    ) THEN 'SEEN' ELSE 'UNSEEN' END,
    'PENDING', :discoveredAt, :discoveredAt
FROM author_archive_watches W
JOIN author_archive_source_works SW
    ON SW.source_id = :sourceId AND SW.stable_source_url = :stableSourceUrl
WHERE W.creator_id = :creatorId
ON CONFLICT(watch_id, source_work_id) DO NOTHING;

getArchiveDiscoveryFactsForCreator:
SELECT SW.source_id, SW.stable_source_url, D.read_state
FROM author_archive_discoveries D
JOIN author_archive_watches W ON W._id = D.watch_id
JOIN author_archive_source_works SW ON SW._id = D.source_work_id
WHERE W.creator_id = :creatorId;

getArchiveDiscoveryReadStatesForWork:
SELECT D.read_state
FROM author_archive_discoveries D
LEFT JOIN author_archive_canonical_versions CV ON CV.source_work_id = D.source_work_id
WHERE D.source_work_id = :sourceWorkId
OR (:canonicalWorkId IS NOT NULL AND CV.work_id = :canonicalWorkId);

getArchiveUnreadDiscoveryCandidates:
SELECT D._id, W.creator_id, C.portable_key, C.display_name,
    SW.source_id, SW.stable_source_url, SW.title, D.first_discovered_at,
    CW.portable_key AS canonical_portable_key
FROM author_archive_discoveries D
JOIN author_archive_watches W ON W._id = D.watch_id
JOIN author_archive_creators C ON C._id = W.creator_id
JOIN author_archive_source_works SW ON SW._id = D.source_work_id
LEFT JOIN author_archive_canonical_versions CV ON CV.source_work_id = SW._id
LEFT JOIN author_archive_canonical_works CW ON CW._id = CV.work_id AND CW.status = 'ACTIVE'
LEFT JOIN author_archive_presentation_exclusions PE
    ON PE.creator_id = W.creator_id AND PE.source_work_id = SW._id
WHERE W.enabled = 1 AND D.read_state = 'UNSEEN'
ORDER BY D.first_discovered_at, D._id;

getArchivePresentationInputsForCreators:
SELECT SWC.creator_id, SW._id AS source_work_id, SW.source_id, SW.stable_source_url, SW.title,
    CW._id AS canonical_work_id, CW.portable_key AS canonical_portable_key,
    CW.primary_title AS canonical_title, WD.state AS decision_state,
    CASE WHEN PE.source_work_id IS NULL THEN 0 ELSE 1 END AS excluded
FROM author_archive_source_work_creators SWC
JOIN author_archive_source_works SW ON SW._id = SWC.source_work_id
LEFT JOIN author_archive_canonical_versions CV ON CV.source_work_id = SW._id
LEFT JOIN author_archive_canonical_works CW ON CW._id = CV.work_id AND CW.status = 'ACTIVE'
LEFT JOIN author_archive_work_decisions WD ON WD._id = (
    SELECT CURRENT_WD._id
    FROM author_archive_work_decisions CURRENT_WD
    WHERE CURRENT_WD.source_work_id = SW._id
    AND (CW._id IS NULL OR CURRENT_WD.work_id = CW._id)
    ORDER BY
        CASE CURRENT_WD.actor WHEN 'USER' THEN 3 WHEN 'RESTORE' THEN 2 ELSE 1 END DESC,
        CASE WHEN CURRENT_WD.actor = 'RESTORE' THEN CURRENT_WD._id END ASC,
        CASE WHEN CURRENT_WD.actor != 'RESTORE' THEN CURRENT_WD.decided_at END DESC,
        CASE WHEN CURRENT_WD.actor != 'RESTORE' THEN CURRENT_WD._id END DESC
    LIMIT 1
)
LEFT JOIN author_archive_presentation_exclusions PE
    ON PE.creator_id = SWC.creator_id AND PE.source_work_id = SW._id
WHERE SWC.creator_id IN :creatorIds;

getArchiveCanonicalWorkIdBySourceWork:
SELECT CV.work_id
FROM author_archive_canonical_versions CV
JOIN author_archive_source_works SW ON SW._id = CV.source_work_id
WHERE SW.source_id = :sourceId
AND SW.stable_source_url = :stableSourceUrl;

markArchiveSourceWorkDiscoveriesSeen:
UPDATE author_archive_discoveries
SET read_state = 'SEEN', last_modified_at = :now
WHERE source_work_id = (
    SELECT _id
    FROM author_archive_source_works
    WHERE source_id = :sourceId
    AND stable_source_url = :stableSourceUrl
)
AND read_state = 'UNSEEN';

markArchiveCanonicalWorkDiscoveriesSeen:
UPDATE author_archive_discoveries
SET read_state = 'SEEN', last_modified_at = :now
WHERE source_work_id IN (
    SELECT source_work_id
    FROM author_archive_canonical_versions
    WHERE work_id = :workId
)
AND read_state = 'UNSEEN';

markArchivePresentationSourceDiscoveriesSeen:
UPDATE author_archive_discoveries
SET read_state = 'SEEN', last_modified_at = :now
WHERE source_work_id = (
    SELECT _id FROM author_archive_source_works
    WHERE source_id = :sourceId AND stable_source_url = :stableSourceUrl
)
AND read_state = 'UNSEEN'
AND NOT EXISTS (
    SELECT 1 FROM author_archive_presentation_exclusions PE
    JOIN author_archive_watches W ON W.creator_id = PE.creator_id
    WHERE W._id = author_archive_discoveries.watch_id
    AND PE.source_work_id = author_archive_discoveries.source_work_id
);

markArchivePresentationExcludedSourceDiscoverySeen:
UPDATE author_archive_discoveries
SET read_state = 'SEEN', last_modified_at = :now
WHERE source_work_id = (
    SELECT _id FROM author_archive_source_works
    WHERE source_id = :sourceId AND stable_source_url = :stableSourceUrl
)
AND watch_id IN (
    SELECT _id FROM author_archive_watches WHERE creator_id = :creatorId
)
AND read_state = 'UNSEEN';

markArchivePresentationCanonicalDiscoveriesSeen:
UPDATE author_archive_discoveries
SET read_state = 'SEEN', last_modified_at = :now
WHERE source_work_id IN (
    SELECT source_work_id FROM author_archive_canonical_versions WHERE work_id = :workId
)
AND read_state = 'UNSEEN'
AND NOT EXISTS (
    SELECT 1 FROM author_archive_presentation_exclusions PE
    JOIN author_archive_watches W ON W.creator_id = PE.creator_id
    WHERE W._id = author_archive_discoveries.watch_id
    AND PE.source_work_id = author_archive_discoveries.source_work_id
);

getArchiveDiscoveryByNaturalKey:
SELECT D._id
FROM author_archive_discoveries D
JOIN author_archive_watches W ON W._id = D.watch_id
JOIN author_archive_source_works SW ON SW._id = D.source_work_id
WHERE W.creator_id = :creatorId
AND SW.source_id = :sourceId
AND SW.stable_source_url = :stableSourceUrl;

insertArchiveNotificationOutbox:
INSERT INTO author_archive_notification_outbox(
    discovery_id, channel, idempotency_key, attempt_count, state,
    last_error, next_attempt_at, created_at, last_attempt_at, delivered_at
)
VALUES (:discoveryId, :channel, :idempotencyKey, 0, 'PENDING', NULL, NULL, :createdAt, NULL, NULL)
ON CONFLICT(idempotency_key) DO NOTHING;

getArchiveNotificationOutboxByIdempotencyKey:
SELECT discovery_id, channel
FROM author_archive_notification_outbox
WHERE idempotency_key = :idempotencyKey;

getArchiveDiscoveryProjectionById:
SELECT
    D._id, W.creator_id, SW.source_id, SW.stable_source_url, SW.title,
    D.kind, D.reason, D.baseline_generation, D.read_state, D.review_disposition,
    coalesce(O.state, 'CANCELLED') AS delivery_state,
    D.first_discovered_at, D.last_modified_at
FROM author_archive_discoveries D
JOIN author_archive_watches W ON W._id = D.watch_id
JOIN author_archive_source_works SW ON SW._id = D.source_work_id
LEFT JOIN author_archive_notification_outbox O ON O.discovery_id = D._id
WHERE D._id = :discoveryId;

getArchiveUnreadDiscoveries:
SELECT
    D._id, W.creator_id, SW.source_id, SW.stable_source_url, SW.title,
    D.kind, D.reason, D.baseline_generation, D.read_state, D.review_disposition,
    coalesce(O.state, 'CANCELLED') AS delivery_state,
    D.first_discovered_at, D.last_modified_at
FROM author_archive_discoveries D
JOIN author_archive_watches W ON W._id = D.watch_id
JOIN author_archive_source_works SW ON SW._id = D.source_work_id
LEFT JOIN author_archive_notification_outbox O ON O.discovery_id = D._id
WHERE W.enabled = 1
AND D.read_state = 'UNSEEN'
ORDER BY D.first_discovered_at DESC, D._id DESC
LIMIT :limit;

getArchiveUnreadWorkDiscoveries:
WITH unread AS (
    SELECT
        D._id AS discovery_id,
        W.creator_id,
        C.portable_key AS creator_key,
        C.display_name AS creator_name,
        SW.source_id,
        SW.stable_source_url,
        CAST(SW.source_id AS TEXT) || ':' || SW.stable_source_url AS source_key,
        SW.title,
        D.first_discovered_at,
        CASE
            WHEN CW.portable_key IS NOT NULL THEN 'canonical:' || CW.portable_key
            ELSE 'source:' || SW.source_id || ':' || SW.stable_source_url
        END AS work_key
    FROM author_archive_discoveries D
    JOIN author_archive_watches W ON W._id = D.watch_id
    JOIN author_archive_creators C ON C._id = W.creator_id
    JOIN author_archive_source_works SW ON SW._id = D.source_work_id
    LEFT JOIN author_archive_canonical_versions CV ON CV.source_work_id = SW._id
    LEFT JOIN author_archive_canonical_works CW ON CW._id = CV.work_id AND CW.status = 'ACTIVE'
    WHERE W.enabled = 1
    AND D.read_state = 'UNSEEN'
), representative_times AS (
    SELECT work_key, min(first_discovered_at) AS first_discovered_at
    FROM unread
    GROUP BY work_key
), representative_creators AS (
    SELECT U.work_key, min(U.creator_key) AS creator_key
    FROM unread U
    JOIN representative_times T
        ON T.work_key = U.work_key
        AND T.first_discovered_at = U.first_discovered_at
    GROUP BY U.work_key
), representative_sources AS (
    SELECT U.work_key, min(U.source_key) AS source_key
    FROM unread U
    JOIN representative_times T
        ON T.work_key = U.work_key
        AND T.first_discovered_at = U.first_discovered_at
    JOIN representative_creators C
        ON C.work_key = U.work_key
        AND C.creator_key = U.creator_key
    GROUP BY U.work_key
), representatives AS (
    SELECT U.work_key, min(U.discovery_id) AS representative_discovery_id
    FROM unread U
    JOIN representative_times T
        ON T.work_key = U.work_key
        AND T.first_discovered_at = U.first_discovered_at
    JOIN representative_creators C
        ON C.work_key = U.work_key
        AND C.creator_key = U.creator_key
    JOIN representative_sources S
        ON S.work_key = U.work_key
        AND S.source_key = U.source_key
    GROUP BY U.work_key
)
SELECT
    R.work_key,
    REP.creator_id,
    REP.creator_name,
    group_concat(DISTINCT CAST(U.creator_id AS TEXT)) AS creator_ids,
    R.representative_discovery_id,
    REP.source_id,
    REP.stable_source_url,
    REP.title,
    min(U.first_discovered_at) AS first_discovered_at
FROM representatives R
JOIN unread REP ON REP.discovery_id = R.representative_discovery_id
JOIN unread U ON U.work_key = R.work_key
GROUP BY R.work_key, R.representative_discovery_id
ORDER BY first_discovered_at DESC, R.work_key DESC
LIMIT :limit;

getArchiveDiscoveries:
SELECT
    D._id, W.creator_id, SW.source_id, SW.stable_source_url, SW.title,
    D.kind, D.reason, D.baseline_generation, D.read_state, D.review_disposition,
    coalesce(O.state, 'CANCELLED') AS delivery_state,
    D.first_discovered_at, D.last_modified_at
FROM author_archive_discoveries D
JOIN author_archive_watches W ON W._id = D.watch_id
JOIN author_archive_source_works SW ON SW._id = D.source_work_id
LEFT JOIN author_archive_notification_outbox O ON O.discovery_id = D._id
WHERE W.enabled = 1 OR D.read_state = 'SEEN'
ORDER BY D.first_discovered_at DESC, D._id DESC
LIMIT :limit;

getArchiveDiscoveryState:
SELECT read_state, review_disposition
FROM author_archive_discoveries
WHERE _id = :discoveryId;

markArchiveDiscoverySeen:
UPDATE author_archive_discoveries
SET read_state = 'SEEN', last_modified_at = :now
WHERE _id = :discoveryId AND read_state = 'UNSEEN';

markArchiveDiscoveriesSeen:
UPDATE author_archive_discoveries
SET read_state = 'SEEN', last_modified_at = :now
WHERE _id IN :discoveryIds AND read_state = 'UNSEEN';

updateArchiveDiscoveryReview:
UPDATE author_archive_discoveries
SET review_disposition = :disposition, last_modified_at = :now
WHERE _id = :discoveryId;

deleteArchiveReviewedDiscoveries:
DELETE FROM author_archive_discoveries
WHERE read_state = 'SEEN'
AND review_disposition != 'PENDING'
AND last_modified_at < :before;

getArchivePendingNotificationOutbox:
SELECT
    _id, discovery_id, channel, idempotency_key, attempt_count, state,
    last_error, next_attempt_at, created_at, last_attempt_at, delivered_at
FROM author_archive_notification_outbox
WHERE state IN ('PENDING', 'FAILED')
AND (next_attempt_at IS NULL OR next_attempt_at <= :now)
ORDER BY coalesce(next_attempt_at, created_at), _id
LIMIT :limit;

getArchiveNotificationOutboxState:
SELECT state
FROM author_archive_notification_outbox
WHERE _id = :outboxId;

updateArchiveNotificationDelivery:
UPDATE author_archive_notification_outbox
SET state = :state,
    attempt_count = CASE WHEN :state = 'PENDING' THEN attempt_count ELSE attempt_count + 1 END,
    last_error = :error,
    next_attempt_at = :nextAttemptAt,
    last_attempt_at = CASE WHEN :state = 'PENDING' THEN last_attempt_at ELSE :occurredAt END,
    delivered_at = CASE WHEN :state = 'DELIVERED' THEN :occurredAt ELSE delivered_at END
WHERE _id = :outboxId;

getArchiveWatchPoliciesForBackup:
SELECT
    C.portable_key AS creator_portable_key,
    W.enabled,
    W.period_millis,
    P.include_probable,
    P.include_unknown,
    P.notify_probable,
    P.notify_unknown
FROM author_archive_watches W
JOIN author_archive_creators C ON C._id = W.creator_id
JOIN author_archive_watch_result_policies P ON P.watch_id = W._id
ORDER BY C.portable_key;

getArchiveDiscoveriesForBackup:
SELECT
    C.portable_key AS creator_portable_key,
    SW.source_id,
    SW.stable_source_url,
    D.kind,
    D.reason,
    D.baseline_generation,
    D.read_state,
    D.review_disposition,
    D.first_discovered_at
FROM author_archive_discoveries D
JOIN author_archive_watches W ON W._id = D.watch_id
JOIN author_archive_creators C ON C._id = W.creator_id
JOIN author_archive_source_works SW ON SW._id = D.source_work_id
ORDER BY D.first_discovered_at, D._id;

restoreArchiveDiscoveryState:
INSERT INTO author_archive_discoveries(
    watch_id, source_work_id, kind, reason, baseline_generation,
    read_state, review_disposition, first_discovered_at, last_modified_at
)
SELECT
    W._id, SW._id, :kind, :reason, :baselineGeneration,
    :readState, :reviewDisposition, :firstDiscoveredAt, :now
FROM author_archive_watches W
JOIN author_archive_creators C ON C._id = W.creator_id
JOIN author_archive_source_works SW
    ON SW.source_id = :sourceId AND SW.stable_source_url = :stableSourceUrl
WHERE C.portable_key = :creatorPortableKey
ON CONFLICT(watch_id, source_work_id) DO UPDATE SET
    read_state = excluded.read_state,
    review_disposition = excluded.review_disposition,
    last_modified_at = excluded.last_modified_at;

getArchiveWatchSourcesForBackup:
SELECT C.portable_key AS creator_portable_key, S.source_id
FROM author_archive_watch_sources S
JOIN author_archive_watches W ON W._id = S.watch_id
JOIN author_archive_creators C ON C._id = W.creator_id
ORDER BY C.portable_key, S.source_id;

getArchiveWatchLanguagesForBackup:
SELECT C.portable_key AS creator_portable_key, L.language_tag
FROM author_archive_watch_languages L
JOIN author_archive_watch_result_policies P ON P._id = L.policy_id
JOIN author_archive_watches W ON W._id = P.watch_id
JOIN author_archive_creators C ON C._id = W.creator_id
ORDER BY C.portable_key, L.language_tag;

setArchiveIdentityRecoveryGraph:
UPDATE author_archive_identity_migration_components
SET recovery_graph = :recoveryGraph
WHERE migration_key = :migrationKey AND component_key = :componentKey;

-- Recalculate after preference/time-zone changes, preserving failure-owned retry deadlines.
getArchiveSourceSchedules:
SELECT S.watch_id, S.source_id, C.last_success_at
FROM author_archive_watch_sources S
JOIN author_archive_watches W ON W._id = S.watch_id
LEFT JOIN author_archive_source_checkpoints C ON C.watch_id = S.watch_id AND C.source_id = S.source_id
WHERE W.enabled = 1
AND (W.lease_expires_at IS NULL OR W.lease_expires_at <= :now)
AND (C.result_state IS NULL OR C.result_state != 'FAILED');

updateArchiveSourceCalendarDue:
UPDATE author_archive_watch_sources
SET next_due_at = :nextDueAt
WHERE watch_id = :watchId AND source_id = :sourceId
AND next_due_at IS NOT :nextDueAt;

cancelArchiveCreatorNotifications:
UPDATE author_archive_notification_outbox
SET state = 'CANCELLED', next_attempt_at = NULL
WHERE state IN ('PENDING', 'FAILED')
AND discovery_id IN (
    SELECT D._id FROM author_archive_discoveries D
    JOIN author_archive_watches W ON W._id = D.watch_id
    WHERE W.creator_id = :creatorId
);
