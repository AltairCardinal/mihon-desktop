+/** Only the same live owner and immutable identity with unsaturated unchanged evidence may bypass comparison. */
+internal class ReaderPairingEvidenceStamp(
+    private val owner: ReaderSpreadSamplesOwner,
+    private val identity: ReaderDualPageIdentity,
+    private val ownerRevision: Long,
+    private val headerRevision: Long,
+) {
+    fun matches(
+        currentOwner: ReaderSpreadSamplesOwner,
+        currentIdentity: ReaderDualPageIdentity,
+        headers: Long,
+    ): Boolean =
+        currentOwner === owner && currentIdentity === identity && !currentOwner.isClosed &&
+            ownerRevision != Long.MAX_VALUE && headerRevision != Long.MAX_VALUE &&
+            currentOwner.evidenceRevision == ownerRevision && headers == headerRevision
+}
