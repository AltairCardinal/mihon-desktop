+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], manifest = Config.NONE)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+class ReaderHardwareBitmapWiringTest {
+    @Test
+    fun `paged uncropped buffered original disables optional native hardware copy`() {
+        val view = ReaderPageImageView(RuntimeEnvironment.getApplication())
+        ReflectionHelpers.callInstanceMethod<Unit>(view, "prepareNonAnimatedImageView")
+        val native = ReflectionHelpers.getField<SubsamplingScaleImageView>(view, "pageView")
+        val requested = mutableListOf<Runnable>()
+        // Keep the real native request and setter wiring; the Windows host cannot run its image-decoder JNI.
+        native.setExecutor { requested += it }
+        mockkObject(ImageUtil)
+        every { ImageUtil.canUseHardwareBitmap(any<BufferedSource>()) } returns true
+        try {
+            view.setImage(Buffer().write(encodedPng()), false, ReaderPageImageView.Config(0), 4)
+            assertTrue("Production must submit the original SSIV initialization", requested.isNotEmpty())
+            assertFalse(
+                "An eligible paged original must keep its native software bitmap instead of an optional copy",
+                ReflectionHelpers.getField<Boolean>(native, "hardwareConfig"),
+            )
+            verify(exactly = 1) { ImageUtil.canUseHardwareBitmap(any<BufferedSource>()) }
+        } finally {
+            view.recycle()
+            unmockkObject(ImageUtil)
+        }
+    }
+
+    private fun encodedPng(): ByteArray {
+        val bitmap = Bitmap.createBitmap(60, 40, Bitmap.Config.ARGB_8888)
+        return java.io.ByteArrayOutputStream().use { output ->
+            bitmap.compress(Bitmap.CompressFormat.PNG, 100, output)
+            bitmap.recycle()
+            output.toByteArray()
+        }
+    }
+
+    @Test
+    fun `native copy policy preserves unsupported crop region webtoon and original side sampling boundaries`() {
+        val context = RuntimeEnvironment.getApplication()
+        data class Case(
+            val config: ReaderPageImageView.Config,
+            val webtoon: Boolean = false,
+            val supported: Boolean = true,
+            val expected: Boolean,
+        )
+        val cases = listOf(
+            Case(ReaderPageImageView.Config(0), supported = false, expected = false),
+            Case(ReaderPageImageView.Config(0, cropBorders = true), expected = true),
+            Case(
+                ReaderPageImageView.Config(0, sourceBounds = mihon.domain.reader.PixelBounds(0, 0, 30, 40)),
+                expected = true,
+            ),
+            Case(ReaderPageImageView.Config(0), webtoon = true, expected = true),
+            Case(ReaderPageImageView.Config(0, pageSideHintEnabled = true), expected = false),
+        )
+        mockkObject(ImageUtil)
+        var supported = true
+        var sniffs = 0
+        every { ImageUtil.canUseHardwareBitmap(any<BufferedSource>()) } answers {
+            sniffs++
+            supported
+        }
+        try {
+            for (case in cases) {
+                supported = case.supported
+                val view = ReaderPageImageView(context, isWebtoon = case.webtoon)
+                // Exercise the existing Webtoon SSIV preference branch without changing global DI.
+                if (case.webtoon) {
+                    ReflectionHelpers.setField(view, "alwaysDecodeLongStripWithSSIV\$delegate", lazyOf(true))
+                }
+                ReflectionHelpers.callInstanceMethod<Unit>(view, "prepareNonAnimatedImageView")
+                val native = ReflectionHelpers.getField<SubsamplingScaleImageView>(view, "pageView")
+                native.setExecutor { }
+                val before = sniffs
+                try {
+                    view.setImage(Buffer().write(encodedPng()), false, case.config, 4)
+                    assertEquals(
+                        case.toString(),
+                        case.expected,
+                        ReflectionHelpers.getField<Boolean>(native, "hardwareConfig"),
+                    )
+                    assertEquals("The existing capability lookup must still occur exactly once", before + 1, sniffs)
+                } finally {
+                    view.recycle()
+                }
+            }
+            val drawableView = ReaderPageImageView(context)
+            val bitmap = Bitmap.createBitmap(60, 40, Bitmap.Config.ARGB_8888)
+            try {
+                drawableView.setImage(BitmapDrawable(context.resources, bitmap), ReaderPageImageView.Config(0))
+                val native = ReflectionHelpers.getField<SubsamplingScaleImageView>(drawableView, "pageView")
+                assertTrue(
+                    "Predecoded drawables keep their original native policy",
+                    ReflectionHelpers.getField<Boolean>(native, "hardwareConfig"),
+                )
+            } finally {
+                drawableView.recycle()
+            }
+            val region = java.io.File.createTempFile("reader-policy-region-", ".png", context.cacheDir)
+            region.writeBytes(encodedPng())
+            val regionView = ReaderPageImageView(context)
+            ReflectionHelpers.callInstanceMethod<Unit>(regionView, "prepareNonAnimatedImageView")
+            val regionNative = ReflectionHelpers.getField<SubsamplingScaleImageView>(regionView, "pageView")
+            regionNative.setExecutor { }
+            val beforeRegion = sniffs
+            try {
+                regionView.setRegionImage(region, ReaderPageImageView.Config(0), 4) { true }
+                assertTrue(
+                    "Owned region input streams keep the original native policy",
+                    ReflectionHelpers.getField<Boolean>(regionNative, "hardwareConfig"),
+                )
+                assertEquals("Non-buffered regions must not add an encoded support lookup", beforeRegion, sniffs)
+            } finally {
+                regionView.recycle()
+                region.delete()
+            }
+        } finally {
+            unmockkObject(ImageUtil)
+        }
+    }
+
+    @Test
+    fun `native bitmap probe reports one real draw without changing pixels and rejects stale requests`() {
+        val probe = ReaderOpenLatencyProbe
+        probe.configure(true, 10, 20, "bitmap-config", targetPage = 4)
+        val first = probe.startChapter(10, 20)
+        val chapter = ReaderChapter(Chapter.create().copy(id = 20, mangaId = 10))
+        val page = ReaderPage(4).apply { this.chapter = chapter }
+        val context = RuntimeEnvironment.getApplication()
+        val view = ReaderPageImageView(context)
+        val bitmap = Bitmap.createBitmap(60, 40, Bitmap.Config.ARGB_8888).apply { eraseColor(Color.RED) }
+        val output = Bitmap.createBitmap(120, 80, Bitmap.Config.ARGB_8888)
+        try {
+            view.bindLatencyPage(page, first)
+            view.setImage(BitmapDrawable(context.resources, bitmap), ReaderPageImageView.Config(0))
+            view.measure(
+                View.MeasureSpec.makeMeasureSpec(120, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(80, View.MeasureSpec.EXACTLY),
+            )
+            view.layout(0, 0, 120, 80)
+            var gates = 0
+            view.beforeImageDraw = { _, _ ->
+                gates++
+                true
+            }
+            repeat(3) {
+                view.draw(Canvas(output))
+                shadowOf(Looper.getMainLooper()).idle()
+            }
+            assertEquals(Color.RED, output.getPixel(60, 40))
+            assertTrue(probe.contains("FIRST_DRAW"))
+            assertEquals(1, probe.capturedEvents().count { it.event == "DRAW_BITMAP_ARGB_8888" })
+            assertEquals(1, probe.capturedEvents().count { it.event == "DRAW_CANVAS_SOFTWARE" })
+            assertFalse(probe.contains("DRAW_CANVAS_GPU"))
+
+            val second = probe.startChapter(10, 20)
+            view.draw(Canvas(output))
+            assertTrue(
+                "Old request must not record native metadata for the new session",
+                probe.capturedEvents().none {
+                    it.event.startsWith("DRAW_BITMAP_")
+                },
+            )
+            view.bindLatencyPage(page, second)
+            ReflectionHelpers.setField(view, "imageCallbackIsCurrent", { false })
+            view.draw(Canvas(output))
+            assertFalse(probe.contains("DRAW_BITMAP_ARGB_8888"))
+            ReflectionHelpers.setField(view, "imageCallbackIsCurrent", { true })
+            val wrong = ReaderPage(3).apply { this.chapter = chapter }
+            view.bindLatencyPage(wrong, second)
+            view.draw(Canvas(output))
+            assertFalse(probe.contains("DRAW_BITMAP_ARGB_8888"))
+            view.bindLatencyPage(page, second)
+            gates = 0
+            view.draw(Canvas(output))
+            assertEquals("The diagnostic forwarding path must not add a native admission call", 1, gates)
+            assertTrue(probe.contains("DRAW_BITMAP_ARGB_8888"))
+            view.draw(Canvas(output))
+            assertEquals("A consumed diagnostic slot must not change drawing admission", 2, gates)
+            assertEquals(1, probe.capturedEvents().count { it.event == "DRAW_BITMAP_ARGB_8888" })
+            probe.configure(false, 10, 20, "off", targetPage = 4)
+            view.draw(Canvas(output))
+            assertTrue(probe.capturedEvents().isEmpty())
+            assertEquals(Color.RED, output.getPixel(60, 40))
+        } finally {
+            probe.configure(false, 10, 20, "off", targetPage = 4)
+            view.recycle()
+            output.recycle()
+        }
+    }
+}
