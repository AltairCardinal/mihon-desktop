+            release.countDown()
+            pair?.let(::detach)
+            single?.let { ReflectionHelpers.callInstanceMethod<Unit>(it, "onDetachedFromWindow") }
+            ordinary.destroy()
+            unmockkObject(ImageUtil)
+            mockkObject(ImageUtil)
+            every { ImageUtil.isAnimatedAndSupported(any()) } returns false
+        }
+    }
