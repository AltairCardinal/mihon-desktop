+    private suspend fun assertInterruptedHeaderSource(
+        dual: Boolean,
+        replace: Boolean,
+    ) = kotlinx.coroutines.coroutineScope {
+        val bytes = readerTestPng(100, 200)
+        val closed = java.util.concurrent.atomic.AtomicInteger()
+        val entered = java.util.concurrent.CountDownLatch(1)
+        val release = java.util.concurrent.CountDownLatch(1)
+        val chapter = ReaderChapter(Chapter.create().copy(id = 705, mangaId = 1))
+        val page = ReaderPage(0, stream = {
+            object : java.io.ByteArrayInputStream(bytes) {
+                override fun close() {
+                    closed.incrementAndGet()
+                    super.close()
+                    if (!replace) throw java.io.IOException("cancel cleanup close failure")
+                }
+            }
+        }).apply { this.chapter = chapter }
+        every { ImageUtil.getImageDimensions(any<okio.BufferedSource>()) } answers {
+            entered.countDown()
+            check(release.await(5, java.util.concurrent.TimeUnit.SECONDS))
+            100 to 200
+        }
+        val ordinary = R2LPagerViewer(viewer.activity).apply { config.navigationModeChangedListener = null }
+        val single = if (!dual) PagerPageHolder(viewer.activity, ordinary, page) else null
+        val pair = if (dual) DualPagerPageHolder(viewer.activity, viewer, DisplayPage.Single(page)) else null
+        try {
+            val work = async { if (pair != null) load(pair, page, "CENTER") else bindOrdinary(requireNotNull(single)) }
+            withContext(Dispatchers.IO) { check(entered.await(5, java.util.concurrent.TimeUnit.SECONDS)) }
+            if (replace) {
+                page.stream = { bytes.inputStream() }
+            } else {
+                work.cancel(kotlinx.coroutines.CancellationException("original cancellation"))
+            }
+            release.countDown()
+            if (replace) {
+                work.await()
+            } else {
+                work.join()
+                assertEquals("original cancellation", work.getCompletionExceptionOrNull()?.message)
+            }
+            assertEquals("The original must close even when the header IO cannot return to Main", 1, closed.get())
+            if (replace) {
