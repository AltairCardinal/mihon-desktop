+    @Test
+    fun `cold holder keeps failed metadata retryable through the original encoded route`() = runTest {
+        for (dual in listOf(false, true)) {
+            val bytes = readerTestPng(100, 200)
+            val opened = java.util.concurrent.atomic.AtomicInteger()
+            val closed = java.util.concurrent.atomic.AtomicInteger()
+            val chapter = ReaderChapter(Chapter.create().copy(id = 706, mangaId = 1))
+            val page = ReaderPage(0, stream = {
+                val attempt = opened.incrementAndGet()
+                object : java.io.ByteArrayInputStream(bytes) {
+                    override fun read(b: ByteArray, off: Int, len: Int): Int {
+                        if (attempt == 1) throw java.io.IOException("first header unavailable")
+                        return super.read(b, off, len)
+                    }
+                    override fun close() {
+                        closed.incrementAndGet()
+                        super.close()
+                        if (attempt == 1) throw java.io.IOException("failed header close unavailable")
+                    }
+                }
+            }).apply { this.chapter = chapter }
+            val ordinary = R2LPagerViewer(viewer.activity).apply { config.navigationModeChangedListener = null }
+            val single = if (!dual) PagerPageHolder(viewer.activity, ordinary, page) else null
+            val pair = if (dual) DualPagerPageHolder(viewer.activity, viewer, DisplayPage.Single(page)) else null
+            suspend fun bind() {
+                if (pair != null) load(pair, page, "CENTER") else bindOrdinary(requireNotNull(single))
+            }
+            try {
+                bind()
+                assertEquals(mihon.domain.reader.ReaderPageFactState.FAILED, page.pageFact.value.state)
+                assertEquals(2, opened.get())
+                assertEquals(2, closed.get())
+                page.retryHeaderFact()
+                bind()
+                assertEquals(mihon.domain.reader.ReaderPageFactState.PORTRAIT, page.pageFact.value.state)
+                assertEquals("Retry must retain only its own newly opened original", 3, opened.get())
+                assertEquals(opened.get(), closed.get())
+            } finally {
+                pair?.let(::detach)
+                single?.let { ReflectionHelpers.callInstanceMethod<Unit>(it, "onDetachedFromWindow") }
+                ordinary.destroy()
+            }
+        }
+    }
+
+    private suspend fun assertColdOriginalRead(dual: Boolean) {
+        val bytes = readerTestPng(100, 200)
+        val opened = java.util.concurrent.atomic.AtomicInteger()
+        val closed = java.util.concurrent.atomic.AtomicInteger()
+        val chapter = ReaderChapter(Chapter.create().copy(id = 704, mangaId = 1))
+        val page = ReaderPage(0, stream = {
+            opened.incrementAndGet()
+            object : java.io.ByteArrayInputStream(bytes) {
+                override fun close() {
+                    closed.incrementAndGet()
+                    super.close()
+                }
+            }
+        }).apply { this.chapter = chapter }
+        val ordinary = R2LPagerViewer(viewer.activity).apply { config.navigationModeChangedListener = null }
+        try {
+            if (dual) {
+                val holder = DualPagerPageHolder(viewer.activity, viewer, DisplayPage.Single(page))
+                try {
+                    load(holder, page, "CENTER")
+                } finally {
+                    detach(holder)
+                }
+            } else {
+                val holder = PagerPageHolder(viewer.activity, ordinary, page)
+                try {
+                    bindOrdinary(holder)
