     // Empty descriptions retain the pre-descriptor wire format; a nonempty field also adds ,"objects":.
     fun batchBytes(encoded: String): Int = if (encoded == "[]") 0 else encoded.encodeToByteArray().size + 11
+
+    /** Reused only by consecutive appends in one import page transaction. */
+    class PageAccumulator(private val onReuse: (() -> Unit)? = null) {
+        data class Scope(val spaceId: String, val generation: Long, val actorId: String, val epoch: Long)
+
+        data class Candidate(
+            val encoded: String,
+            val bytes: Int,
+            val deltaBytes: Int,
+            val additions: List<SyncObjectDescriptor>,
+        )
+
+        private var scope: Scope? = null
+        private var batchId: String? = null
+        private var expectedSeq = -1L
+        private var encoded = "[]"
+        private var bytes = 0
+        private val seen = mutableSetOf<SyncObjectKey>()
+
+        fun plan(
+            scope: Scope,
+            batchId: String?,
+            nextSeq: Long,
+            persistedEncoded: String,
+            descriptions: List<SyncObjectDescriptor>,
+        ): Candidate {
+            var previousBytes = bytes
+            if (this.scope == scope && this.batchId == batchId && expectedSeq == nextSeq &&
+                encoded == persistedEncoded
+            ) {
+                onReuse?.invoke()
+            } else {
+                this.scope = scope
+                this.batchId = batchId
+                expectedSeq = nextSeq
+                previousBytes = batchBytes(persistedEncoded)
+                val persistedObjects = decode(persistedEncoded).distinctBy { it.objectKey }
+                encoded = encode(persistedObjects)
+                bytes = batchBytes(encoded)
+                seen.clear()
+                seen.addAll(persistedObjects.map { it.objectKey })
+            }
+            val addedKeys = mutableSetOf<SyncObjectKey>()
+            val additions = descriptions.filter { it.objectKey !in seen && addedKeys.add(it.objectKey) }
+            if (additions.isEmpty()) return Candidate(encoded, bytes, bytes - previousBytes, emptyList())
+            val fragment = encode(additions)
+            val fragmentBytes = fragment.encodeToByteArray().size
+            return if (encoded == "[]") {
+                Candidate(fragment, fragmentBytes + 11, fragmentBytes + 11 - previousBytes, additions)
+            } else {
+                val nextBytes = bytes + fragmentBytes - 1
+                Candidate(encoded.dropLast(1) + "," + fragment.drop(1), nextBytes, nextBytes - previousBytes, additions)
+            }
+        }
+
+        fun committed(scope: Scope, batchId: String, nextSeq: Long, candidate: Candidate) {
+            this.scope = scope
+            this.batchId = batchId
+            expectedSeq = nextSeq + 1
+            encoded = candidate.encoded
+            bytes = candidate.bytes
+            seen.addAll(candidate.additions.map { it.objectKey })
+        }
+    }
 }
 
