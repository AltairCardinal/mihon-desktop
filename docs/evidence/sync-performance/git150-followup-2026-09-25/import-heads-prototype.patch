+package mihon.data.sync
+
+import app.cash.sqldelight.driver.jdbc.sqlite.JdbcSqliteDriver
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import mihon.data.sync.runtime.SyncDatabaseExchange
+import mihon.data.sync.runtime.SyncProgressReporter
+import mihon.data.sync.runtime.SyncRunLogEntry
+import mihon.data.sync.runtime.SyncRunLogStatus
+import mihon.data.sync.runtime.SyncRunPhase
+import mihon.data.sync.runtime.SyncRunState
+import mihon.data.sync.runtime.SyncRunStore
+import mihon.data.sync.transport.GitHubSyncTransport
+import mihon.domain.sync.runtime.SyncRunStatus
+import mihon.domain.sync.runtime.SyncTrigger
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.Timeout
+import tachiyomi.data.Database
+import tachiyomi.data.DateColumnAdapter
+import tachiyomi.data.History
+import tachiyomi.data.JvmDatabaseHandler
+import tachiyomi.data.Mangas
+import tachiyomi.data.StringListColumnAdapter
+import tachiyomi.data.UpdateStrategyColumnAdapter
+import tachiyomi.domain.manga.model.Manga
+import java.nio.file.Files
+import java.util.Properties
+import java.util.concurrent.TimeUnit
+
+/** Temporary research contract: real file SQL, exchange, run-store progress and Git fixture. */
+@Timeout(value = 2, unit = TimeUnit.MINUTES)
+class SyncImportProgressResearchTest {
+    @Test
+    fun `multi page import records only one active and one terminal completion`() = runBlocking {
+        withCase(cancelSecondPage = false) { case ->
+            assertEquals(SyncRunStatus.SUCCESS, case.status)
+            assertEquals(0, case.remainingEntries)
+            assertEquals(1, case.progress.importingPhases)
+            assertEquals(1, case.progress.activeLogs)
+            assertEquals(1, case.progress.completedLogs)
+            assertEquals(1, case.durableLogs.count { it.status == SyncRunLogStatus.COMPLETED })
+            assertEquals(0, case.durableLogs.count { it.status == SyncRunLogStatus.ACTIVE })
+        }
+    }
+
+    @Test
+    fun `cancelled import does not report completion for unfinished pages`() = runBlocking {
+        withCase(cancelSecondPage = true) { case ->
+            assertEquals(51, case.remainingEntries)
+            assertEquals(1, case.progress.importingPhases)
+            assertEquals(1, case.progress.activeLogs)
+            assertEquals(0, case.progress.completedLogs)
+            assertEquals(0, case.durableLogs.count { it.status == SyncRunLogStatus.COMPLETED })
+            assertEquals(1, case.durableLogs.count { it.status == SyncRunLogStatus.ACTIVE })
+        }
+    }
+
+    private suspend fun withCase(cancelSecondPage: Boolean, assertCase: suspend (CaseResult) -> Unit) {
+        val dbFile = Files.createTempFile("mihon-import-progress-research-", ".db")
+        val driver = JdbcSqliteDriver(
+            "jdbc:sqlite:$dbFile",
+            Properties().apply { setProperty("foreign_keys", "true") },
+        )
+        Database.Schema.create(driver)
+        val database = Database(
+            driver,
+            History.Adapter(DateColumnAdapter),
+            Mangas.Adapter(StringListColumnAdapter, UpdateStrategyColumnAdapter),
+        )
+        val storage = SyncRuntimeStorageContract.Storage(driver, JvmDatabaseHandler(database, driver))
+        try {
+            storage.manga.insertNetworkManga(
+                (0 until 101).map {
+                    Manga.create().copy(source = 1, url = "/progress/$it", title = "entry $it", favorite = true)
+                },
+            )
+            SyncOnboardingFixture(storage).use { setup ->
+                val material = setup.existing("")
+                val importId = storage.connect("actor", setup.repository)
+                val store = SyncRunStore(storage.handler)
+                val run = store.start("space", 1, SyncTrigger.MANUAL)
+                assertTrue(store.claim(run.runId, "research-owner", 1))
+                val progress = CountingProgress(store.reporter(run.runId, "research-owner"))
+                val transport = GitHubSyncTransport(
+                    setup.client,
+                    { "synthetic-token" },
+                    setup.git.baseUrl,
+                    spaceMaterial = material,
+                )
+                var importChecks = 0
+                val exchange = SyncDatabaseExchange(
+                    storage.handler,
+                    storage.baseline,
+                    storage.projector,
+                    transport,
+                    spaceMaterial = material,
+                    progress = progress,
+                    allowImport = {
+                        importChecks++
+                        if (cancelSecondPage && importChecks == 2) {
+                            throw CancellationException("research cancellation after first page")
+                        }
+                        true
+                    },
+                )
+                val status = if (cancelSecondPage) {
+                    val failed = runCatching { withTimeout(30_000) { exchange.exchange("space", 1, setup.repository) } }
+                    assertTrue(failed.exceptionOrNull() is CancellationException, failed.toString())
+                    null
+                } else {
+                    withTimeout(30_000) { exchange.exchange("space", 1, setup.repository) }.status
+                }
+                val logs = store.logs(run.runId, 500).filter { it.key == importId }
+                val remainingEntries = storage.handler.await {
+                    sync_importQueries.getImportEntries(importId, 1000).executeAsList().size
+                }
+                println(
+                    "IMPORT_PROGRESS_RESEARCH cancel=$cancelSecondPage pages=${progress.importingPhases} " +
+                        "active=${progress.activeLogs} completed=${progress.completedLogs} " +
+                        "remaining=$remainingEntries phaseMillis=${progress.phaseNanos / 1_000_000} " +
+                        "logMillis=${progress.logNanos / 1_000_000}",
+                )
+                assertCase(CaseResult(status, progress, logs, remainingEntries))
+            }
+        } finally {
+            storage.close()
+            runCatching { Files.deleteIfExists(dbFile) }.onFailure { dbFile.toFile().deleteOnExit() }
+        }
+    }
+
+    private data class CaseResult(
+        val status: SyncRunStatus?,
+        val progress: CountingProgress,
+        val durableLogs: List<mihon.data.sync.runtime.SyncRunLog>,
+        val remainingEntries: Int,
+    )
+
+    private class CountingProgress(
+        private val delegate: SyncProgressReporter,
+    ) : SyncProgressReporter {
+        var importingPhases = 0
+        var activeLogs = 0
+        var completedLogs = 0
+        var phaseNanos = 0L
+        var logNanos = 0L
+
+        override suspend fun phase(
+            phase: SyncRunPhase,
+            processed: Long,
+            total: Long,
+            completed: Long,
+            skipped: Long,
+            failed: Long,
+            state: SyncRunState,
+            reason: String?,
+        ) {
+            if (phase == SyncRunPhase.IMPORTING) {
+                importingPhases++
+            }
+            val started = System.nanoTime()
+            try {
+                delegate.phase(phase, processed, total, completed, skipped, failed, state, reason)
+            } finally {
+                if (phase == SyncRunPhase.IMPORTING) phaseNanos += System.nanoTime() - started
+            }
+        }
+
+        override suspend fun log(key: String, title: String, detail: String, status: SyncRunLogStatus) {
+            if (title == "首次合并") {
+                if (status == SyncRunLogStatus.ACTIVE) activeLogs++
+                if (status == SyncRunLogStatus.COMPLETED) completedLogs++
+            }
+            val started = System.nanoTime()
+            try {
+                delegate.log(key, title, detail, status)
+            } finally {
+                if (title == "首次合并") logNanos += System.nanoTime() - started
+            }
+        }
+
+        override suspend fun logBatch(entries: List<SyncRunLogEntry>) = delegate.logBatch(entries)
+
+        override suspend fun totals(uploaded: Long, downloaded: Long) = delegate.totals(uploaded, downloaded)
+    }
+}
