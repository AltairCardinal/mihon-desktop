--- a/data/src/jvmTest/kotlin/mihon/data/sync/JvmSyncBaselineStorageContractTest.kt
+++ b/data/src/jvmTest/kotlin/mihon/data/sync/JvmSyncBaselineStorageContractTest.kt
@@ -1,11 +1,96 @@
 package mihon.data.sync
 
+import app.cash.sqldelight.db.SqlDriver
 import app.cash.sqldelight.driver.jdbc.sqlite.JdbcSqliteDriver
+import kotlinx.coroutines.runBlocking
+import mihon.domain.sync.SyncField
+import mihon.domain.sync.transport.SyncRepository
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
 import tachiyomi.data.JvmDatabaseHandler
+import tachiyomi.domain.chapter.model.Chapter
+import java.io.File
+import java.lang.reflect.InvocationTargetException
+import java.lang.reflect.Proxy
+import java.util.Date
+import java.util.concurrent.atomic.AtomicInteger
 
 class JvmSyncBaselineStorageContractTest : SyncBaselineStorageContract() {
     override fun open(path: String?, create: Boolean): Storage {
         val driver = JdbcSqliteDriver(path?.let { "jdbc:sqlite:$it" } ?: JdbcSqliteDriver.IN_MEMORY)
         return Storage(driver, JvmDatabaseHandler(database(driver, create), driver))
     }
+
+    @Test
+    fun `page import heads are read once while repeated reading fields retain causal parents`() = runBlocking {
+        val file = File.createTempFile("sync-import-heads-", ".db")
+        val headReads = AtomicInteger()
+        fun countedStorage(create: Boolean): Storage {
+            val raw = JdbcSqliteDriver("jdbc:sqlite:${file.absolutePath}")
+            val counted = Proxy.newProxyInstance(
+                SqlDriver::class.java.classLoader,
+                arrayOf(SqlDriver::class.java),
+            ) { _, method, arguments ->
+                if (method.name == "executeQuery" &&
+                    (arguments?.getOrNull(1) as? String)?.contains("FROM sync_import_heads") == true
+                ) {
+                    headReads.incrementAndGet()
+                }
+                try {
+                    method.invoke(raw, *(arguments ?: emptyArray()))
+                } catch (failure: InvocationTargetException) {
+                    throw failure.targetException
+                }
+            } as SqlDriver
+            return Storage(counted, JvmDatabaseHandler(database(counted, create), counted))
+        }
+        try {
+            var import = ""
+            val started = System.nanoTime()
+            countedStorage(true).use { storage ->
+                val manga = storage.manga("/many", true)
+                val chapters = storage.chapters.addAll(
+                    (1..101).map { index ->
+                        Chapter.create().copy(
+                            mangaId = manga.id,
+                            url = "/chapter-$index",
+                            name = "Chapter $index",
+                            read = true,
+                        )
+                    },
+                )
+                storage.handler.await(inTransaction = true) {
+                    chapters.forEachIndexed { index, chapter ->
+                        historyQueries.upsert(chapter.id, Date(index.toLong() + 1), 0)
+                    }
+                }
+                import = storage.baseline.connectAndImport(
+                    "space",
+                    1,
+                    SyncRepository("owner", "sync-data", "mihon-sync"),
+                    "device",
+                    1,
+                )
+                assertEquals(1L, storage.baseline.process(import).remaining)
+            }
+            countedStorage(false).use { storage ->
+                while (storage.baseline.process(import).remaining > 0) Unit
+                println(
+                    "SYNC_IMPORT_HEADS calls=${headReads.get()} scenarioMs=${(System.nanoTime() - started) / 1_000_000}",
+                )
+                assertEquals(3, headReads.get(), "Each of three pages should preload import heads once")
+                val summaries = storage.journal.pendingEvents("space", 1).mapNotNull { event ->
+                    event.effects.singleOrNull { it.field == SyncField.READING_SUMMARY }?.let { event to it }
+                }
+                assertEquals(101, summaries.size)
+                assertTrue(summaries.first().second.parents.isEmpty())
+                summaries.zipWithNext().forEach { (previous, current) ->
+                    assertEquals(listOf(previous.second.ref(previous.first)), current.second.parents)
+                }
+            }
+        } finally {
+            assertTrue(file.delete())
+        }
+    }
 }
