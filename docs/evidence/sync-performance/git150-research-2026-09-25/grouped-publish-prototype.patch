+    /** Research only: caller supplies already validated, durably frozen FINAL files. No queue integration. */
+    internal suspend fun researchPublishFrozenFiles(
+        snapshot: SyncSnapshot,
+        files: Map<String, ByteArray>,
+    ): SyncSnapshot {
+        require(files.keys.all { it.startsWith(".mihon-sync/") && ".." !in it.split('/') })
+        require(files.keys.containsAll(snapshot.tree.entries.map { it.path }))
+        require(getRepositoryInfo(snapshot.repository).private)
+        val before = snapshot.tree.entries.associateBy { it.path }
+        val changed = files.toSortedMap().filter { (path, bytes) ->
+            before[path]?.let { gitBlobOid(bytes, it.sha.length) != it.sha } ?: true
+        }.toList()
+        require(changed.isNotEmpty())
+        var treeSha = snapshot.tree.sha
+        val pending = mutableListOf<Pair<String, ByteArray>>()
+        suspend fun flush() {
+            if (pending.isEmpty()) return
+            val planned = SyncTreeEntryPayloadPlanner.plan(pending, baseTreeSha = treeSha)
+            require(planned.all { it.inlineContent != null }) { "research group exceeds inline request budget" }
+            val entries = planned.map { entry ->
+                SyncGitTreeEntry(entry.path, "100644", "blob", "", entry.bytes.size.toLong(), entry.inlineContent)
+            }
+            treeSha = createTree(snapshot.repository, treeSha, entries).sha
+            pending.clear()
+        }
+        for (entry in changed) {
+            val proposed = SyncTreeEntryPayloadPlanner.plan(pending + entry, baseTreeSha = treeSha)
+            if (proposed.any { it.inlineContent == null }) flush()
+            pending += entry
+        }
+        flush()
+        val commit = createCommit(snapshot.repository, treeSha, snapshot.head)
+        try {
+            updateRef(snapshot.repository, commit.sha)
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            // Even a lost response must be reconciled against the live ref, never assumed successful.
+        }
+        val observed = readSnapshot(snapshot.repository, snapshot.spaceId, snapshot.generation).getOrThrow()
+        require(observed.head == commit.sha) { "research publication commit was not confirmed" }
+        val reached = observed.tree.entries.associateBy { it.path }
+        require(reached.keys == files.keys) { "research publication file set was not confirmed" }
+        require(
+            files.all { (path, bytes) ->
+                reached[path]?.let {
+                    it.mode == "100644" && it.type == "blob" && gitBlobOid(bytes, it.sha.length) == it.sha
+                }
+                    ?: false
+            },
+        ) { "research publication frozen bytes were not confirmed" }
+        return observed
+    }
+
