+/** Measures a transport-only lower-cost candidate. Not production batching or recovery integration. */
+@Timeout(value = 10, unit = TimeUnit.MINUTES)
+class SyncGroupedPublishResearchTest {
+    @Test
+    fun `bounded trees publish same frozen files with one confirmed ref update`() = runBlocking {
+        val inputName = System.getenv("SYNC_GROUP_INPUT")
+        val outputName = System.getenv("SYNC_GROUP_OUTPUT")
+        assumeTrue(inputName != null && outputName != null, "explicit private artifact research only")
+        val input = Path.of(requireNotNull(inputName))
+        val output = Path.of(requireNotNull(outputName))
+        require(!Files.exists(output))
+        fun readFiles(root: Path): Map<String, ByteArray> = Files.walk(root).use { paths ->
+            paths.filter { Files.isRegularFile(it) }.toList().associate { path ->
+                root.relativize(path).toString().replace('\\', '/') to Files.readAllBytes(path)
+            }
+        }
+        val initial = readFiles(input.resolve("initial"))
+        val finalFiles = readFiles(input.resolve("final"))
+        val original = Json.parseToJsonElement(Files.readString(input.resolve("summary.json"))).jsonObject
+        val descriptor = SyncSpaceDescriptorCodec.decode(initial.getValue(".mihon-sync/space.json")).getOrThrow()
+        val material = SyncSpaceCrypto.unlock(descriptor, "synthetic-git-compare-space-password").getOrThrow()
+        assertTrue(material.secret != null)
+        val repository = SyncRepository("fixture-owner", "mihon-sync", GitHubSyncSpaceClient.BRANCH)
+        SyncGitSafetyContractTest().GitFixture(empty = true, repositoryOverride = repository).use { git ->
+            fun transport() = GitHubSyncTransport(OkHttpClient(), {
+                "synthetic-token"
+            }, git.baseUrl, spaceMaterial = material)
+            assertTrue(
+                transport().initialize(
+                    repository,
+                    descriptor.spaceId,
+                    descriptor.generation,
+                ) is SyncInitializationResult.Initialized,
+            )
+            git.replaceFiles(repository.branch, initial)
+            assertEquals(original.getValue("initialTreeOid").jsonPrimitive.content, git.treeSha(repository.branch))
+            val delegate = git.server.dispatcher
+            val requests = mutableListOf<kotlinx.serialization.json.JsonObject>()
+            var maximumWriteBytes = 0L
+            git.server.dispatcher = object : Dispatcher() {
+                override fun dispatch(request: RecordedRequest): MockResponse {
+                    val response = delegate.dispatch(request)
+                    val upload = request.body?.size?.toLong() ?: 0L
+                    maximumWriteBytes = maxOf(maximumWriteBytes, upload)
+                    requests += buildJsonObject {
+                        put("method", request.method)
+                        put("kind", request.url.encodedPath.substringAfter("/git/", "repository"))
+                        put("requestBytes", upload)
+                        put("responseBytes", response.body?.contentLength ?: 0L)
+                    }
+                    val uploadMillis = (upload + 1_249L) / 1_250L
+                    if (uploadMillis > 0) Thread.sleep(uploadMillis)
+                    return response.newBuilder().headersDelay(50, TimeUnit.MILLISECONDS)
+                        .throttleBody(12_500, 10, TimeUnit.MILLISECONDS).build()
+                }
+            }
+            val publisher = transport()
+            val refsBefore = git.forceFlags.size
+            val started = System.nanoTime()
+            val snapshot = publisher.readSnapshot(repository, descriptor.spaceId, descriptor.generation).getOrThrow()
+            val observed = publisher.researchPublishFrozenFiles(snapshot, finalFiles)
+            val elapsed = TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - started)
+            assertEquals(original.getValue("finalTreeOid").jsonPrimitive.content, observed.tree.sha)
+            assertEquals(1, git.forceFlags.size - refsBefore)
+            assertTrue(maximumWriteBytes <= 2 * 1024 * 1024)
+            val reached = git.files(repository.branch)
+            assertEquals(finalFiles.keys, reached.keys)
+            assertTrue(finalFiles.all { (path, bytes) -> bytes.contentEquals(reached.getValue(path)) })
+            val result = buildJsonObject {
+                put("elapsedMillis", elapsed)
+                put("httpRequests", requests.size)
+                put("requestBodyBytes", requests.sumOf { it.getValue("requestBytes").jsonPrimitive.content.toLong() })
+                put("responseBodyBytes", requests.sumOf { it.getValue("responseBytes").jsonPrimitive.content.toLong() })
+                put("maximumWriteBytes", maximumWriteBytes)
+                put("refUpdates", git.forceFlags.size - refsBefore)
+                put("batches", observed.batches.size)
+                put("finalFiles", reached.size)
+                put("initialTreeOid", snapshot.tree.sha)
+                put("finalTreeOid", observed.tree.sha)
+                put("requests", buildJsonArray { requests.forEach(::add) })
+            }
+            Files.createDirectories(output.parent)
+            Files.writeString(output, result.toString(), StandardCharsets.UTF_8)
+            println("GROUPED_RESEARCH elapsedMs=$elapsed requests=${requests.size} files=${reached.size}")
+        }
+    }
