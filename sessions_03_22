   178→        val title = titleMap?.get("en")?.jsonPrimitive?.content
   179→            ?: titleMap?.values?.firstOrNull()?.jsonPrimitive?.content
   180→            ?: "Unknown"
   181→
   182→        // Description
   183→        val descMap = attrs["description"]?.jsonObject
   184→        val description = descMap?.get("en")?.jsonPrimitive?.content
   185→            ?: descMap?.values?.firstOrNull()?.jsonPrimitive?.content
   186→
   187→        // Cover image
   188→        val coverRel = data["relationships"]?.jsonArray
   189→            ?.firstOrNull { it.jsonObject["type"]?.jsonPrimitive?.content == "cover_art" }
   190→            ?.jsonObject
   191→        val coverFile = coverRel?.get("attributes")?.jsonObject?.get("fileName")?.jsonPrimitive?.content
   192→        val thumbnailUrl = if (coverFile != null) "$coverBaseUrl/$id/$coverFile.256.jpg" else null
   193→
   194→        // Authors
   195→        val authors = data["relationships"]?.jsonArray
   196→            ?.filter { it.jsonObject["type"]?.jsonPrimitive?.content == "author" }
   197→            ?.mapNotNull { it.jsonObject["attributes"]?.jsonObject?.get("name")?.jsonPrimitive?.content }
   198→        val artists = data["relationships"]?.jsonArray
   199→            ?.filter { it.jsonObject["type"]?.jsonPrimitive?.content == "artist" }
   200→            ?.mapNotNull { it.jsonObject["attributes"]?.jsonObject?.get("name")?.jsonPrimitive?.content }
   201→
   202→        // Status
   203→        val statusStr = attrs["status"]?.jsonPrimitive?.content
   204→        val status = when (statusStr) {
   205→            "ongoing" -> SManga.ONGOING
   206→            "completed" -> SManga.COMPLETED
   207→            "hiatus" -> SManga.ON_HIATUS
   208→            "cancelled" -> SManga.CANCELLED
   209→            else -> SManga.UNKNOWN
   210→        }
   211→
   212→        // Genres from tags
   213→        val genres = attrs["tags"]?.jsonArray
   214→            ?.mapNotNull { it.jsonObject["attributes"]?.jsonObject?.get("name")?.jsonObject?.get("en")?.jsonPrimitive?.content }
   215→
   216→        return SManga.create().apply {
   217→            url = "/manga/$id"
   218→            this.title = title
   219→            this.description = description
   220→            this.thumbnail_url = thumbnailUrl
   221→            this.author = authors?.joinToString(", ")
