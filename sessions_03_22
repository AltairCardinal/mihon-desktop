     6→
     7→private val IMAGE_EXTENSIONS = setOf("jpg", "jpeg", "png", "webp", "gif", "avif")
     8→
     9→/**
    10→ * Packages a downloaded chapter directory into a `.cbz` (Comic Book Zip) file.
    11→ *
    12→ * CBZ is a standard ZIP archive containing only image files, compatible with
    13→ * most comic readers (Mihon Android, Komga, Kavita, etc.).
    14→ */
    15→object CbzCreator {
    16→
    17→    /**
    18→     * Creates a CBZ file from all image files in [sourceDir].
    19→     * @return true on success, false if [sourceDir] contains no images.
    20→     */
    21→    fun create(sourceDir: File, outputFile: File): Boolean {
    22→        val imageFiles = sourceDir.listFiles()
    23→            ?.filter { it.isFile && it.extension.lowercase() in IMAGE_EXTENSIONS }
    24→            ?.sortedBy { it.name }
    25→            ?: emptyList()
    26→
    27→        if (imageFiles.isEmpty()) return false
    28→
    29→        outputFile.parentFile?.mkdirs()
    30→        ZipOutputStream(outputFile.outputStream().buffered()).use { zip ->
    31→            for (image in imageFiles) {
    32→                zip.putNextEntry(ZipEntry(image.name))
    33→                image.inputStream().use { it.copyTo(zip) }
    34→                zip.closeEntry()
    35→            }
    36→        }
    37→        return true
    38→    }
    39→
    40→    /** Returns `<parentDir>/<sourceDir.name>.cbz`. */
    41→    fun defaultOutputFile(sourceDir: File): File =
    42→        File(sourceDir.parentFile, "${sourceDir.name}.cbz")
    43→}
