   163→        val obj = json.parseToJsonElement(response.body.string()).jsonObject
   164→        val data = obj["data"]?.jsonArray ?: return MangasPage(emptyList(), false)
   165→        val total = obj["total"]?.jsonPrimitive?.content?.toIntOrNull() ?: 0
   166→        val offset = url.substringAfter("offset=").substringBefore("&").toIntOrNull() ?: 0
