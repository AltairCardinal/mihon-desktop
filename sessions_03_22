   202→ * For a fresh install, creates the schema from scratch (does NOT run Android
   203→ * legacy migrations). For an existing database, migrates incrementally.
   204→ * If migration fails (e.g. corrupted file), deletes the file and recreates.
   205→ */
   206→private fun createDriver(dbFile: File): SqlDriver {
   207→    val schema = tachiyomi.data.Database.Schema
   208→    val isNew = !dbFile.exists() || dbFile.length() == 0L
   209→    val driver = JdbcSqliteDriver("jdbc:sqlite:${dbFile.absolutePath}")
   210→    try {
   211→        if (isNew) {
   212→            schema.create(driver)
   213→            driver.execute(null, "PRAGMA user_version = ${schema.version}", 0, null)
   214→        } else {
   215→            val currentVersion = driver.executeQuery(
   216→                identifier = null,
   217→                sql = "PRAGMA user_version",
   218→                parameters = 0,
   219→                mapper = { cursor ->
   220→                    app.cash.sqldelight.db.QueryResult.Value(
   221→                        if (cursor.next().value) cursor.getLong(0)?.toInt() ?: 0 else 0,
   222→                    )
   223→                },
   224→                binders = null,
   225→            ).value
   226→            if (currentVersion < schema.version) {
   227→                schema.migrate(driver, currentVersion.toLong(), schema.version)
   228→            }
   229→        }
   230→    } catch (e: Exception) {
   231→        // Corrupted DB: delete and recreate from scratch
   232→        System.err.println("Database error, recreating: ${e.message}")
   233→        driver.close()
   234→        dbFile.delete()
   235→        File(dbFile.path + "-shm").delete()
   236→        File(dbFile.path + "-wal").delete()
   237→        return createDriver(dbFile)
   238→    }
   239→    return driver
   240→}
   241→
   242→private fun initDatabase(dbFile: File): DatabaseHandler {
   243→    val driver = createDriver(dbFile)
