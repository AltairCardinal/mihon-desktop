import eu.kanade.tachiyomi.source.preference.JvmPreferenceItem

/**
 * Desktop implementation of PreferenceScreen.
 *
 * Acts as a descriptor collector: extensions call [addPreference] to register
 * their settings, and the desktop UI renders them via Compose components backed
 * by [tachiyomi.core.common.preference.DesktopPreferenceStore].
 *
 * The [context] property is null on desktop — extensions must not invoke
 * Android-specific APIs that require a Context.
 */
actual class PreferenceScreen {

    private val _preferences = mutableListOf<JvmPreferenceItem>()

    /** The list of preference descriptors registered by the source. */
    val preferences: List<JvmPreferenceItem> get() = _preferences.toList()

    /**
     * Always null on desktop. Provided so that extension code that reads
     * `screen.context` compiles without changes, though it must not be used.
     */
    val context: Any? = null

    fun addPreference(preference: JvmPreferenceItem) {
        _preferences.add(preference)
    }
}

