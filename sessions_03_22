    27→    /**
    28→     * Returns installed extensions grouped by JAR file.
    29→     * Each entry represents one JAR that may expose multiple sources.
    30→     */
    31→    fun getInstalledExtensions(): List<InstalledExtension> =
    32→        loadedExtensions
    33→            .groupBy { it.jarFile }
    34→            .map { (jarFile, exts) ->
