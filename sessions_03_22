    11→class CreateExtensionRepo(
    12→    private val repository: ExtensionRepoRepository,
    13→    private val service: ExtensionRepoService,
    14→) {
    15→    private val repoRegex = """^https://.*/index\.min\.json$""".toRegex()
    16→
    17→    suspend fun await(indexUrl: String): Result {
    18→        val formattedIndexUrl = indexUrl.toHttpUrlOrNull()
    19→            ?.toString()
    20→            ?.takeIf { it.matches(repoRegex) }
    21→            ?: return Result.InvalidUrl
    22→
    23→        val baseUrl = formattedIndexUrl.removeSuffix("/index.min.json")
    24→        return service.fetchRepoDetails(baseUrl)?.let { insert(it) } ?: Result.InvalidUrl
    25→    }
    26→
    27→    private suspend fun insert(repo: ExtensionRepo): Result {
    28→        return try {
    29→            repository.insertRepo(
    30→                repo.baseUrl,
    31→                repo.name,
    32→                repo.shortName,
    33→                repo.website,
    34→                repo.signingKeyFingerprint,
    35→            )
    36→            Result.Success
    37→        } catch (e: SaveExtensionRepoException) {
    38→            logcat(LogPriority.WARN, e) { "SQL Conflict attempting to add new repository ${repo.baseUrl}" }
    39→            return handleInsertionError(repo)
    40→        }
    41→    }
    42→
    43→    /**
    44→     * Error Handler for insert when there are trying to create new repositories
    45→     *
    46→     * SaveExtensionRepoException doesn't provide constraint info in exceptions.
    47→     * First check if the conflict was on primary key. if so return RepoAlreadyExists
    48→     * Then check if the conflict was on fingerprint. if so Return DuplicateFingerprint
    49→     * If neither are found, there was some other Error, and return Result.Error
    50→     *
    51→     * @param repo Extension Repo holder for passing to DB/Error Dialog
    52→     */
    53→    private suspend fun handleInsertionError(repo: ExtensionRepo): Result {
    54→        val repoExists = repository.getRepo(repo.baseUrl)
    55→        if (repoExists != null) {
    56→            return Result.RepoAlreadyExists
    57→        }
    58→        val matchingFingerprintRepo = repository.getRepoBySigningKeyFingerprint(repo.signingKeyFingerprint)
    59→        if (matchingFingerprintRepo != null) {
    60→            return Result.DuplicateFingerprint(matchingFingerprintRepo, repo)
    61→        }
    62→        return Result.Error
    63→    }
